+import { describe, expect, it } from "vitest";
+import { exactPlanPrompt, manualAiPrompt, photoRenderProvenanceSchema } from "./designPhotoRenders";
+
+function specification(overrides: Record<string, unknown> = {}) {
+  return {
+    perimeterCabinets: { name: null, color: null, doorStyle: null, productId: null, materialImageUrl: null },
+    islandCabinets: null,
+    perimeterCountertop: null,
+    islandCountertop: null,
+    hardware: null,
+    appliances: [],
+    glassStackers: [],
+    ...overrides,
+  };
+}
+
+const backWall = { x: 0, y: 1 };
+const cameraInFront = { x: 0, y: -1 };
+
+describe("Gemini exact-plan prompt: appliance orientation", () => {
+  it("states each appliance's wall and facing direction from the layout", () => {
+    const prompt = exactPlanPrompt("Kitchen", specification({
+      applianceFacing: [
+        { kind: "range", label: "Black Gas Range", wall: "the back wall", front: backWall, inward: backWall, cameraForward: cameraInFront },
+        { kind: "hood", label: "Glass Stainless Range Hood", wall: "the back wall", front: backWall, inward: backWall, cameraForward: cameraInFront, above: "Black Gas Range" },
+        { kind: "dishwasher", label: "Dishwasher", wall: "the left wall", front: { x: 1, y: 0 }, inward: { x: 1, y: 0 }, cameraForward: cameraInFront },
+      ],
+    }));
+    expect(prompt).toContain("The Black Gas Range sits in the base run against the back wall");
+    expect(prompt).toContain("its oven door and front controls facing out into the room and toward the camera");
+    expect(prompt).toContain("is mounted on the back wall directly above the Black Gas Range");
+    expect(prompt).toContain("The Dishwasher sits in the base run against the left wall");
+  });
+
+  it("locks the whole layout, appliance positions and orientation before any appliance sentence", () => {
+    const prompt = exactPlanPrompt("Kitchen", specification({
+      applianceFacing: [{ kind: "range", label: "Range", wall: "the back wall", front: backWall, inward: backWall, cameraForward: cameraInFront }],
+    }));
+    expect(prompt).toContain("reference image 1 IS the layout to preserve");
+    expect(prompt).toContain("Do not rotate, turn, flip, mirror, slide, swap, re-orient, or rearrange any appliance or cabinet");
+    expect(prompt).toContain("Never turn an appliance sideways down a cabinet run");
+    expect(prompt.indexOf("ORIENTATION LOCK")).toBeLessThan(prompt.indexOf("The Range sits"));
+  });
+
+  it("leaves the prompt unchanged when the request carries no appliance facing", () => {
+    const withFacing = exactPlanPrompt("Kitchen", specification());
+    expect(exactPlanPrompt("Kitchen")).toBe(exactPlanPrompt("Kitchen"));
+    expect(withFacing).not.toContain("ORIENTATION LOCK");
+  });
+
+  it("accepts the facing block through the provenance schema and drops a malformed one", () => {
+    const base = {
+      contractVersion: "exact-plan-v1", designId: 0, designRevision: null,
+      planFingerprint: "a".repeat(64), geometryLock: "locked-current-designer-plan-geometry",
+      camera: { position: [1, 2, 3], target: [0, 0, 0], zoom: 1 },
+      materials: ["cabinet", "countertop", "flooring", "backsplash", "faucet", "sink"].map(role => ({ role, productId: null, name: null, materialImageUrl: null })),
+      materialManifest: [{
+        id: "surface:countertop", role: "countertop", label: "Selected countertop", itemIds: ["surface:countertop"],
+        referenceUrl: "https://www.cabinetdealz.com/manus-storage/selected.jpg", provenance: "Selected product reference",
+      }],
+      missingMaterialInputs: [], sourceImageHash: "b".repeat(64),
+      generationMethod: "manual-final-review-gemini-nano-banana-v1",
+      renderSpecification: specification({
+        applianceFacing: [{ kind: "sink", label: "Farmhouse Sink", wall: "the back wall", front: backWall }],
+      }),
+    };
+    expect(photoRenderProvenanceSchema.safeParse(base).success).toBe(true);
+    expect(photoRenderProvenanceSchema.safeParse({
+      ...base,
+      renderSpecification: specification({ applianceFacing: [{ kind: "toaster", label: "x", wall: "the back wall", front: backWall }] }),
+    }).success).toBe(false);
+  });
+});
+
+describe("manual review handoff prompt: appliance orientation", () => {
+  it("carries the same layout lock for a manually reviewed render", async () => {
+    const prompt = manualAiPrompt({
+      contractVersion: "exact-plan-v1", designId: 1, designRevision: null,
+      planFingerprint: "a".repeat(64), geometryLock: "locked-current-designer-plan-geometry",
+      camera: { position: [1, 2, 3], target: [0, 0, 0], zoom: 1 },
+      materials: ["cabinet", "countertop", "flooring", "backsplash", "faucet", "sink"].map(role => ({ role, productId: null, name: null, materialImageUrl: null })),
+      materialManifest: [], missingMaterialInputs: [], sourceImageHash: "b".repeat(64),
+      generationMethod: "manual-final-review-image-service",
+      renderSpecification: specification({
+        applianceFacing: [{ kind: "range", label: "Range", wall: "the back wall", front: backWall, inward: backWall, cameraForward: cameraInFront }],
+      }),
+    } as never, []);
+    expect(prompt).toContain("ORIENTATION LOCK");
+    expect(prompt).toContain("The Range sits in the base run against the back wall");
+  });
+});
