+/**
+ * PRIORITY: write the accepted run onto its door style.
+ *
+ * An approved render becomes the kitchen's color. `renderHex` and
+ * `approvedReferenceImageUrl` are what the Designer reads, so accepting a run
+ * writes them in the same request. A revocation clears them, and a revert points
+ * them at the version it reverted to, or clears them when there is nothing left to
+ * point at — the style's own saved `color` then takes over.
+ *
+ * Only the columns this feature owns are touched. Prices, catalog flags, and the
+ * sample photos are never written here.
+ */
+async function syncAcceptedAppearanceToStyle(
+  db: Database,
+  styleId: number,
+  accepted: typeof doorRenderingVersions.$inferSelect | null,
+): Promise<void> {
+  try {
+    await ensureDoorRenderingApprovalColumns(db);
+    const approvedImage = accepted
+      ? (accepted.approvedDoorImageUrl ?? accepted.renderImageUrl ?? null)
+      : null;
+    await db.update(doorStyles)
+      .set(accepted
+        ? {
+          renderHex: accepted.renderHex ?? null,
+          approvedReferenceImageUrl: approvedImage,
+          approvedVersionId: accepted.id,
+          approvedAt: new Date(),
+        }
+        : { approvedReferenceImageUrl: null, approvedVersionId: null, approvedAt: null })
+      .where(eq(doorStyles.id, styleId));
+  } catch (error) {
+    // A style that cannot be written must never fail the approval itself; the
+    // version row and the event are already stored. The operator sees a log line.
+    console.error("[door-rendering-audit] accepted appearance writeback failed:", databaseErrorDetail(error));
+  }
+}
