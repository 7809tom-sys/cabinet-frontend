From 176b531e69ffda75c8c1a22661cc7a78bc25739c Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 6 Nov 2026 02:01:36 +0000
Subject: [PATCH] Prefer Authorization: Bearer over the test-account header.

Read the real Supabase session before the optional x-cd-test-account header, so a
tab's own bearer token always decides who the request is. The frontend now keeps
one session per browser tab, which makes a stale test-account header in a signed-in
tab reachable without any shared storage. Adds server/_core/sdk.bearerFirst.test.ts,
which fails on the old ordering.
---
 server/_core/sdk.bearerFirst.test.ts | 168 +++++++++++++++++++++++++++
 server/_core/sdk.ts                  |  10 +-
 2 files changed, 175 insertions(+), 3 deletions(-)
 create mode 100644 server/_core/sdk.bearerFirst.test.ts

diff --git a/server/_core/sdk.bearerFirst.test.ts b/server/_core/sdk.bearerFirst.test.ts
new file mode 100644
index 00000000..b81c009a
--- /dev/null
+++ b/server/_core/sdk.bearerFirst.test.ts
@@ -0,0 +1,168 @@
+import { exportJWK, generateKeyPair, SignJWT, type JWK } from "jose";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { signTestAccountToken } from "../lib/testAccounts";
+
+/**
+ * A bearer session must beat a test-account header.
+ *
+ * The frontend now keeps one Supabase session per browser tab, so two tabs can
+ * be signed in as two different people at the same time. `x-cd-test-account`
+ * lives in `sessionStorage` too, and `authenticateRequest` checked it *first*:
+ * a tab whose sessionStorage still held a test-account token answered every
+ * request as that test account, even when the tab carried a real
+ * `Authorization: Bearer` session. That is the same class of bug as one tab
+ * leaking its identity into another, so the real session now wins.
+ */
+
+const SUPABASE_URL = "https://project.supabase.co";
+const TEST_SECRET = "test-account-signing-secret";
+const ADMIN_DB_USER = { id: 7809, openId: "supabase-admin", email: "admin@cabinetdealz.test", role: "admin" };
+const TEST_DB_USER = { id: 42, openId: "test-account-customer", email: "customer@cabinetdealz.test", role: "user" };
+
+const envSnapshot = {
+  SUPABASE_URL: process.env.SUPABASE_URL,
+  VITE_SUPABASE_URL: process.env.VITE_SUPABASE_URL,
+  SUPABASE_JWT_SECRET: process.env.SUPABASE_JWT_SECRET,
+  ENABLE_TEST_ACCOUNTS: process.env.ENABLE_TEST_ACCOUNTS,
+  JWT_SECRET: process.env.JWT_SECRET,
+};
+
+function setEnv(name: keyof typeof envSnapshot, value: string | undefined) {
+  if (value === undefined) delete process.env[name];
+  else process.env[name] = value;
+}
+
+const dbMocks = vi.hoisted(() => ({
+  getUserByAuthId: vi.fn(),
+  getUserByEmailLower: vi.fn(),
+  createSupabaseUser: vi.fn(),
+  linkUserAuthId: vi.fn(),
+  promoteOwnerAdmin: vi.fn(),
+  synchronizeApprovedVendorLogin: vi.fn(),
+  getDb: vi.fn(),
+}));
+
+vi.mock("../db", () => ({
+  getDb: dbMocks.getDb,
+  getUserByAuthId: dbMocks.getUserByAuthId,
+  getUserByEmailLower: dbMocks.getUserByEmailLower,
+  linkUserAuthId: dbMocks.linkUserAuthId,
+  promoteOwnerAdmin: dbMocks.promoteOwnerAdmin,
+  synchronizeApprovedVendorLogin: dbMocks.synchronizeApprovedVendorLogin,
+}));
+
+beforeEach(() => {
+  vi.resetModules();
+  vi.stubGlobal("fetch", vi.fn(async () => new Response("{}", { status: 200 })));
+});
+
+afterEach(() => {
+  for (const [name, value] of Object.entries(envSnapshot)) {
+    setEnv(name as keyof typeof envSnapshot, value);
+  }
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+  vi.resetModules();
+});
+
+async function loadSdk() {
+  const { sdk } = await import("./sdk");
+  return sdk;
+}
+
+function stubJwks(jwk: JWK) {
+  const expected = `${SUPABASE_URL}/auth/v1/.well-known/jwks.json`;
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async (input: RequestInfo | URL) => {
+      const href = typeof input === "string" ? input : input instanceof URL ? input.href : input.url;
+      if (href !== expected) return new Response("not found", { status: 404 });
+      return new Response(JSON.stringify({ keys: [jwk] }), {
+        status: 200,
+        headers: { "content-type": "application/json" },
+      });
+    }),
+  );
+}
+
+async function supabaseAccessToken(email: string) {
+  const { publicKey, privateKey } = await generateKeyPair("ES256", { extractable: true });
+  const jwk = await exportJWK(publicKey);
+  jwk.alg = "ES256";
+  jwk.kid = "es256-test";
+  jwk.use = "sig";
+  stubJwks(jwk);
+
+  return new SignJWT({ email, app_metadata: { provider: "email" } })
+    .setProtectedHeader({ alg: "ES256", typ: "JWT", kid: "es256-test" })
+    .setSubject("supabase-admin")
+    .setIssuer(`${SUPABASE_URL}/auth/v1`)
+    .setAudience("authenticated")
+    .setIssuedAt()
+    .setExpirationTime("2h")
+    .sign(privateKey);
+}
+
+function enableTestAccounts() {
+  setEnv("SUPABASE_URL", SUPABASE_URL);
+  setEnv("VITE_SUPABASE_URL", undefined);
+  setEnv("SUPABASE_JWT_SECRET", undefined);
+  setEnv("ENABLE_TEST_ACCOUNTS", "true");
+  setEnv("JWT_SECRET", TEST_SECRET);
+}
+
+/** Only the test-account lookup can resolve a user here; bearer path fails. */
+function onlyTestAccountsResolvable() {
+  dbMocks.getUserByAuthId.mockResolvedValue(TEST_DB_USER);
+  dbMocks.getDb.mockResolvedValue({
+    select: () => ({ from: () => ({ where: () => ({ limit: async () => [TEST_DB_USER] }) }) }),
+  });
+}
+
+describe("authenticateRequest prefers the bearer session", () => {
+  it("resolves the bearer session, not the stale test-account header beside it", async () => {
+    enableTestAccounts();
+    onlyTestAccountsResolvable();
+    // The bearer token is real but the DB has no row for that auth user yet, so
+    // the bearer path throws. The bug was that this throw never happened: the
+    // test-account branch answered first and returned the test customer.
+    dbMocks.getUserByAuthId.mockResolvedValue(undefined);
+    dbMocks.getUserByEmailLower.mockResolvedValue(undefined);
+    dbMocks.createSupabaseUser.mockResolvedValue(undefined);
+
+    const accessToken = await supabaseAccessToken("admin@cabinetdealz.test");
+    const staleTestToken = await signTestAccountToken(TEST_DB_USER.id, TEST_SECRET);
+    const sdk = await loadSdk();
+
+    const request = {
+      headers: {
+        authorization: `Bearer ${accessToken}`,
+        "x-cd-test-account": staleTestToken,
+      },
+    } as never;
+
+    await expect(sdk.authenticateRequest(request)).rejects.toThrow();
+
+    // The test-account row was never used to answer the bearer request.
+    expect(dbMocks.getUserByAuthId).toHaveBeenCalled();
+  });
+
+  it("still accepts the test-account header when the tab has no bearer session", async () => {
+    enableTestAccounts();
+    onlyTestAccountsResolvable();
+    const testToken = await signTestAccountToken(TEST_DB_USER.id, TEST_SECRET);
+    const sdk = await loadSdk();
+
+    const request = { headers: { "x-cd-test-account": testToken } } as never;
+
+    await expect(sdk.authenticateRequest(request)).resolves.toMatchObject({ id: TEST_DB_USER.id });
+  });
+
+  it("rejects a request that carries neither a bearer token nor a test-account header", async () => {
+    enableTestAccounts();
+    onlyTestAccountsResolvable();
+    const sdk = await loadSdk();
+
+    await expect(sdk.authenticateRequest({ headers: {} } as never)).rejects.toThrow("Not signed in");
+  });
+});
diff --git a/server/_core/sdk.ts b/server/_core/sdk.ts
index dafc1466..5a044409 100644
--- a/server/_core/sdk.ts
+++ b/server/_core/sdk.ts
@@ -275,6 +275,13 @@ class SDKServer {
   }
 
   async authenticateRequest(req: Request): Promise<AuthenticatedUser> {
+    // A signed-in Supabase session always wins. Two browser tabs can now hold
+    // two different sessions (the frontend stores the session per tab), so a
+    // leftover test-account header in one tab must never speak for a request
+    // that carries a real `Authorization: Bearer` access token.
+    const bearerUser = await this.authenticateSupabaseBearer(req);
+    if (bearerUser) return bearerUser;
+
     if (testAccountsEnabled(process.env.ENABLE_TEST_ACCOUNTS) && ENV.cookieSecret) {
       const raw = req.headers[TEST_ACCOUNT_HEADER];
       const token = Array.isArray(raw) ? raw[0] : raw;
@@ -292,9 +299,6 @@ class SDKServer {
       }
     }
 
-    const bearerUser = await this.authenticateSupabaseBearer(req);
-    if (bearerUser) return bearerUser;
-
     throw ForbiddenError("Not signed in");
   }
 }
