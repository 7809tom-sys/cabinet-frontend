+import { describe, expect, it } from "vitest";
+import {
+  designStoreName,
+  existingDesignStoreId,
+  newDesignStoreDecision,
+  sameDesignStore,
+} from "./designStoreOwnership";
+
+const FIRST_CLASS = 44;
+const REAVES = 91;
+
+describe("a new design is filed under the person who saved it", () => {
+  it("files a platform admin's save on their own account, not the storefront URL they had open", () => {
+    expect(newDesignStoreDecision({
+      requestedAffiliateId: FIRST_CLASS,
+      viewerAffiliateId: null,
+      role: "admin",
+    })).toEqual({ affiliateId: null, reason: "account-scope" });
+  });
+
+  it("files platform staff work on their own account too", () => {
+    for (const role of ["designer", "sales_rep", "distributor"]) {
+      expect(newDesignStoreDecision({
+        requestedAffiliateId: FIRST_CLASS,
+        viewerAffiliateId: null,
+        role,
+      }).affiliateId).toBeNull();
+    }
+  });
+
+  it("keeps a store member's save in the store they belong to", () => {
+    expect(newDesignStoreDecision({
+      requestedAffiliateId: FIRST_CLASS,
+      viewerAffiliateId: FIRST_CLASS,
+      role: "designer",
+    })).toEqual({ affiliateId: FIRST_CLASS, reason: "store-member" });
+  });
+
+  it("keeps a storefront customer's save in that storefront's CRM", () => {
+    expect(newDesignStoreDecision({
+      requestedAffiliateId: FIRST_CLASS,
+      viewerAffiliateId: null,
+      role: "user",
+    })).toEqual({ affiliateId: FIRST_CLASS, reason: "storefront-customer" });
+  });
+
+  it("keeps a member of ANOTHER store out of a store they do not belong to", () => {
+    expect(newDesignStoreDecision({
+      requestedAffiliateId: FIRST_CLASS,
+      viewerAffiliateId: REAVES,
+      role: "designer",
+    }).affiliateId).toBeNull();
+  });
+
+  it("saves on the platform designer to the account scope", () => {
+    expect(newDesignStoreDecision({ requestedAffiliateId: null, viewerAffiliateId: null, role: "user" }))
+      .toEqual({ affiliateId: null, reason: "account-scope" });
+  });
+});
+
+describe("an existing design keeps the store it was saved on", () => {
+  it("takes the store from the stored row, never from the caller", () => {
+    expect(existingDesignStoreId({ affiliateId: FIRST_CLASS })).toBe(FIRST_CLASS);
+    expect(existingDesignStoreId({ affiliateId: null })).toBeNull();
+    expect(existingDesignStoreId(undefined)).toBeNull();
+  });
+
+  it("treats the house scope as its own store, not as a wildcard", () => {
+    expect(sameDesignStore(null, null)).toBe(true);
+    expect(sameDesignStore(FIRST_CLASS, FIRST_CLASS)).toBe(true);
+    expect(sameDesignStore(null, FIRST_CLASS)).toBe(false);
+    expect(sameDesignStore(FIRST_CLASS, REAVES)).toBe(false);
+  });
+
+  it("names the store for the UI, falling back to the person's own account", () => {
+    expect(designStoreName({ id: 44, slug: "firstclass", storeName: "First Class Flooring & Cabinet Design" }))
+      .toBe("First Class Flooring & Cabinet Design");
+    expect(designStoreName({ id: 91, slug: "reaves-way-cabinet-shop", storeName: "" }))
+      .toBe("reaves way cabinet shop");
+    expect(designStoreName(null)).toBe("CabinetDealz");
+  });
+});
diff --git a/server/lib/designStoreOwnership.ts b/server/lib/designStoreOwnership.ts
new file mode 100644
index 0000000..2a0119c
--- /dev/null
+++ b/server/lib/designStoreOwnership.ts
@@ -0,0 +1,90 @@
+/**
+ * Who owns a saved design, and which store it belongs to.
+ *
+ * Two different things were being conflated:
+ *
+ *  - OWNERSHIP: kitchen_designs.userId, the account that saved the plan.
+ *  - STORE: kitchen_designs.affiliateId, the storefront it came through.
+ *
+ * The store is an origin, not an owner. Because the write path took the store
+ * from the caller's `affiliateSlug` (which the browser derives from the URL),
+ * a design saved by a signed-in person while a storefront URL was open landed
+ * in that store: it appeared in that store's CRM, showed that store's brand,
+ * and was missing from the person's own "My Designs" list on every other
+ * device. Re-opening it from a link on another store then failed the scope
+ * check, so it looked "locked" to the store it was mis-filed under.
+ *
+ * The rules below are the server's authority for both, and the client mirrors
+ * them in `client/src/lib/designOwnerScope.ts`:
+ *
+ *  EXISTING design: its stored affiliateId decides the store for every read,
+ *  write, rename, delete and open. The request's address never re-labels it.
+ *
+ *  NEW design: a storefront CUSTOMER, and a member of the store they are on,
+ *  keep that store. Everyone else (platform admins and staff, and any signed-in
+ *  person browsing another store's catalog) gets their own account scope, so
+ *  the plan belongs to them on every device.
+ */
+
+const STAFF_ROLES = new Set(["admin", "designer", "sales_rep", "distributor"]);
+
+/** The store slug a design's own row resolves to, or null for the house scope. */
+export type DesignStoreRow = { id: number; slug: string; storeName: string };
+
+export type NewDesignStoreDecision = {
+  /** Store id to write, or null for the account's own (house) scope. */
+  affiliateId: number | null;
+  /** Why, in one sentence, for the server log and the API response. */
+  reason: "account-scope" | "storefront-customer" | "store-member" | "explicit-store";
+};
+
+/**
+ * The store a NEW design is written into.
+ *
+ * `requestedAffiliateId` is the storefront the request resolved to (from the
+ * host or the client slug the server already validated). `viewerAffiliateId`
+ * is the store the signed-in account belongs to, if any.
+ */
+export function newDesignStoreDecision(input: {
+  requestedAffiliateId: number | null;
+  viewerAffiliateId: number | null;
+  role: string | null | undefined;
+}): NewDesignStoreDecision {
+  const requested = input.requestedAffiliateId;
+  if (requested == null) return { affiliateId: null, reason: "account-scope" };
+
+  if (input.viewerAffiliateId != null && input.viewerAffiliateId === requested) {
+    return { affiliateId: requested, reason: "store-member" };
+  }
+
+  const role = (input.role ?? "").trim().toLowerCase();
+  if (STAFF_ROLES.has(role)) {
+    return { affiliateId: null, reason: "account-scope" };
+  }
+
+  return { affiliateId: requested, reason: "storefront-customer" };
+}
+
+/**
+ * The store an EXISTING design belongs to. Its stored row wins, so a design is
+ * never re-labelled by the address it is opened from.
+ */
+export function existingDesignStoreId(design: { affiliateId?: number | null } | null | undefined): number | null {
+  return design?.affiliateId ?? null;
+}
+
+/** True when two store ids name the same store, including the null house scope. */
+export function sameDesignStore(left: number | null, right: number | null): boolean {
+  return left === right;
+}
+
+/**
+ * Human label for a design's store. The house scope is the owner's own
+ * CabinetDealz account, not "unknown" and not a partner storefront's name.
+ */
+export function designStoreName(store: DesignStoreRow | null | undefined): string {
+  const name = (store?.storeName ?? "").trim();
+  if (name) return name;
+  const slug = (store?.slug ?? "").trim();
+  return slug ? slug.replace(/-/g, " ") : "CabinetDealz";
+}
