+/**
+ * Owner-reported: a signed-in person saved a NEW design ("Maple Life") and it
+ * never appeared on their own account, because `design.save` filed the row under
+ * whichever storefront URL was open. Re-opening one of their designs from a
+ * store link then 404'd, so the plan looked "locked" to that store.
+ *
+ * These checks pin WHERE that decision is made, so a later edit cannot quietly
+ * go back to taking the store from the request's `affiliateSlug`:
+ *
+ *   - a NEW save goes through `newDesignStoreDecision` (account scope for staff)
+ *   - an UPDATE, autosave, rename, and owner read go through the stored row's
+ *     own store (`existingDesignStoreId`), never the caller's scope
+ *   - `myDesigns` is owned by the account and is not narrowed to one storefront
+ */
+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+
+const source = readFileSync(new URL("./design.ts", import.meta.url), "utf8");
+
+function section(start: string, end: string): string {
+  const from = source.indexOf(start);
+  const to = source.indexOf(end, from + start.length);
+  expect(from, `${start} must exist`).toBeGreaterThan(-1);
+  expect(to, `${end} must follow ${start}`).toBeGreaterThan(from);
+  return source.slice(from, to);
+}
+
+const save = section("  save: protectedProcedure", "  autosave: protectedProcedure");
+const autosave = section("  autosave: protectedProcedure", "  rename: protectedProcedure");
+const rename = section("  rename: protectedProcedure", "  myDesigns: protectedProcedure");
+const myDesigns = section("  myDesigns: protectedProcedure", "  remove: protectedProcedure");
+const byId = section("  byId: protectedProcedure", "  createRemoteShareLink: protectedProcedure");
+const assistRead = byId.slice(byId.indexOf("if (input.assist)"), byId.indexOf("const affiliate: HostAffiliateRow | null"));
+const remove = section("  remove: protectedProcedure", "  byId: protectedProcedure");
+
+describe("a new design belongs to the account that saved it", () => {
+  it("decides the store from the person, not from the URL alone", () => {
+    expect(save).toContain("newDesignStoreDecision({");
+    expect(save).toContain("viewerAffiliateId");
+    expect(save).toContain("const affiliateId = existingDesign");
+  });
+
+  it("reports the scope it used so the Designer can confirm it", () => {
+    expect(save).toContain("storeReason: newDesignStore.reason");
+    expect(save).toContain('storeReason: "existing-design"');
+  });
+
+  it("still refuses to open a design belonging to another account", () => {
+    expect(save).toContain("if (existingDesign.userId !== userId)");
+  });
+});
+
+describe("an existing design keeps its own store", () => {
+  it("autosave reads the row's store before scoping the write", () => {
+    expect(autosave).toContain("existingDesignStoreId(existingRow)");
+    expect(autosave.indexOf("existingDesignStoreId(existingRow)"))
+      .toBeLessThan(autosave.indexOf("designAffiliateScopeCondition(affiliateId)"));
+  });
+
+  it("rename finds the design by owner, not by the address it came from", () => {
+    expect(rename).toContain("existingDesignStoreId(rows[0])");
+    expect(rename).not.toContain("await resolveAffiliateDesignOwner(db, input.affiliateSlug);\n      const affiliateId = affiliate?.id ?? null;");
+  });
+
+  it("delete resolves the design's own store before it scopes the delete", () => {
+    expect(remove).toContain("existingDesignStoreId(owned)");
+    expect(remove.indexOf("existingDesignStoreId(owned)"))
+      .toBeLessThan(remove.indexOf("designAffiliateScopeCondition(affiliateId)"));
+  });
+
+  it("the owner's assisted read is answered before the host is checked", () => {
+    expect(assistRead).toContain("if (design.userId === ctx.user.id) return design;");
+    expect(assistRead.indexOf("if (design.userId === ctx.user.id) return design;"))
+      .toBeLessThan(assistRead.indexOf("if (hostScope.pinned"));
+  });
+
+  it("an owner's read is not filtered by the address", () => {
+    expect(byId).toContain("eq(kitchenDesigns.userId, ctx.user.id),");
+    expect(byId).toContain("requireAffiliateDesignerAccess(db, ctx, existingDesignStoreId(owned[0]))");
+    expect(byId).not.toContain("designAffiliateScopeCondition(affiliate?.id ?? null),");
+  });
+});
+
+describe("My Designs is the account's list, not one storefront's", () => {
+  it("lists every design the account owns", () => {
+    expect(myDesigns).toContain("where(eq(kitchenDesigns.userId, ctx.user.id))");
+    expect(myDesigns).not.toContain("affiliate ? eq(kitchenDesigns.affiliateId, affiliate.id)");
+  });
+
+  it("carries the owning store with each design so links open it there", () => {
+    expect(myDesigns).toContain("storeSlug: affiliates.slug");
+    expect(myDesigns).toContain("affiliateSlug: row.storeSlug ?? null");
+  });
+});
