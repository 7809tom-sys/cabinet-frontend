+/**
+ * Designer helper queue — server side.
+ *
+ * The rules (queue order, who is notified, the email text, the plain sentences)
+ * live in `shared/designerHelperQueue.ts` and are imported here unchanged, so
+ * the app and the backend can never disagree about them.
+ *
+ * What this file owns:
+ *   - the queue: the Helper sign row per designer, ordered by signedOnAt;
+ *   - the request: created when a customer presses Share / Get a designer helper;
+ *   - the notify fan-out: in-app for every signed-on designer, email to each of
+ *     their addresses on file when the server mailer is configured;
+ *   - accept / join / close, each recording the real user id, name, and time.
+ *
+ * The designer's email is read from `users.email` on every send. It is never
+ * copied onto a queue row, so a queue entry always carries the address on file
+ * rather than a stale copy, and a missing address is reported instead of guessed.
+ *
+ * The customer's shared link is the Designer's existing signed remote-share
+ * token, not a new one, so the link the helper opens behaves exactly like the
+ * one the Designer's own Share action produces.
+ */
+import { and, desc, eq, inArray, or, sql, type SQL } from "drizzle-orm";
+import { designerHelperEvents, designerHelperQueue, designerHelperRequests, kitchenDesigns, users } from "../../drizzle/schema";
+import { getDb } from "../db";
+import {
+  helperEmailTarget,
+  helperNotificationOrder,
+  helperQueuePosition,
+  helperRequestDesignPath,
+  helperRequestEmailBody,
+  helperRequestEmailSubject,
+  helperRequestNeedsHelper,
+  planHelperNotification,
+  type HelperNotifyPlan,
+  type HelperQueueEntry,
+  type HelperRequest,
+  type HelperRequestStatus,
+} from "../../shared/designerHelperQueue";
+
+export type Database = NonNullable<Awaited<ReturnType<typeof getDb>>>;
+
+/** Roles that can hold the Helper sign and be queued for a customer request. */
+const HELPER_ROLES = ["designer", "admin"] as const;
+
+export function canHoldHelperSign(role: string | null | undefined): boolean {
+  return (HELPER_ROLES as readonly string[]).includes(role ?? "");
+}
+
+function iso(value: unknown): string | null {
+  if (value == null) return null;
+  if (value instanceof Date) return Number.isNaN(value.getTime()) ? null : value.toISOString();
+  const parsed = new Date(String(value));
+  return Number.isNaN(parsed.getTime()) ? null : parsed.toISOString();
+}
+
+function text(value: unknown): string | null {
+  if (value == null) return null;
+  const trimmed = String(value).trim();
+  return trimmed ? trimmed : null;
+}
+
+function toRequest(row: Record<string, unknown>, affiliateSlug: string | null = null): HelperRequest {
+  return {
+    id: Number(row.id),
+    designId: row.designId == null ? null : Number(row.designId),
+    designName: text(row.designName),
+    customerUserId: row.customerUserId == null ? null : Number(row.customerUserId),
+    customerName: text(row.customerName),
+    customerEmail: text(row.customerEmail),
+    customerPhone: text(row.customerPhone),
+    helpNote: text(row.helpNote),
+    status: String(row.status ?? "open") as HelperRequestStatus,
+    shareToken: text(row.shareToken),
+    affiliateSlug,
+    requestedAt: iso(row.requestedAt) ?? new Date().toISOString(),
+    acceptedByUserId: row.acceptedByUserId == null ? null : Number(row.acceptedByUserId),
+    acceptedByName: text(row.acceptedByName),
+    acceptedAt: iso(row.acceptedAt),
+    joinedByUserId: row.joinedByUserId == null ? null : Number(row.joinedByUserId),
+    joinedByName: text(row.joinedByName),
+    joinedAt: iso(row.joinedAt),
+    closedAt: iso(row.closedAt),
+  };
+}
+
+/**
+ * The queue as the app shows it: every designer who can hold the sign, their
+ * Helper sign state, the address on their account, and how many requests they
+ * have accepted. Only signed-on designers are ordered by the shared rule; the
+ * rest follow in account order so the list is stable and complete.
+ */
+export async function loadHelperQueue(db: Database): Promise<HelperQueueEntry[]> {
+  const accounts = await db
+    .select({ id: users.id, name: users.name, email: users.email, role: users.role })
+    .from(users)
+    .where(inArray(users.role, [...HELPER_ROLES]));
+
+  const signs = await db.select().from(designerHelperQueue);
+  const signByUser = new Map(signs.map((row) => [Number(row.designerUserId), row]));
+
+  const entries: HelperQueueEntry[] = accounts.map((account) => {
+    const sign = signByUser.get(Number(account.id));
+    return {
+      designerUserId: Number(account.id),
+      designerName: text(account.name) ?? `Designer #${account.id}`,
+      email: helperEmailTarget(account.email),
+      available: Boolean(sign?.available),
+      signedOnAt: iso(sign?.signedOnAt),
+      acceptedCount: Number(sign?.acceptedCount ?? 0),
+    };
+  });
+
+  const signedOn = helperNotificationOrder(entries);
+  const signedOnIds = new Set(signedOn.map((entry) => entry.designerUserId));
+  return signedOn.concat(entries.filter((entry) => !signedOnIds.has(entry.designerUserId)));
+}
+
+export async function helperSignFor(db: Database, designerUserId: number) {
+  const [row] = await db
+    .select()
+    .from(designerHelperQueue)
+    .where(eq(designerHelperQueue.designerUserId, designerUserId))
+    .limit(1);
+  return row ?? null;
+}
+
+/** Turn the sign on (queues him, stamps signedOnAt) or off (no requests sent). */
+export async function setHelperSign(db: Database, designerUserId: number, available: boolean) {
+  const existing = await helperSignFor(db, designerUserId);
+  const now = new Date();
+  if (!existing) {
+    await db.insert(designerHelperQueue).values({
+      designerUserId,
+      available,
+      signedOnAt: available ? now : null,
+      acceptedCount: 0,
+    });
+  } else {
+    await db
+      .update(designerHelperQueue)
+      .set({
+        available,
+        // Re-signing on after a shift off restarts his wait in the queue. Staying
+        // on keeps the original time, so queue order does not reset on a refresh.
+        signedOnAt: available ? (existing.signedOnAt ?? now) : null,
+      })
+      .where(eq(designerHelperQueue.designerUserId, designerUserId));
+  }
+  return helperSignFor(db, designerUserId);
+}
+
+export async function logHelperEvent(
+  db: Database,
+  args: { requestId: number; action: string; actorUserId?: number | null; actorName?: string | null; detail?: string | null },
+): Promise<void> {
+  try {
+    await db.insert(designerHelperEvents).values({
+      requestId: args.requestId,
+      action: args.action,
+      actorUserId: args.actorUserId ?? null,
+      actorName: args.actorName ?? null,
+      detail: args.detail ? args.detail.slice(0, 512) : null,
+    });
+  } catch (error) {
+    // The trail must never block the request itself.
+    console.error("[designer-helper] could not write helper event", error);
+  }
+}
+
+export async function helperRequestById(db: Database, requestId: number): Promise<HelperRequest | null> {
+  const [row] = await db.select().from(designerHelperRequests).where(eq(designerHelperRequests.id, requestId)).limit(1);
+  return row ? toRequest(row as Record<string, unknown>) : null;
+}
+
+/**
+ * Create the help request for a saved design.
+ *
+ * The design is re-read here and ownership is checked against its stored owner,
+ * never against a slug the caller sent, so a request cannot name someone else's
+ * plan. The affiliate scope is taken from the design row for the same reason.
+ */
+export async function createHelperRequest(
+  db: Database,
+  args: {
+    designId: number;
+    callerUserId: number;
+    callerIsAdmin: boolean;
+    customerName: string | null;
+    customerEmail: string | null;
+    customerPhone: string | null;
+    helpNote: string | null;
+    makeShareToken: (payload: { designId: number; affiliateId: number | null }) => string;
+  },
+): Promise<HelperRequest> {
+  const [design] = await db
+    .select({ id: kitchenDesigns.id, name: kitchenDesigns.name, userId: kitchenDesigns.userId, affiliateId: kitchenDesigns.affiliateId })
+    .from(kitchenDesigns)
+    .where(eq(kitchenDesigns.id, args.designId))
+    .limit(1);
+  if (!design) throw new Error("That saved design no longer exists, so it cannot be shared.");
+  if (!args.callerIsAdmin && Number(design.userId) !== args.callerUserId) {
+    throw new Error("You can only ask for help with your own saved design.");
+  }
+
+  const affiliateId = design.affiliateId == null ? null : Number(design.affiliateId);
+  const result = await db.insert(designerHelperRequests).values({
+    designId: args.designId,
+    designName: text(design.name),
+    customerUserId: args.callerUserId,
+    customerName: args.customerName,
+    customerEmail: args.customerEmail,
+    customerPhone: args.customerPhone,
+    helpNote: args.helpNote,
+    status: "open",
+    shareToken: args.makeShareToken({ designId: args.designId, affiliateId }),
+    affiliateId,
+    requestedAt: new Date(),
+  });
+  const id = Number((result as unknown as [{ insertId: number }])[0].insertId);
+  const created = await helperRequestById(db, id);
+  if (!created) throw new Error("The help request could not be read back after it was saved.");
+  return created;
+}
+
+export type HelperMailer = {
+  /** True when Resend or SMTP is configured. Asked before any send attempt. */
+  configured: () => boolean;
+  send: (payload: { to: string; subject: string; text: string; replyTo?: string }) => Promise<{ success: boolean; error?: string }>;
+};
+
+/**
+ * Fan out one new request.
+ *
+ * In-app first, for every signed-on designer, whatever the mailer says. Email
+ * second, only to the addresses on file, and only when the mailer is configured.
+ * A designer with no address is recorded as such rather than skipped silently.
+ */
+export async function notifyHelperDesigners(
+  db: Database,
+  args: {
+    request: HelperRequest;
+    queue: readonly HelperQueueEntry[];
+    origin: string;
+    mailer: HelperMailer;
+  },
+): Promise<HelperNotifyPlan & { emailed: string[]; emailErrors: string[] }> {
+  const mailerConfigured = args.mailer.configured();
+  const plan = planHelperNotification(args.queue, { mailerConfigured });
+  const emailed: string[] = [];
+  const emailErrors: string[] = [];
+
+  await logHelperEvent(db, {
+    requestId: args.request.id,
+    action: "notified",
+    detail: plan.queued.length === 0
+      ? "No designer had the Helper sign on."
+      : `In-app notice queued for ${plan.queued.length} designer(s).`,
+  });
+
+  if (!mailerConfigured) {
+    await logHelperEvent(db, {
+      requestId: args.request.id,
+      action: "email_skipped",
+      detail: "The server mailer is not configured.",
+    });
+    return { ...plan, emailed, emailErrors };
+  }
+
+  for (const designerUserId of plan.queued) {
+    const entry = args.queue.find((row) => row.designerUserId === designerUserId);
+    if (!entry) continue;
+    const to = helperEmailTarget(entry.email);
+    if (!to) {
+      await logHelperEvent(db, {
+        requestId: args.request.id,
+        action: "email_skipped",
+        actorUserId: entry.designerUserId,
+        actorName: entry.designerName,
+        detail: "No email address on file for this designer.",
+      });
+      continue;
+    }
+    const path = helperRequestDesignPath({
+      designId: args.request.designId,
+      requestId: args.request.id,
+      affiliateSlug: args.request.affiliateSlug,
+    });
+    const result = await args.mailer.send({
+      to,
+      subject: helperRequestEmailSubject(args.request),
+      text: helperRequestEmailBody({
+        request: args.request,
+        helperName: entry.designerName,
+        designPath: `${args.origin.replace(/\/+$/, "")}${path}`,
+      }),
+      replyTo: args.request.customerEmail ?? undefined,
+    });
+    if (result.success) {
+      emailed.push(to);
+      await logHelperEvent(db, {
+        requestId: args.request.id,
+        action: "emailed",
+        actorUserId: entry.designerUserId,
+        actorName: entry.designerName,
+        detail: `Emailed ${to}.`,
+      });
+    } else {
+      emailErrors.push(result.error ?? "Email could not be sent.");
+      await logHelperEvent(db, {
+        requestId: args.request.id,
+        action: "email_skipped",
+        actorUserId: entry.designerUserId,
+        actorName: entry.designerName,
+        detail: result.error ?? "Email could not be sent.",
+      });
+    }
+  }
+
+  return { ...plan, emailed, emailErrors };
+}
+
+/** Open requests a signed-on designer should see, newest first. */
+export async function helperRequestsForDesigner(db: Database, designerUserId: number): Promise<HelperRequest[]> {
+  const sign = await helperSignFor(db, designerUserId);
+  if (!sign?.available) return [];
+  const rows = await db
+    .select()
+    .from(designerHelperRequests)
+    .where(eq(designerHelperRequests.status, "open"))
+    .orderBy(desc(designerHelperRequests.requestedAt))
+    .limit(25);
+  return rows.map((row) => toRequest(row as Record<string, unknown>));
+}
+
+/** Every live request, for the admin list and the admin pop-up. */
+export async function helperRequestsForAdmin(db: Database, limit = 50): Promise<HelperRequest[]> {
+  const live: SQL | undefined = or(
+    eq(designerHelperRequests.status, "open"),
+    eq(designerHelperRequests.status, "accepted"),
+  );
+  const rows = await db
+    .select()
+    .from(designerHelperRequests)
+    .where(live)
+    .orderBy(desc(designerHelperRequests.requestedAt))
+    .limit(limit);
+  return rows.map((row) => toRequest(row as Record<string, unknown>));
+}
+
+/**
+ * Accept a request. Only an open request can be taken, and the update is
+ * conditional on it still being open, so two designers cannot both record an
+ * acceptance for the same request.
+ */
+export async function acceptHelperRequest(
+  db: Database,
+  args: { requestId: number; userId: number; userName: string | null },
+): Promise<HelperRequest> {
+  const current = await helperRequestById(db, args.requestId);
+  if (!current) throw new Error("That designer helper request no longer exists.");
+  if (!helperRequestNeedsHelper(current)) {
+    throw new Error(
+      current.acceptedByName
+        ? `${current.acceptedByName} already accepted this request.`
+        : "This request is no longer waiting for a designer.",
+    );
+  }
+  const result = await db
+    .update(designerHelperRequests)
+    .set({
+      status: "accepted",
+      acceptedByUserId: args.userId,
+      acceptedByName: args.userName,
+      acceptedAt: new Date(),
+    })
+    .where(and(eq(designerHelperRequests.id, args.requestId), eq(designerHelperRequests.status, "open")));
+  const changed = Number((result as unknown as [{ affectedRows?: number }])[0]?.affectedRows ?? 0);
+  if (changed === 0) throw new Error("Another designer accepted this request a moment before you.");
+
+  await db
+    .update(designerHelperQueue)
+    .set({ acceptedCount: sql`${designerHelperQueue.acceptedCount} + 1` })
+    .where(eq(designerHelperQueue.designerUserId, args.userId));
+  await logHelperEvent(db, {
+    requestId: args.requestId,
+    action: "accepted",
+    actorUserId: args.userId,
+    actorName: args.userName,
+    detail: `${args.userName ?? "A designer"} accepted the request.`,
+  });
+  const updated = await helperRequestById(db, args.requestId);
+  if (!updated) throw new Error("The accepted request could not be read back.");
+  return updated;
+}
+
+/**
+ * Record that a staff member opened the customer's design to help.
+ *
+ * Joining also settles the request: an open one becomes joined and records who
+ * accepted it (the joiner), so no one else is offered work already in hand.
+ */
+export async function joinHelperRequest(
+  db: Database,
+  args: { requestId: number; userId: number; userName: string | null },
+): Promise<HelperRequest> {
+  const current = await helperRequestById(db, args.requestId);
+  if (!current) throw new Error("That designer helper request no longer exists.");
+  const now = new Date();
+  await db
+    .update(designerHelperRequests)
+    .set({
+      status: "joined",
+      joinedByUserId: args.userId,
+      joinedByName: args.userName,
+      joinedAt: now,
+      ...(current.acceptedByUserId == null
+        ? { acceptedByUserId: args.userId, acceptedByName: args.userName, acceptedAt: now }
+        : {}),
+    })
+    .where(eq(designerHelperRequests.id, args.requestId));
+  await logHelperEvent(db, {
+    requestId: args.requestId,
+    action: "joined",
+    actorUserId: args.userId,
+    actorName: args.userName,
+    detail: `${args.userName ?? "Staff"} joined the customer's design.`,
+  });
+  const updated = await helperRequestById(db, args.requestId);
+  if (!updated) throw new Error("The joined request could not be read back.");
+  return updated;
+}
+
+export async function closeHelperRequest(
+  db: Database,
+  args: { requestId: number; userId: number; userName: string | null },
+): Promise<HelperRequest> {
+  await db
+    .update(designerHelperRequests)
+    .set({ status: "closed", closedAt: new Date() })
+    .where(eq(designerHelperRequests.id, args.requestId));
+  await logHelperEvent(db, {
+    requestId: args.requestId,
+    action: "closed",
+    actorUserId: args.userId,
+    actorName: args.userName,
+    detail: "Request closed.",
+  });
+  const updated = await helperRequestById(db, args.requestId);
+  if (!updated) throw new Error("The closed request could not be read back.");
+  return updated;
+}
+
+/**
+ * Place in the queue for one designer, or null when his sign is off. Uses the
+ * shared ordering, so the number he sees is the number the fan-out uses.
+ */
+export async function helperQueuePlace(db: Database, designerUserId: number): Promise<number | null> {
+  const queue = await loadHelperQueue(db);
+  return helperQueuePosition(queue.filter((entry) => entry.available), designerUserId);
+}
