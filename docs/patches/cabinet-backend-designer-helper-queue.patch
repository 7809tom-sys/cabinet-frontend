diff --git a/server/routers/designShareToken.ts b/server/routers/designShareToken.ts
new file mode 100644
index 0000000..1793940
--- /dev/null
+++ b/server/routers/designShareToken.ts
@@ -0,0 +1,50 @@
+/**
+ * The Designer's signed remote-share token, lifted out of `server/routers/design.ts`
+ * so the helper queue can mint the same link without importing a router.
+ *
+ * The token format, secret, and verification are unchanged: the helper queue and
+ * the Designer's own Share action produce interchangeable links.
+ */
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { ENV } from "../_core/env";
+
+export type RemoteDesignSharePayload = {
+  designId: number;
+  affiliateId: number | null;
+  issuedAt: number;
+};
+
+export function remoteDesignShareSecret() {
+  return ENV.cookieSecret || "cabinet-dealz-remote-design-share-dev";
+}
+
+export function encodeRemoteDesignSharePayload(payload: RemoteDesignSharePayload) {
+  return Buffer.from(JSON.stringify(payload), "utf8").toString("base64url");
+}
+
+export function signRemoteDesignSharePayload(encodedPayload: string) {
+  return createHmac("sha256", remoteDesignShareSecret()).update(encodedPayload).digest("base64url");
+}
+
+export function createRemoteDesignShareToken(payload: RemoteDesignSharePayload) {
+  const encodedPayload = encodeRemoteDesignSharePayload(payload);
+  return `${encodedPayload}.${signRemoteDesignSharePayload(encodedPayload)}`;
+}
+
+export function verifyRemoteDesignShareToken(token: string): RemoteDesignSharePayload | null {
+  const [encodedPayload, signature, extra] = token.split(".");
+  if (!encodedPayload || !signature || extra) return null;
+  const expected = signRemoteDesignSharePayload(encodedPayload);
+  const expectedBuffer = Buffer.from(expected);
+  const signatureBuffer = Buffer.from(signature);
+  if (expectedBuffer.length !== signatureBuffer.length || !timingSafeEqual(expectedBuffer, signatureBuffer)) return null;
+  try {
+    const parsed = JSON.parse(Buffer.from(encodedPayload, "base64url").toString("utf8")) as Partial<RemoteDesignSharePayload>;
+    if (!Number.isInteger(parsed.designId) || parsed.designId! <= 0) return null;
+    if (parsed.affiliateId !== null && parsed.affiliateId !== undefined && (!Number.isInteger(parsed.affiliateId) || parsed.affiliateId <= 0)) return null;
+    if (!Number.isInteger(parsed.issuedAt) || parsed.issuedAt! <= 0) return null;
+    return { designId: parsed.designId!, affiliateId: parsed.affiliateId ?? null, issuedAt: parsed.issuedAt! };
+  } catch {
+    return null;
+  }
+}
diff --git a/server/routers/designerHelper.ts b/server/routers/designerHelper.ts
new file mode 100644
index 0000000..d920704
--- /dev/null
+++ b/server/routers/designerHelper.ts
@@ -0,0 +1,254 @@
+/**
+ * Designer helper queue — the tRPC boundary.
+ *
+ * Procedures:
+ *   mailerStatus   public      is the server mailer configured (plain yes/no)
+ *   mySign         protected   the caller's Helper sign, queue place, and queue
+ *   setSign        protected   Helper sign on/off; records signedOnAt
+ *   myNotices      protected   open requests sent to a signed-on designer
+ *   adminInbox     admin       live requests for the admin list and pop-up
+ *   request        protected   Share / Get a designer helper: share + create + notify
+ *   accept         protected   claim a request; records who accepted and when
+ *   join           protected   open the customer's design; records who joined and when
+ *   close          admin       settle a request
+ *
+ * Email goes out through the existing mailer in `server/email.ts` (Resend, then
+ * SMTP). It is asked first whether it is configured, so when it is unset the app
+ * says so plainly and the in-app notice still reaches every queued designer.
+ *
+ * The shared design link is the Designer's own signed remote-share token, made by
+ * the same `createRemoteDesignShareToken` the Designer's Share action uses, so a
+ * helper opens exactly what a customer's shared link opens.
+ */
+import { z } from "zod";
+import { TRPCError } from "@trpc/server";
+import { adminProcedure, protectedProcedure, publicProcedure, router } from "../_core/trpc";
+import { isEmailConfigured, sendEmail } from "../email";
+import { getDb } from "../db";
+import {
+  acceptHelperRequest,
+  canHoldHelperSign,
+  closeHelperRequest,
+  createHelperRequest,
+  helperRequestsForAdmin,
+  helperRequestsForDesigner,
+  helperSignFor,
+  joinHelperRequest,
+  loadHelperQueue,
+  logHelperEvent,
+  notifyHelperDesigners,
+  setHelperSign,
+  type Database,
+} from "../lib/designerHelper";
+import {
+  helperQueuePosition,
+  helperRequestDesignPath,
+  type HelperRequest,
+} from "../../shared/designerHelperQueue";
+import { createRemoteDesignShareToken } from "./designShareToken";
+
+/** Resend first, then SMTP — the two transports `sendEmail` already uses. */
+const mailer = {
+  configured: () => isEmailConfigured(),
+  send: (payload: { to: string; subject: string; text: string; replyTo?: string }) => sendEmail(payload),
+};
+
+async function requireDb(): Promise<Database> {
+  const db = await getDb();
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
+  return db;
+}
+
+/** The site the request came from, so the emailed link is absolute and correct. */
+function originFrom(headers: { origin?: string; referer?: string } | undefined): string {
+  const candidate = headers?.origin?.trim() || headers?.referer?.trim() || "";
+  if (!candidate) return "https://cabinetdealz.com";
+  try {
+    return new URL(candidate).origin;
+  } catch {
+    return "https://cabinetdealz.com";
+  }
+}
+
+type SignedInUser = { id: number; name?: string | null; email?: string | null; role?: string | null };
+
+/** A designer's Helper sign, his place in the queue, and the queue itself. */
+async function signState(db: Database, user: SignedInUser) {
+  const queue = await loadHelperQueue(db);
+  const sign = await helperSignFor(db, user.id);
+  const available = Boolean(sign?.available);
+  const signedOn = queue.filter((entry) => entry.available);
+  return {
+    available,
+    signedOnAt: sign?.signedOnAt ? new Date(sign.signedOnAt).toISOString() : null,
+    designerName: user.name ?? `Designer #${user.id}`,
+    email: user.email ?? null,
+    queuePosition: available ? helperQueuePosition(signedOn, user.id) : null,
+    queue,
+    queuedCount: signedOn.length,
+    acceptedCount: Number(sign?.acceptedCount ?? 0),
+  };
+}
+
+/** The app's notice row: the full request plus every link it can open. */
+function noticeFor(request: HelperRequest) {
+  return {
+    request,
+    designPath: helperRequestDesignPath({
+      designId: request.designId,
+      requestId: request.id,
+      affiliateSlug: request.affiliateSlug,
+    }),
+    joinPath: `/admin/helper-request/${request.id}`,
+    customerSharePath: request.shareToken ? `/design/session/${request.shareToken}` : null,
+  };
+}
+
+export const designerHelperRouter = router({
+  mailerStatus: publicProcedure.query(() => ({ mailerConfigured: mailer.configured() })),
+
+  mySign: protectedProcedure.query(async ({ ctx }) => {
+    const db = await requireDb();
+    return signState(db, ctx.user);
+  }),
+
+  setSign: protectedProcedure
+    .input(z.object({ available: z.boolean() }))
+    .mutation(async ({ ctx, input }) => {
+      if (!canHoldHelperSign(ctx.user.role)) {
+        throw new TRPCError({
+          code: "FORBIDDEN",
+          message: "The Helper sign is for designers. This account cannot join the helper queue.",
+        });
+      }
+      const db = await requireDb();
+      await setHelperSign(db, ctx.user.id, input.available);
+      return signState(db, ctx.user);
+    }),
+
+  myNotices: protectedProcedure.query(async ({ ctx }) => {
+    const db = await requireDb();
+    const requests = await helperRequestsForDesigner(db, ctx.user.id);
+    return requests.map(noticeFor);
+  }),
+
+  adminInbox: adminProcedure.query(async ({ ctx }) => {
+    const db = await requireDb();
+    const requests = await helperRequestsForAdmin(db);
+    return requests.map(noticeFor);
+  }),
+
+  /**
+   * Share the customer's design and ask for a helper.
+   *
+   * One call does the whole job the button promises: it shares the design (the
+   * read-only link is returned and kept on the request), creates the request,
+   * and notifies every signed-on designer in the app and — when the mailer is
+   * configured — by email to the address on their account.
+   */
+  request: protectedProcedure
+    .input(z.object({
+      designId: z.number().int().positive(),
+      helpNote: z.string().trim().max(1000).nullable().optional(),
+      customerName: z.string().trim().max(256).nullable().optional(),
+      customerEmail: z.string().trim().max(320).nullable().optional(),
+      customerPhone: z.string().trim().max(32).nullable().optional(),
+      affiliateSlug: z.string().trim().max(255).nullable().optional(),
+    }))
+    .mutation(async ({ ctx, input }) => {
+      const db = await requireDb();
+      const request = await createHelperRequest(db, {
+        designId: input.designId,
+        callerUserId: ctx.user.id,
+        callerIsAdmin: ctx.user.role === "admin",
+        customerName: input.customerName ?? ctx.user.name ?? null,
+        customerEmail: input.customerEmail ?? ctx.user.email ?? null,
+        customerPhone: input.customerPhone ?? null,
+        helpNote: input.helpNote ?? null,
+        makeShareToken: (payload) => createRemoteDesignShareToken({ ...payload, issuedAt: Date.now() }),
+      });
+
+      await logHelperEvent(db, {
+        requestId: request.id,
+        action: "shared",
+        actorUserId: ctx.user.id,
+        actorName: ctx.user.name ?? null,
+        detail: `Design #${input.designId} shared.`,
+      });
+
+      // Only designers with the sign on are queued, in the shared order.
+      const signedOn = (await loadHelperQueue(db)).filter((entry) => entry.available);
+      const plan = await notifyHelperDesigners(db, {
+        request,
+        queue: signedOn,
+        origin: originFrom(ctx.req.headers as { origin?: string; referer?: string }),
+        mailer,
+      });
+
+      return {
+        request,
+        sharePath: request.shareToken ? `/design/session/${request.shareToken}` : "",
+        designPath: helperRequestDesignPath({
+          designId: request.designId,
+          requestId: request.id,
+          affiliateSlug: request.affiliateSlug,
+        }),
+        mailerConfigured: mailer.configured(),
+        notification: { queued: plan.queued, emailTargets: plan.emailTargets, missingEmail: plan.missingEmail },
+        emailed: plan.emailed,
+        emailErrors: plan.emailErrors,
+      };
+    }),
+
+  accept: protectedProcedure
+    .input(z.object({ requestId: z.number().int().positive() }))
+    .mutation(async ({ ctx, input }) => {
+      const db = await requireDb();
+      const request = await acceptHelperRequest(db, {
+        requestId: input.requestId,
+        userId: ctx.user.id,
+        userName: ctx.user.name ?? null,
+      });
+      return {
+        request,
+        designPath: helperRequestDesignPath({
+          designId: request.designId,
+          requestId: request.id,
+          affiliateSlug: request.affiliateSlug,
+        }),
+      };
+    }),
+
+  join: protectedProcedure
+    .input(z.object({ requestId: z.number().int().positive() }))
+    .mutation(async ({ ctx, input }) => {
+      const db = await requireDb();
+      const request = await joinHelperRequest(db, {
+        requestId: input.requestId,
+        userId: ctx.user.id,
+        userName: ctx.user.name ?? null,
+      });
+      return {
+        requestId: request.id,
+        designId: request.designId,
+        designPath: helperRequestDesignPath({
+          designId: request.designId,
+          requestId: request.id,
+          affiliateSlug: request.affiliateSlug,
+        }),
+        joinedAt: request.joinedAt ?? new Date().toISOString(),
+        joinedByName: request.joinedByName ?? ctx.user.name ?? "Staff",
+      };
+    }),
+
+  close: adminProcedure
+    .input(z.object({ requestId: z.number().int().positive() }))
+    .mutation(async ({ ctx, input }) => {
+      const db = await requireDb();
+      return closeHelperRequest(db, {
+        requestId: input.requestId,
+        userId: ctx.user.id,
+        userName: ctx.user.name ?? null,
+      });
+    }),
+});
