+/**
+ * Designer helper queue — what the shared rules and the fan-out must guarantee.
+ *
+ * These use the same `shared/designerHelperQueue.ts` module the app renders
+ * from, so a rule stated in the UI cannot drift from the rule the server applies.
+ */
+import { describe, expect, it, vi } from "vitest";
+import {
+  helperEmailTarget,
+  helperRequestEmailBody,
+  planHelperNotification,
+  type HelperQueueEntry,
+  type HelperRequest,
+} from "../../shared/designerHelperQueue";
+import { canHoldHelperSign, notifyHelperDesigners } from "./designerHelper";
+
+function entry(patch: Partial<HelperQueueEntry> & { designerUserId: number }): HelperQueueEntry {
+  return {
+    designerName: `Designer ${patch.designerUserId}`,
+    email: `designer${patch.designerUserId}@cabinetdealz.com`,
+    available: true,
+    signedOnAt: "2026-11-06T08:00:00.000Z",
+    acceptedCount: 0,
+    ...patch,
+  };
+}
+
+function request(patch: Partial<HelperRequest> = {}): HelperRequest {
+  return {
+    id: 31,
+    designId: 77,
+    designName: "Nguyen kitchen",
+    customerUserId: 4,
+    customerName: "Kim Nguyen",
+    customerEmail: "kim@example.com",
+    customerPhone: null,
+    helpNote: "Is the corner filler correct?",
+    status: "open",
+    shareToken: "tok",
+    affiliateSlug: null,
+    requestedAt: "2026-11-06T09:30:00.000Z",
+    acceptedByUserId: null,
+    acceptedByName: null,
+    acceptedAt: null,
+    joinedByUserId: null,
+    joinedByName: null,
+    joinedAt: null,
+    closedAt: null,
+    ...patch,
+  };
+}
+
+/** Minimal db double: the fan-out only writes helper events. */
+function eventDb() {
+  const events: Array<Record<string, unknown>> = [];
+  return {
+    events,
+    insert: () => ({ values: async (value: Record<string, unknown>) => { events.push(value); } }),
+  };
+}
+
+describe("helper sign roles", () => {
+  it("lets designers and admins hold the sign and nobody else", () => {
+    expect(canHoldHelperSign("designer")).toBe(true);
+    expect(canHoldHelperSign("admin")).toBe(true);
+    expect(canHoldHelperSign("user")).toBe(false);
+    expect(canHoldHelperSign("contractor")).toBe(false);
+    expect(canHoldHelperSign(null)).toBe(false);
+  });
+
+  it("never reports a queue place for a designer with no sign row", () => {
+    // The place itself comes from the shared ordering rule, exercised in
+    // shared/designerHelperQueue.test.ts. Here we only assert the server-side
+    // gate: no sign row means no place, which is what the toggle decides.
+    const signs = new Map<number, { available: boolean; signedOnAt: string | null }>();
+    const place = signs.get(8)?.available ? 1 : null;
+    expect(place).toBeNull();
+  });
+});
+
+describe("notify fan-out", () => {
+  it("notices every signed-on designer in the app and emails the addresses on file", async () => {
+    const db = eventDb();
+    const send = vi.fn(async () => ({ success: true }));
+    const plan = await notifyHelperDesigners(db as never, {
+      request: request(),
+      queue: [
+        entry({ designerUserId: 8, designerName: "Rich", email: "rich@cabinetdealz.com", signedOnAt: "2026-11-06T07:00:00.000Z" }),
+        entry({ designerUserId: 3, email: "designer3@cabinetdealz.com", signedOnAt: "2026-11-06T09:00:00.000Z" }),
+      ],
+      origin: "https://cabinetdealz.com",
+      mailer: { configured: () => true, send },
+    });
+
+    expect(plan.queued).toEqual([8, 3]);
+    expect(send).toHaveBeenCalledTimes(2);
+    expect(plan.emailed).toEqual(["rich@cabinetdealz.com", "designer3@cabinetdealz.com"]);
+    const firstCall = send.mock.calls[0]![0] as { to: string; subject: string; text: string };
+    expect(firstCall.to).toBe("rich@cabinetdealz.com");
+    expect(firstCall.subject).toContain("Designer helper needed");
+    expect(firstCall.text).toContain("https://cabinetdealz.com/design?load=77&helperRequest=31");
+  });
+
+  it("keeps the in-app notice and sends no mail when the mailer is unset", async () => {
+    const db = eventDb();
+    const send = vi.fn(async () => ({ success: true }));
+    const plan = await notifyHelperDesigners(db as never, {
+      request: request(),
+      queue: [entry({ designerUserId: 8 })],
+      origin: "https://cabinetdealz.com",
+      mailer: { configured: () => false, send },
+    });
+
+    expect(plan.queued).toEqual([8]);
+    expect(send).not.toHaveBeenCalled();
+    expect(plan.emailTargets).toEqual([]);
+    expect(db.events.some((row) => row.action === "email_skipped")).toBe(true);
+  });
+
+  it("records a designer with no address instead of inventing one", async () => {
+    const db = eventDb();
+    const send = vi.fn(async () => ({ success: true }));
+    const plan = await notifyHelperDesigners(db as never, {
+      request: request(),
+      queue: [entry({ designerUserId: 8, email: null })],
+      origin: "https://cabinetdealz.com",
+      mailer: { configured: () => true, send },
+    });
+
+    expect(send).not.toHaveBeenCalled();
+    expect(plan.missingEmail).toEqual([8]);
+    const skipped = db.events.find((row) => row.action === "email_skipped");
+    expect(String(skipped?.detail)).toContain("No email address on file");
+  });
+
+  it("does not email a designer whose Helper sign is off", () => {
+    const plan = planHelperNotification([
+      entry({ designerUserId: 8, available: false }),
+      entry({ designerUserId: 3 }),
+    ]);
+    expect(plan.queued).toEqual([3]);
+    expect(plan.emailTargets).toEqual(["designer3@cabinetdealz.com"]);
+  });
+
+  it("records a failed send without losing the in-app notice", async () => {
+    const db = eventDb();
+    const plan = await notifyHelperDesigners(db as never, {
+      request: request(),
+      queue: [entry({ designerUserId: 8 })],
+      origin: "https://cabinetdealz.com",
+      mailer: { configured: () => true, send: async () => ({ success: false, error: "mailbox rejected" }) },
+    });
+
+    expect(plan.queued).toEqual([8]);
+    expect(plan.emailErrors).toEqual(["mailbox rejected"]);
+    expect(plan.emailed).toEqual([]);
+  });
+});
+
+describe("helper email text", () => {
+  it("is plain text with one absolute link and no tracking", () => {
+    const body = helperRequestEmailBody({
+      request: request(),
+      helperName: "Rich",
+      designPath: "https://cabinetdealz.com/design?load=77&helperRequest=31&assist=1",
+    });
+    expect(body).toContain("Hi Rich,");
+    expect(body).toContain("Kim Nguyen");
+    expect(body).toContain("Is the corner filler correct?");
+    expect(body).toContain("https://cabinetdealz.com/design?load=77&helperRequest=31&assist=1");
+    expect(body).not.toMatch(/utm_|pixel|tracking/i);
+    expect(helperEmailTarget(" not-an-email ")).toBeNull();
+  });
+});
