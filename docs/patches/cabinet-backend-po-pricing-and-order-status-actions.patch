+    const unit = moneyValue(line.distributorUnitCost) ?? moneyValue(line.unitCost) ?? moneyValue(line.myCost);
+    const extended = moneyValue(line.distributorLineCost) ?? moneyValue(line.lineCost);
+    if (unit != null || extended != null) byIndex.set(index, { unit, extended });
