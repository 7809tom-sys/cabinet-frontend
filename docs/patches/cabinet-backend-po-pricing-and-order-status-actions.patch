+/**
+ * Distributor cost per order line, keyed by line index.
+ *
+ * An order line persists the customer price only. The distributor cost is
+ * attached when a row is read through `enrichAdminOrderRows` — the admin order
+ * page's own path. Reusing it here is what makes a PO total match the admin page
+ * instead of quietly producing a $0 subtotal.
+ */
+async function adminLineCosts(
+  db: Database,
+  order: typeof orderRequests.$inferSelect,
+): Promise<Map<number, { unit: number | null; extended: number | null }>> {
+  const byIndex = new Map<number, { unit: number | null; extended: number | null }>();
+  const enriched = await guarded("read distributor cost for the PO", null as Array<Record<string, unknown>> | null, async () => {
+    const rows = await enrichAdminOrderRows(db, [order]) as Array<Record<string, unknown>>;
+    return rows.length ? rows : null;
+  });
+  if (!enriched) return byIndex;
+  const enrichedLines = (enriched[0]?.lineItems ?? []) as Array<Record<string, unknown>>;
+  enrichedLines.forEach((line, index) => {
+    const unit = moneyValue(line.distributorUnitCost) ?? moneyValue(line.unitCost) ?? moneyValue(line.myCost);
+    const extended = moneyValue(line.distributorLineCost) ?? moneyValue(line.lineCost);
+    if (unit != null || extended != null) byIndex.set(index, { unit, extended });
+  });
+  return byIndex;
+}
+
+function moneyValue(value: unknown): number | null {
+  if (value == null || value === "") return null;
+  const numeric = typeof value === "number" ? value : Number(String(value).replace(/[$,\s]/g, ""));
+  return Number.isFinite(numeric) ? Math.round(numeric * 100) / 100 : null;
+}
