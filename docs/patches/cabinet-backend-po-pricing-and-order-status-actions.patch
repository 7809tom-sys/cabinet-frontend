@@ -0,0 +1,87 @@
+import { describe, expect, it } from "vitest";
+import { composeDistributorOrderEmail, type DistributorEmailLine } from "./distributorOrderEmail";
+
+/**
+ * CD-20261022-OLOUT is the order that exposed the missing-price bug: the emailed
+ * PO and its CSV carried no line price at all, so only shipping and tax showed
+ * and the "total" was $71.40.
+ *
+ * Tom confirmed the order's real numbers:
+ *   1 x CS-DB18  18" 3 Drawer Base Cabinet, Carmel Shaker
+ *   distributor cost $284.39   (customer price $449.34 — never shown to a distributor)
+ *   shipping $47.00   tax $24.40   → PO total $355.79
+ */
+const LINES: DistributorEmailLine[] = [{
+  sku: "CS-DB18",
+  description: '18" 3 Drawer Base Cabinet',
+  doorStyle: "Carmel Shaker",
+  qty: 1,
+  unitPrice: 284.39,
+  linePrice: 284.39,
+  customerUnitPrice: 449.34,
+  customerLinePrice: 449.34,
+}];
+
+function po(overrides: Partial<Parameters<typeof composeDistributorOrderEmail>[0]> = {}) {
+  return composeDistributorOrderEmail({
+    orderNumber: "CD-20261022-OLOUT",
+    orderDate: "2026-10-22",
+    customerName: "Tom Reaves",
+    shipTo: ["123 Oak Street", "Austin, TX 78701"],
+    distributorName: "Faircrest",
+    lines: LINES,
+    poNumber: null,
+    notes: null,
+    shipping: 47,
+    tax: 24.4,
+    ...overrides,
+  });
+}
+
+describe("distributor PO with prices", () => {
+  it("prints the unit price, line total, subtotal, shipping, tax and the corrected total", () => {
+    const { text, document } = po();
+    expect(document.lines[0]).toMatchObject({ sku: "CS-DB18", unitPriceCents: 28439, lineTotalCents: 28439 });
+    expect(text).toContain("Unit $284.39 × 1 = Line total $284.39");
+    expect(text).toContain("Subtotal: $284.39");
+    expect(text).toContain("Shipping: $47.00");
+    expect(text).toContain("Sales tax: $24.40");
+    expect(text).toContain("Total: $355.79");
+  });
+
+  it("never shows the customer price on a distributor PO", () => {
+    const { text } = po();
+    expect(text).not.toContain("449.34");
+    expect(text).toContain("Prices shown are Cabinet Dealz distributor cost.");
+  });
+
+  it("does not repeat the old shipping-plus-tax total", () => {
+    const { text } = po();
+    expect(text).not.toContain("$71.40");
+  });
+
+  it("keeps the order header and ship-to the distributor needs", () => {
+    const { subject, text } = po({ poNumber: "PO-55" });
+    expect(subject).toBe("Purchase Order CD-20261022-OLOUT — Cabinet Dealz");
+    expect(text).toContain("PO number: PO-55");
+    expect(text).toContain("123 Oak Street");
+    expect(text).toContain("Cabinet Dealz");
+  });
+
+  it("states the subtotal is short when a line has no price", () => {
+    const { text, document } = po({
+      lines: [{ sku: "CS-DB18", description: '18" 3 Drawer Base Cabinet', doorStyle: "Carmel Shaker", qty: 1 }],
+    });
+    expect(document.completePricing).toBe(false);
+    expect(text).toContain("Unit no price × 1 = Line total no price");
+    expect(text).toContain("WARNING: 1 line has no price");
+  });
+
+  it("falls back to the customer price only when no cost was supplied, and says so", () => {
+    const { text, document } = po({
+      lines: [{ sku: "CS-DB18", description: "Base", doorStyle: "Carmel Shaker", qty: 1, customerUnitPrice: 449.34 }],
+    });
+    expect(document.basis).toBe("customer_price");
+    expect(text).toContain("customer price (no distributor cost is stored on this order)");
+  });
+});
