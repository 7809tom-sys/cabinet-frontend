--- /dev/null
+++ b/server/lib/orderSchemaGuard.ts
@@ -0,0 +1,11 @@
+export function schemaErrorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+export function isMissingSchemaError(error: unknown): boolean {
+  return /unknown column|ER_BAD_FIELD_ERROR|ER_NO_SUCH_TABLE|doesn't exist|does not exist|no such table|no such column/i.test(schemaErrorMessage(error));
+}
+
+export function isEnumValueError(error: unknown): boolean {
+  return /data truncated|incorrect .*value|invalid .*enum|enum/i.test(schemaErrorMessage(error));
+}
