+      { action: "signed", at: order.orderSignedAt, actor: (order.orderSignedBy as string | null) ?? null, detail: (order.signerName as string | null) ?? null },
+      { action: "receipt_sent", at: order.receiptSentAt ?? order.receiptEmailedAt, actor: "system", detail: null },
+    ];
+
+    for (const step of steps) {
+      const at = step.at == null ? null : new Date(String(step.at));
+      if (!at || Number.isNaN(at.getTime())) continue;
+      await db.execute(sql`
+        INSERT INTO order_events (orderRequestId, action, actorName, detail, createdAt)
+        VALUES (${orderId}, ${step.action}, ${step.actor}, ${step.detail}, ${at.toISOString()})
+      `);
+      inserted += 1;
+    }
+  } catch (error) {
+    if (isMissingSchemaError(error)) return inserted;
+    console.error(`[OrderActivity] Could not backfill order ${orderId}: ${schemaErrorMessage(error)}`);
+  }
+  return inserted;
+}
