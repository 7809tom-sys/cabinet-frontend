new file mode 100644
index 0000000..f937422
--- /dev/null
+++ b/shared/poSku.ts
@@ -0,0 +1,55 @@
+/**
+ * The PO SKU we send a distributor, e.g. "usd-sw-3db18".
+ *
+ * The SKU is built from three parts: the distributor's code, the door style's
+ * code, and the distributor's own item code. For most distributors those are
+ * three distinct tokens. Some distributors reuse a code across the parts — the
+ * Clark and Son ("CS") line is both the distributor code and the style code, and
+ * its item codes already start with "CS-" (CS-DB18). Concatenating blindly gave
+ * "cs-cs-cs-db18" on the admin order page: the same token three times.
+ *
+ * The rule is deliberately conservative: keep each part's tokens in order and
+ * drop a token that has already appeared. Nothing is invented and no part is
+ * reordered, so a normal distributor is byte-for-byte unchanged.
+ */
+
+/** Split a SKU part into non-empty tokens, tolerating "cs-db18" and "CS DB18". */
+function tokens(value: string | null | undefined): string[] {
+  return String(value ?? "")
+    .trim()
+    .split(/[-\s_]+/)
+    .map((token) => token.trim())
+    .filter(Boolean);
+}
+
+/**
+ * Build the PO SKU, collapsing repeated tokens.
+ *
+ *   buildPoSku("USD", "SW", "3DB18")    → "usd-sw-3db18"
+ *   buildPoSku("CS",  "CS", "CS-DB18")  → "cs-db18"
+ *   buildPoSku("CS",  "WS", "DB18")     → "cs-ws-db18"
+ */
+export function buildPoSku(
+  distributorCode: string | null | undefined,
+  styleCode: string | null | undefined,
+  distributorSku: string | null | undefined,
+): string {
+  const seen = new Set<string>();
+  const kept: string[] = [];
+  for (const token of [...tokens(distributorCode), ...tokens(styleCode), ...tokens(distributorSku)]) {
+    const key = token.toLowerCase();
+    if (seen.has(key)) continue;
+    seen.add(key);
+    kept.push(key);
+  }
+  return kept.join("-");
+}
+
+/**
+ * Repair a PO SKU that was already stored with repeated tokens ("cs-cs-cs-db18").
+ * Display paths use this so an existing order reads correctly without a data
+ * migration.
+ */
+export function normalizePoSku(value: string | null | undefined): string {
+  return buildPoSku(null, null, value);
+}
diff --git a/shared/vendorCost.ts b/shared/vendorCost.ts
new file mode 100644
--- /dev/null
+++ b/shared/vendorCost.ts
@@ -0,0 +1,224 @@
+/**
+ * What a vendor row's COST is, and where it is allowed to come from.
+ *
+ * Two sources, in this order — never a third:
+ *
+ *  1. "on file"     — the SKU's stored `vendorWholesale`, which is our real landed
+ *                     cost for that item. This is the same number the PO prices
+ *                     from, and the one the vendor page already shows.
+ *  2. "calculated"  — `listPrice × that vendor's cost factor`, used only when no
+ *                     stored cost exists AND the vendor has a factor set. The
+ *                     factor is `(baseMultiplier × (1 + freightMultiplier))`, the
+ *                     admin "Distributor Multipliers" lever per supply line.
+ *
+ * If neither exists the row is "missing": we show an em dash. We never copy the
+ * list price, never borrow another vendor's factor, and never fall back to the
+ * global homeowner markup — that is a *sell*-side multiplier, so using it would
+ * present a retail price as our cost.
+ *
+ * Verified against the real order CD-20261022-OLOUT: distributor cost 284.39,
+ * list 449.34. cost / list = 284.39 / 449.34 = 0.632906, so the landed factor is
+ * 0.6329 and 449.34 × 0.6329 = 284.39 — which is exactly the stored cost. The
+ * sell side is the inverse (1 / 0.6329 = 1.58, a 36.7% margin); that is a
+ * different number and is never used here.
+ */
+
+export type VendorCostKind = "on_file" | "calculated" | "missing";
+
+export type VendorCostResult = {
+  kind: VendorCostKind;
+  /** Whole cents, or null when unknown. */
+  cents: number | null;
+  /** The list price the calculation started from, in cents. */
+  listCents: number | null;
+  /** The landed-cost factor used, e.g. 0.6329. Null unless kind is "calculated". */
+  factor: number | null;
+  /** One-line explanation for the tooltip / report. */
+  note: string;
+};
+
+export const VENDOR_COST_ON_FILE_LABEL = "on file";
+export const VENDOR_COST_CALCULATED_LABEL = "calculated";
+export const VENDOR_COST_MISSING_LABEL = "—";
+
+/**
+ * The landed-cost factor for one supply line:
+ * `base × (1 + freight)`, exactly as the Distributor Multipliers tab describes it
+ * ("Our cost = (list × Base) × (1 + Tariff)").
+ *
+ * Returns null unless both parts are usable numbers and the result is a sane
+ * fraction (0.01 … 1.00 of list) — the same bounds the admin form enforces. A
+ * factor outside that range would be a data-entry error, and inventing a cost
+ * from it would be worse than showing "—".
+ */
+export function vendorCostFactor(
+  baseMultiplier: number | string | null | undefined,
+  freightMultiplier: number | string | null | undefined,
+): number | null {
+  const base = numeric(baseMultiplier);
+  const freight = numeric(freightMultiplier) ?? 0;
+  if (base == null || base <= 0) return null;
+  const factor = base * (1 + freight);
+  if (!Number.isFinite(factor) || factor < 0.01 || factor > 1) return null;
+  return Math.round(factor * 1e6) / 1e6;
+}
+
+function numeric(value: number | string | null | undefined): number | null {
+  if (value == null || value === "") return null;
+  const parsed = typeof value === "number" ? value : Number(String(value).replace(/[$,\s]/g, ""));
+  return Number.isFinite(parsed) ? parsed : null;
+}
+
+function toCents(value: number | string | null | undefined): number | null {
+  const parsed = numeric(value);
+  return parsed == null ? null : Math.round(parsed * 100);
+}
+
+/**
+ * Resolve the cost to show for one vendor row.
+ *
+ * @param vendorWholesale the SKU's stored cost ("on file"), when it has one
+ * @param listPrice       the SKU's list price, the calculation's only input
+ * @param factor          this vendor's landed-cost factor, from vendorCostFactor()
+ */
+export function resolveVendorCost(
+  vendorWholesale: number | string | null | undefined,
+  listPrice: number | string | null | undefined,
+  factor: number | null,
+): VendorCostResult {
+  const stored = toCents(vendorWholesale);
+  if (stored != null && stored > 0) {
+    return { kind: "on_file", cents: stored, listCents: toCents(listPrice), factor: null, note: "Stored vendor cost" };
+  }
+
+  const list = toCents(listPrice);
+  if (list != null && list > 0 && factor != null) {
+    const cents = Math.round(list * factor);
+    if (cents > 0) {
+      return {
+        kind: "calculated",
+        cents,
+        listCents: list,
+        factor,
+        note: `List ${formatCents(list)} × ${factor.toFixed(2)} landed-cost factor`,
+      };
+    }
+  }
+
+  return {
+    kind: "missing",
+    cents: null,
+    listCents: list,
+    factor: null,
+    note: list == null
+      ? "No list price and no stored cost"
+      : factor == null
+        ? "No stored cost and no cost factor set for this vendor"
+        : "No stored cost and no usable list price",
+  };
+}
+
+function formatCents(cents: number): string {
+  return `$${(cents / 100).toFixed(2)}`;
+}
+
+/** "$284.39", or the em dash when the cost is unknown. */
+export function formatVendorCostCents(result: VendorCostResult): string {
+  return result.cents == null ? VENDOR_COST_MISSING_LABEL : formatCents(result.cents);
+}
+
+/** "calculated" / "on file" / "—" — the badge next to the number. */
+export function vendorCostKindLabel(kind: VendorCostKind): string {
+  if (kind === "on_file") return VENDOR_COST_ON_FILE_LABEL;
+  if (kind === "calculated") return VENDOR_COST_CALCULATED_LABEL;
+  return VENDOR_COST_MISSING_LABEL;
+}
+
+export type VendorCostSummary = {
+  onFile: number;
+  calculated: number;
+  missing: number;
+  /** Percent of rows that show a number at all. */
+  coveragePercent: number;
+};
+
+export function summarizeVendorCosts(results: readonly VendorCostResult[]): VendorCostSummary {
+  let onFile = 0;
+  let calculated = 0;
+  let missing = 0;
+  for (const result of results) {
+    if (result.kind === "on_file") onFile += 1;
+    else if (result.kind === "calculated") calculated += 1;
+    else missing += 1;
+  }
+  const total = results.length;
+  return {
+    onFile,
+    calculated,
+    missing,
+    coveragePercent: total === 0 ? 0 : Math.round(((onFile + calculated) / total) * 1000) / 10,
+  };
+}
+
+// ─── Per-vendor reporting ─────────────────────────────────────────────────────
+
+export type VendorCostRowInput = {
+  vendorId: number;
+  vendorName: string;
+  vendorWholesale: number | string | null | undefined;
+  listPrice: number | string | null | undefined;
+};
+
+export type VendorCostReport = {
+  vendorId: number;
+  vendorName: string;
+  /** This vendor's landed-cost factor, or null when none is set. */
+  factor: number | null;
+  /** Where the factor came from, in words. */
+  factorSource: string;
+  rows: number;
+  onFile: number;
+  calculated: number;
+  missing: number;
+  coveragePercent: number;
+};
+
+/**
+ * Summarise cost coverage per vendor. A vendor with no factor reports every
+ * unpriced row as missing, which is the list an administrator has to fix on the
+ * Distributor Multipliers tab.
+ */
+export function vendorCostReport(
+  input: {
+    vendorId: number;
+    vendorName: string;
+    baseMultiplier?: number | string | null;
+    freightMultiplier?: number | string | null;
+    rows: readonly Omit<VendorCostRowInput, "vendorId" | "vendorName">[];
+  },
+): VendorCostReport {
+  const factor = vendorCostFactor(input.baseMultiplier, input.freightMultiplier);
+  const results = input.rows.map((row) => resolveVendorCost(row.vendorWholesale, row.listPrice, factor));
+  const summary = summarizeVendorCosts(results);
+  const source = factor == null
+    ? "no cost factor set on Distributor Multipliers"
+    : input.freightMultiplier == null || numeric(input.freightMultiplier) === 0
+      ? "Distributor Multipliers base multiplier"
+      : "Distributor Multipliers base × (1 + freight rate)";
+  return {
+    vendorId: input.vendorId,
+    vendorName: input.vendorName,
+    factor,
+    factorSource: source,
+    rows: input.rows.length,
+    onFile: summary.onFile,
+    calculated: summary.calculated,
+    missing: summary.missing,
+    coveragePercent: summary.coveragePercent,
+  };
+}
+
+/** Vendors that still cannot show a cost for at least one row — Tom's fix list. */
+export function vendorsWithoutFactor(reports: readonly VendorCostReport[]): VendorCostReport[] {
+  return reports.filter((report) => report.factor == null && report.missing > 0);
+}
diff --git a/shared/vendorCost.test.ts b/shared/vendorCost.test.ts
new file mode 100644
--- /dev/null
+++ b/shared/vendorCost.test.ts
@@ -0,0 +1,154 @@
+import { describe, expect, it } from "vitest";
+import {
+  formatVendorCostCents,
+  resolveVendorCost,
+  summarizeVendorCosts,
+  vendorCostFactor,
+  vendorCostReport,
+  vendorsWithoutFactor,
+  vendorCostKindLabel,
+} from "./vendorCost";
+
+describe("the landed-cost factor", () => {
+  it("is base × (1 + freight), as the Multipliers tab states", () => {
+    expect(vendorCostFactor(0.63, 0.05)).toBeCloseTo(0.6615, 6);
+    expect(vendorCostFactor(0.59, 0)).toBeCloseTo(0.59, 6);
+    expect(vendorCostFactor(0.6, null)).toBeCloseTo(0.6, 6);
+  });
+
+  it("reproduces CD-20261022-OLOUT's Ashford numbers", () => {
+    // The order: distributor cost $284.39, list price $449.34.
+    // cost / list = 284.39 / 449.34 = 0.632906, so Ashford's landed factor is
+    // 0.6329 (cost is 63.29% of list; the sell side is the inverse, 1/0.6329 =
+    // 1.58). 449.34 × 0.6329 = 284.3873 → $284.39, which is the real cost.
+    const factor = vendorCostFactor(0.6329, 0);
+    expect(factor).toBeCloseTo(0.6329, 6);
+    const result = resolveVendorCost(null, 449.34, factor);
+    expect(result.kind).toBe("calculated");
+    expect(result.cents).toBe(28439);
+  });
+
+  it("rebuilds the cost through base and freight", () => {
+    // base 0.6329 with a 0 freight rate is the Ashford line as configured.
+    expect(vendorCostFactor(0.6329, 0)).toBeCloseTo(0.6329, 6);
+    // A 5% tariff on the same base costs 0.664545 of list.
+    const withTariff = vendorCostFactor(0.6329, 0.05)!;
+    expect(withTariff).toBeCloseTo(0.664545, 5);
+    expect(resolveVendorCost(null, 449.34, withTariff).cents).toBe(29861);
+  });
+
+  it("refuses a factor outside the sane range", () => {
+    expect(vendorCostFactor(0, 0)).toBeNull();
+    expect(vendorCostFactor(null, 0.05)).toBeNull();
+    expect(vendorCostFactor(1.5, 0)).toBeNull();
+    expect(vendorCostFactor(0.005, 0)).toBeNull();
+  });
+
+  it("rejects the inverse (sell-side) factor as out of range", () => {
+    // 1.58 is cost-to-sell, not cost-of-list. Feeding it in would produce a cost
+    // above the list price, so the bounds reject it instead.
+    expect(vendorCostFactor(1.58, 0)).toBeNull();
+  });
+});
+
+describe("resolving one row's cost", () => {
+  it("prefers the stored cost and labels it 'on file'", () => {
+    const result = resolveVendorCost(284.39, 449.34, 0.63);
+    expect(result).toMatchObject({ kind: "on_file", cents: 28439 });
+    expect(vendorCostKindLabel(result.kind)).toBe("on file");
+    expect(formatVendorCostCents(result)).toBe("$284.39");
+  });
+
+  it("calculates from the list price when no cost is stored", () => {
+    const result = resolveVendorCost(null, 449.34, 0.63);
+    expect(result.kind).toBe("calculated");
+    expect(result.cents).toBe(28308);
+    expect(vendorCostKindLabel(result.kind)).toBe("calculated");
+    expect(result.note).toContain("$449.34");
+    expect(result.note).toContain("0.63");
+  });
+
+  it("shows an em dash when there is no cost and no factor", () => {
+    const result = resolveVendorCost(null, 449.34, null);
+    expect(result).toMatchObject({ kind: "missing", cents: null });
+    expect(formatVendorCostCents(result)).toBe("—");
+    expect(result.note).toContain("no cost factor");
+  });
+
+  it("never copies the list price as the cost", () => {
+    const noCost = resolveVendorCost(null, 449.34, null);
+    expect(noCost.cents).not.toBe(44934);
+    // Even a stored zero is not a cost.
+    expect(resolveVendorCost(0, 449.34, null).kind).toBe("missing");
+  });
+
+  it("shows an em dash when there is no list price to calculate from", () => {
+    expect(resolveVendorCost(null, null, 0.63)).toMatchObject({ kind: "missing", cents: null });
+    expect(resolveVendorCost(null, 0, 0.63).kind).toBe("missing");
+  });
+
+  it("accepts string amounts with currency formatting", () => {
+    expect(resolveVendorCost("$284.39", "449.34", 0.63)).toMatchObject({ kind: "on_file", cents: 28439 });
+    expect(resolveVendorCost(null, "1,449.34", 0.5).cents).toBe(72467);
+  });
+});
+
+describe("vendor coverage summary", () => {
+  it("counts each kind and the coverage percent", () => {
+    const summary = summarizeVendorCosts([
+      resolveVendorCost(100, 200, 0.5),
+      resolveVendorCost(null, 200, 0.5),
+      resolveVendorCost(null, 200, null),
+      resolveVendorCost(null, 200, null),
+    ]);
+    expect(summary).toEqual({ onFile: 1, calculated: 1, missing: 2, coveragePercent: 50 });
+  });
+
+  it("is zero for no rows", () => {
+    expect(summarizeVendorCosts([]).coveragePercent).toBe(0);
+  });
+});
+
+describe("per-vendor report", () => {
+  it("states the factor and its source for a vendor that has one", () => {
+    const report = vendorCostReport({
+      vendorId: 210001,
+      vendorName: "Ashford",
+      baseMultiplier: 0.6329,
+      freightMultiplier: 0,
+      rows: [
+        { vendorWholesale: 284.39, listPrice: 449.34 },
+        { vendorWholesale: null, listPrice: 449.34 },
+        { vendorWholesale: null, listPrice: null },
+      ],
+    });
+    expect(report.factor).toBeCloseTo(0.6329, 6);
+    expect(report.factorSource).toBe("Distributor Multipliers base multiplier");
+    expect(report).toMatchObject({ rows: 3, onFile: 1, calculated: 1, missing: 1 });
+  });
+
+  it("mentions freight when the vendor has a freight rate", () => {
+    const report = vendorCostReport({ vendorId: 1, vendorName: "X", baseMultiplier: 0.6, freightMultiplier: 0.05, rows: [] });
+    expect(report.factorSource).toContain("freight rate");
+  });
+
+  it("reports a vendor with no factor as unset and lists every unpriced row as missing", () => {
+    const report = vendorCostReport({
+      vendorId: 2,
+      vendorName: "Clark and Son",
+      baseMultiplier: null,
+      freightMultiplier: null,
+      rows: [{ vendorWholesale: null, listPrice: 100 }, { vendorWholesale: 50, listPrice: 100 }],
+    });
+    expect(report.factor).toBeNull();
+    expect(report.factorSource).toBe("no cost factor set on Distributor Multipliers");
+    expect(report).toMatchObject({ onFile: 1, calculated: 0, missing: 1, coveragePercent: 50 });
+  });
+
+  it("lists exactly the vendors that still cannot price a row", () => {
+    const withFactor = vendorCostReport({ vendorId: 1, vendorName: "Ashford", baseMultiplier: 0.6329, rows: [{ vendorWholesale: null, listPrice: 100 }] });
+    const noFactor = vendorCostReport({ vendorId: 2, vendorName: "Clark and Son", rows: [{ vendorWholesale: null, listPrice: 100 }] });
+    const fullyStored = vendorCostReport({ vendorId: 3, vendorName: "Preston", rows: [{ vendorWholesale: 50, listPrice: 100 }] });
+    expect(vendorsWithoutFactor([withFactor, noFactor, fullyStored]).map((report) => report.vendorName)).toEqual(["Clark and Son"]);
+  });
+});
diff --git a/server/lib/vendorCostFactor.ts b/server/lib/vendorCostFactor.ts
new file mode 100644
--- /dev/null
+++ b/server/lib/vendorCostFactor.ts
@@ -0,0 +1,140 @@
+// Per-vendor landed-cost factor, read from distributors.
+//
+// `cost = listPrice × costMultiplier × (1 + freightMultiplier)` — the same pair
+// the Distributor Multipliers tab edits, exposed on its own so a report can state
+// which percentage filled a vendor row's cost. See docs/sql/0252 for what the
+// numbers mean (they are fractions of the list price, not markups on cost).
+
+import { inArray, sql } from "drizzle-orm";
+import { distributors } from "../../drizzle/schema";
+import { getDb } from "../db";
+import { isMissingSchemaError, schemaErrorMessage } from "./orderSchemaGuard";
+
+type Database = NonNullable<Awaited<ReturnType<typeof getDb>>>;
+
+export type VendorCostFactorRow = {
+  distributorId: number;
+  name: string | null;
+  brandName: string | null;
+  code: string | null;
+  /** Fraction of list price, e.g. 0.6329. Null when unset. */
+  baseMultiplier: number | null;
+  /** Tariff / freight rate added over the base, e.g. 0.05. Null when unset. */
+  freightMultiplier: number | null;
+  /** The resolved factor, or null when this vendor cannot price a row. */
+  costFactor: number | null;
+  /** Where the factor came from, for the report. */
+  source: string;
+};
+
+/** `base × (1 + freight)`, bounded to 0.01…1 as the admin form enforces. */
+export function resolveVendorCostFactor(
+  baseMultiplier: unknown,
+  freightMultiplier: unknown,
+): number | null {
+  const base = numberOrNull(baseMultiplier);
+  const freight = numberOrNull(freightMultiplier) ?? 0;
+  if (base == null || base <= 0) return null;
+  const factor = base * (1 + freight);
+  if (!Number.isFinite(factor) || factor < 0.01 || factor > 1) return null;
+  return Math.round(factor * 1e6) / 1e6;
+}
+
+function numberOrNull(value: unknown): number | null {
+  if (value == null || value === "") return null;
+  const parsed = typeof value === "number" ? value : Number(String(value));
+  return Number.isFinite(parsed) ? parsed : null;
+}
+
+/**
+ * Read the factor for every distributor (or the given ones). Tolerates the 0252
+ * columns being absent: every vendor then reports a null factor and the catalog
+ * keeps showing "—" instead of failing.
+ */
+export async function readVendorCostFactors(
+  db: Database,
+  distributorIds?: number[],
+): Promise<VendorCostFactorRow[]> {
+  const build = (withFactors: boolean) => {
+    const selection = {
+      id: distributors.id,
+      name: distributors.name,
+      brandName: distributors.brandName,
+      code: distributors.code,
+      ...(withFactors
+        ? {
+          baseMultiplier: sql<string | null>`costMultiplier`,
+          freightMultiplier: sql<string | null>`freightMultiplier`,
+        }
+        : { baseMultiplier: sql<string | null>`NULL`, freightMultiplier: sql<string | null>`NULL` }),
+    };
+    const query = db.select(selection).from(distributors);
+    return distributorIds?.length
+      ? query.where(inArray(distributors.id, distributorIds))
+      : query;
+  };
+
+  let rows: Array<Record<string, unknown>> = [];
+  try {
+    rows = await build(true) as Array<Record<string, unknown>>;
+  } catch (error) {
+    if (!isMissingSchemaError(error)) {
+      console.error(`[VendorCost] Could not read cost factors: ${schemaErrorMessage(error)}`);
+      return [];
+    }
+    console.warn("[VendorCost] distributors.costMultiplier is missing; run docs/sql/0252. Every vendor reports no factor.");
+    rows = await build(false) as Array<Record<string, unknown>>;
+  }
+
+  return rows.map((row) => {
+    const base = numberOrNull(row.baseMultiplier);
+    const freight = numberOrNull(row.freightMultiplier);
+    const factor = resolveVendorCostFactor(base, freight);
+    const source = factor == null
+      ? "no cost factor set on Distributor Multipliers"
+      : freight != null && freight !== 0
+        ? "Distributor Multipliers base × (1 + freight rate)"
+        : "Distributor Multipliers base multiplier";
+    return {
+      distributorId: Number(row.id),
+      name: (row.name as string | null) ?? null,
+      brandName: (row.brandName as string | null) ?? null,
+      code: (row.code as string | null) ?? null,
+      baseMultiplier: base,
+      freightMultiplier: freight,
+      costFactor: factor,
+      source,
+    };
+  });
+}
+
+/**
+ * Set one vendor's factor. An administrator action from the Multipliers tab.
+ * `null` clears it, which puts that vendor's unpriced rows back to "—".
+ */
+export async function setVendorCostFactor(
+  db: Database,
+  input: { distributorId: number; baseMultiplier: number | null; freightMultiplier?: number | null },
+): Promise<{ ok: boolean; error?: string }> {
+  const base = input.baseMultiplier;
+  if (base != null && (base < 0.01 || base > 1)) {
+    return { ok: false, error: "The cost factor must be between 0.01 and 1.00 of the list price." };
+  }
+  const freight = input.freightMultiplier ?? null;
+  if (freight != null && (freight < 0 || freight > 1)) {
+    return { ok: false, error: "The freight rate must be between 0 and 1." };
+  }
+  try {
+    await db.execute(sql`
+      UPDATE distributors
+      SET costMultiplier = ${base}, freightMultiplier = ${freight}
+      WHERE id = ${input.distributorId}
+    `);
+    return { ok: true };
+  } catch (error) {
+    if (isMissingSchemaError(error)) {
+      return { ok: false, error: "Run docs/sql/0252 before setting a cost factor." };
+    }
+    return { ok: false, error: schemaErrorMessage(error) };
+  }
+}
