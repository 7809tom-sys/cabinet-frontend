+    expect(rows[1]).toBe('CD-20261022-OLOUT,2026-10-22,CS-DB18,"18"" 3 Drawer Base Cabinet",Carmel Shaker,1,284.39,284.39');
+    expect(rows[2]).toBe("CD-20261022-OLOUT,2026-10-22,Subtotal,,,,,284.39");
