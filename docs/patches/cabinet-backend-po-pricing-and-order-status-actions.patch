+import { describe, expect, it, vi } from "vitest";
+import { activityActorLabel, logOrderActivity, readOrderActivity, backfillOrderActivity } from "./orderActivityLog";
+
+/** A db double that records executed SQL calls and can fail on demand. */
+function fakeDb(options: { failWith?: string; rows?: unknown[] } = {}) {
+  const calls: unknown[] = [];
+  return {
+    calls,
+    execute: vi.fn(async (statement: unknown) => {
+      calls.push(statement);
+      if (options.failWith) throw new Error(options.failWith);
+      return (options.rows ?? []) as never;
+    }),
+  } as never as { execute: typeof vi.fn; calls: unknown[] };
+}
+
+describe("activity actor label", () => {
+  it("stores the name and the email together", () => {
+    expect(activityActorLabel("Dana Reaves", "dana@cabinetdealz.com")).toBe("Dana Reaves <dana@cabinetdealz.com>");
+  });
+
+  it("falls back through name, email, then 'system'", () => {
+    expect(activityActorLabel("Dana", null)).toBe("Dana");
+    expect(activityActorLabel(null, "dana@cabinetdealz.com")).toBe("dana@cabinetdealz.com");
+    expect(activityActorLabel(null, null)).toBe("system");
+    expect(activityActorLabel("  ", "  ")).toBe("system");
+  });
+
+  it("keeps within the 255-character column", () => {
+    expect(activityActorLabel("x".repeat(400), "y@z.com").length).toBe(255);
+  });
+});
+
+describe("logging an action", () => {
+  it("inserts one row per action", async () => {
+    const db = fakeDb();
+    const ok = await logOrderActivity(db as never, {
+      orderRequestId: 18,
+      action: "verified",
+      actorName: "Selena Ortiz",
+      actorUserId: 7,
+    });
+    expect(ok).toBe(true);
+    expect(db.execute).toHaveBeenCalledOnce();
+  });
+
+  it("logs a repeat as its own action, not an update", async () => {
+    const db = fakeDb();
+    await logOrderActivity(db as never, { orderRequestId: 18, action: "distributor_emailed", actorName: "Selena Ortiz" });
+    await logOrderActivity(db as never, { orderRequestId: 18, action: "distributor_email_resent", actorName: "Selena Ortiz" });
+    expect(db.execute).toHaveBeenCalledTimes(2);
+  });
+
+  it("does not throw when the table is missing", async () => {
+    const db = fakeDb({ failWith: "Table 'cabinet_dealz.order_events' doesn't exist" });
+    await expect(logOrderActivity(db as never, { orderRequestId: 18, action: "verified", actorName: "Selena" })).resolves.toBe(false);
+  });
+
+  it("does not throw on an unrelated failure either", async () => {
+    const db = fakeDb({ failWith: "connection reset" });
+    await expect(logOrderActivity(db as never, { orderRequestId: 18, action: "verified" })).resolves.toBe(false);
+  });
+
+  it("reading is empty, not an error, before the table exists", async () => {
+    const db = fakeDb({ failWith: "ER_NO_SUCH_TABLE" });
+    await expect(readOrderActivity(db as never, 18)).resolves.toEqual([]);
+  });
+
+  it("backfilling a missing table is a no-op", async () => {
+    const db = fakeDb({ failWith: "ER_NO_SUCH_TABLE" });
+    await expect(backfillOrderActivity(db as never, 18)).resolves.toBe(0);
+  });
+});
