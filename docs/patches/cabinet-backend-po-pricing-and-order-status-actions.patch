+    expect(overrideActorLabel("Dana Reaves", "dana@cabinetdealz.com")).toBe("Dana Reaves <dana@cabinetdealz.com>");
+  });
+
+  it("falls back to whichever half exists, then 'admin'", () => {
+    expect(overrideActorLabel("Dana", null)).toBe("Dana");
+    expect(overrideActorLabel(null, "dana@cabinetdealz.com")).toBe("dana@cabinetdealz.com");
+    expect(overrideActorLabel(null, null)).toBe("admin");
+  });
+
+  it("keeps within the 255-character column", () => {
+    expect(overrideActorLabel("x".repeat(400), "y@z.com").length).toBe(255);
+  });
+});
+
+describe("forcing a cabinet ready", () => {
+  it("writes the tri-state value, the actor and the time", async () => {
+    const db = fakeDb();
+    const result = await setDesignerOverride(db as never, {
+      cabinetId: 481,
+      state: "ready",
+      by: "Dana Reaves <dana@cabinetdealz.com>",
+      derivedFrom: "W3024",
+      width: 30,
+      height: 24,
+      depth: 12,
+      now: new Date("2026-11-06T02:00:00.000Z"),
+    });
+    expect(result).toEqual({ ok: true, state: "ready" });
+    expect(db.execute).toHaveBeenCalledOnce();
+  });
+
+  it("passes null dimensions for a row that already has them, so nothing is overwritten", async () => {
+    const db = fakeDb();
+    await setDesignerOverride(db as never, {
+      cabinetId: 481,
+      state: "ready",
+      by: "Dana",
+      derivedFrom: null,
+      width: null,
+      height: null,
+      depth: null,
+    });
+    expect(db.execute).toHaveBeenCalledOnce();
+  });
+});
+
+describe("forcing a cabinet off", () => {
+  it("records the reason and the back-in-stock date", async () => {
+    const db = fakeDb();
+    const result = await setDesignerOverride(db as never, {
+      cabinetId: 481,
+      state: "off",
+      by: "Dana Reaves",
+      offReason: "Out of stock",
+      offUntil: "2027-08-01",
+    });
+    expect(result).toEqual({ ok: true, state: "off" });
+  });
+
+  it("defaults the reason when none was given", async () => {
+    const db = fakeDb();
+    await setDesignerOverride(db as never, { cabinetId: 1, state: "off", by: "Dana", offReason: null });
+    expect(db.execute).toHaveBeenCalledOnce();
+  });
+
+  it("needs no dimensions at all", async () => {
+    const db = fakeDb();
+    await expect(setDesignerOverride(db as never, { cabinetId: 1, state: "off", by: "Dana" })).resolves.toMatchObject({ ok: true });
+  });
+});
+
+describe("resetting to automatic", () => {
+  it("nulls every override column", async () => {
+    const db = fakeDb();
+    await expect(clearDesignerOverride(db as never, 481)).resolves.toEqual({ ok: true, state: null });
+    expect(db.execute).toHaveBeenCalledOnce();
+  });
+});
+
+describe("an un-migrated database", () => {
+  it("says which SQL to run instead of failing obscurely", async () => {
+    const db = fakeDb("Unknown column 'designerReadyOverride' in 'field list'");
+    const result = await setDesignerOverride(db as never, { cabinetId: 1, state: "ready", by: "Dana" });
+    expect(result.ok).toBe(false);
+    if (result.ok) throw new Error("unreachable");
+    expect(result.error).toContain("0253");
+  });
+
+  it("does the same for a reset", async () => {
+    const db = fakeDb("ER_BAD_FIELD_ERROR: Unknown column 'designerReadyOverride'");
+    const result = await clearDesignerOverride(db as never, 1);
+    expect(result.ok).toBe(false);
+    if (result.ok) throw new Error("unreachable");
+    expect(result.error).toContain("0253");
+  });
+});
