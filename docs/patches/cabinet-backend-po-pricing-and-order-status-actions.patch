@@ -0,0 +1,25 @@
+import { describe, expect, it } from "vitest";
+import { buildPoSku, normalizePoSku } from "@shared/poSku";
+
+/**
+ * The admin order page showed "cs-cs-cs-db18" for CD-20261022-OLOUT: the
+ * distributor code ("CS"), the door style code ("CS") and the distributor item
+ * code ("CS-DB18") were concatenated without noticing they repeat.
+ */
+describe("the PO SKU sent to a distributor", () => {
+  it("does not repeat the CS prefix three times", () => {
+    expect(buildPoSku("CS", "CS", "CS-DB18")).toBe("cs-db18");
+  });
+
+  it("still builds the usual three-part SKU", () => {
+    expect(buildPoSku("USD", "SW", "3DB24")).toBe("usd-sw-3db24");
+  });
+
+  it("keeps the style code when only two of the parts collide", () => {
+    expect(buildPoSku("CS", "WS", "CS-DB18")).toBe("cs-ws-db18");
+  });
+
+  it("repairs a SKU already stored with the repeated prefix", () => {
+    expect(normalizePoSku("cs-cs-cs-db18")).toBe("cs-db18");
+  });
+});
diff --git a/server/lib/orderActivityLog.ts b/server/lib/orderActivityLog.ts
new file mode 100644
index 0000000..f217895
--- /dev/null
+++ b/server/lib/orderActivityLog.ts
@@ -0,0 +1,161 @@
+// Append-only order activity log. Every status action writes one row, so the
+// sales order timeline can show who did what, including a resend that would
+// otherwise overwrite the previous send time.
+//
+// Writes never throw: an order action must still succeed when logging fails, so
+// the timeline is a record of the action rather than a condition for it.
+
+import { sql } from "drizzle-orm";
+import { getDb } from "../db";
+import { isMissingSchemaError, schemaErrorMessage } from "./orderSchemaGuard";
+
+type Database = NonNullable<Awaited<ReturnType<typeof getDb>>>;
+
+export type OrderActivityAction =
+  | "purchased"
+  | "order_received_email"
+  | "distributor_emailed"
+  | "distributor_email_resent"
+  | "verified"
+  | "shipped"
+  | "signed"
+  | "receipt_sent"
+  | "payment_notice"
+  | "note";
+
+export type OrderActivityInput = {
+  orderRequestId: number;
+  action: OrderActivityAction;
+  actorUserId?: number | null;
+  /** "Name <email>" / "Name" / "system". Never empty. */
+  actorName?: string | null;
+  detail?: string | null;
+};
+
+/** "Dana Reaves <dana@cabinetdealz.com>", the column width. */
+export function activityActorLabel(
+  name: string | null | undefined,
+  email: string | null | undefined,
+  fallback = "system",
+): string {
+  const who = (name ?? "").trim();
+  const address = (email ?? "").trim();
+  if (who && address) return `${who} <${address}>`.slice(0, 255);
+  if (who) return who.slice(0, 255);
+  if (address) return address.slice(0, 255);
+  return fallback;
+}
+
+/** Append one row. Returns false when the table is not there yet. */
+export async function logOrderActivity(
+  db: Database,
+  input: OrderActivityInput,
+): Promise<boolean> {
+  try {
+    await db.execute(sql`
+      INSERT INTO order_events (orderRequestId, action, actorUserId, actorName, detail)
+      VALUES (
+        ${input.orderRequestId},
+        ${input.action},
+        ${input.actorUserId ?? null},
+        ${activityActorLabel(input.actorName, null)},
+        ${input.detail ? input.detail.slice(0, 1024) : null}
+      )
+    `);
+    return true;
+  } catch (error) {
+    if (isMissingSchemaError(error)) {
+      console.warn(`[OrderActivity] order_events is missing; run the 0251 SQL. Action ${input.action} for order ${input.orderRequestId} was not logged.`);
+      return false;
+    }
+    console.error(`[OrderActivity] Could not log ${input.action} for order ${input.orderRequestId}: ${schemaErrorMessage(error)}`);
+    return false;
+  }
+}
+
+/** Read an order's rows, oldest first. */
+export async function readOrderActivity(
+  db: Database,
+  orderRequestId: number,
+): Promise<Array<Record<string, unknown>>> {
+  try {
+    const result = await db.execute(sql`
+      SELECT id, orderRequestId, action, actorUserId, actorName, detail, createdAt
+      FROM order_events
+      WHERE orderRequestId = ${orderRequestId}
+      ORDER BY createdAt ASC, id ASC
+    `);
+    const rows = Array.isArray(result) ? result : [];
+    if (rows.length && Array.isArray(rows[0])) return rows[0] as Array<Record<string, unknown>>;
+    return rows as Array<Record<string, unknown>>;
+  } catch (error) {
+    if (isMissingSchemaError(error)) return [];
+    console.error(`[OrderActivity] Could not read activity for order ${orderRequestId}: ${schemaErrorMessage(error)}`);
+    return [];
+  }
+}
+
+/**
+ * Backfill the log from the order's own status columns.
+ *
+ * Older orders predate order_events, and their timeline would otherwise be
+ * empty. This inserts one row per stamped step, with the original time preserved
+ * and the stored actor label. It is idempotent: a step that already has a logged
+ * row of the same action is skipped, so running it twice does not duplicate.
+ */
+export async function backfillOrderActivity(db: Database, orderId: number): Promise<number> {
+  const existing = await readOrderActivity(db, orderId);
+  if (existing.length > 0) return 0;
+  let inserted = 0;
+  try {
+    const result = await db.execute(sql`
+      SELECT id, requestNumber, originatorName, originatorEmail, createdAt, paidAt,
+        orderReceivedEmailSentAt, orderReceivedEmailTo,
+        distributorEmailSentAt, distributorEmailSentBy, distributorEmailTo,
+        orderVerifiedAt, orderVerifiedBy,
+        orderShippedAt, orderShippedBy, shipmentCarrier, shipmentTracking,
+        orderSignedAt, orderSignedBy, signerName,
+        receiptSentAt, receiptEmailedAt
+      FROM order_requests
+      WHERE id = ${orderId}
+      LIMIT 1
+    `);
+    const rows = Array.isArray(result) && Array.isArray(result[0]) ? result[0] as Array<Record<string, unknown>> : result as unknown as Array<Record<string, unknown>>;
+    const order = rows[0];
+    if (!order) return 0;
+
+    const customer = activityActorLabel(
+      (order.originatorName as string | null) ?? null,
+      (order.originatorEmail as string | null) ?? null,
+      "Customer",
+    );
+    const steps: Array<{ action: OrderActivityAction; at: unknown; actor: string | null; detail: string | null }> = [
+      { action: "purchased", at: order.paidAt ?? order.createdAt, actor: customer, detail: null },
+      { action: "order_received_email", at: order.orderReceivedEmailSentAt, actor: "system", detail: (order.orderReceivedEmailTo as string | null) ?? null },
+      { action: "distributor_emailed", at: order.distributorEmailSentAt, actor: (order.distributorEmailSentBy as string | null) ?? "system", detail: (order.distributorEmailTo as string | null) ?? null },
+      { action: "verified", at: order.orderVerifiedAt, actor: (order.orderVerifiedBy as string | null) ?? null, detail: null },
+      {
+        action: "shipped",
+        at: order.orderShippedAt,
+        actor: (order.orderShippedBy as string | null) ?? null,
+        detail: [order.shipmentCarrier, order.shipmentTracking].map((part) => (part as string | null) ?? "").join(" · ").replace(/^ · | · $/g, "") || null,
