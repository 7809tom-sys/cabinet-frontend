+++ b/server/lib/vendorCostFactor.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it, vi } from "vitest";
+import { resolveVendorCostFactor, readVendorCostFactors, setVendorCostFactor } from "./vendorCostFactor";
+
+describe("the vendor cost factor", () => {
+  it("is base × (1 + freight)", () => {
+    expect(resolveVendorCostFactor(0.6329, 0)).toBeCloseTo(0.6329, 6);
+    expect(resolveVendorCostFactor(0.6, 0.05)).toBeCloseTo(0.63, 6);
+    expect(resolveVendorCostFactor("0.6329", null)).toBeCloseTo(0.6329, 6);
+  });
+
+  it("rebuilds Ashford's real CD-20261022-OLOUT cost", () => {
+    // 449.34 list × 0.6329 = 284.39, the stored distributor cost.
+    const factor = resolveVendorCostFactor(0.6329, 0)!;
+    expect(Math.round(449.34 * factor * 100)).toBe(28439);
+  });
+
+  it("is null when unset or out of range", () => {
+    expect(resolveVendorCostFactor(null, null)).toBeNull();
+    expect(resolveVendorCostFactor(0, 0)).toBeNull();
+    expect(resolveVendorCostFactor(1.58, 0)).toBeNull();
+    expect(resolveVendorCostFactor(0.001, 0)).toBeNull();
+  });
+});
+
+function fakeDb(rows: unknown[] = [], error?: string) {
+  const where = vi.fn(async () => rows);
+  const select = vi.fn(() => ({
+    from: () => ({ where, then: (resolve: (value: unknown) => void) => resolve(rows) }),
+  }));
+  const execute = vi.fn(async () => {
+    if (error) throw new Error(error);
+    return [] as never;
+  });
+  return { select, execute, where } as never as {
+    select: typeof select; execute: typeof execute; where: typeof where;
+  };
+}
+
+describe("reading factors", () => {
+  it("reports the factor and its source per vendor", async () => {
+    const db = fakeDb([
+      { id: 210001, name: "Ashford", brandName: null, code: "CS", baseMultiplier: "0.6329", freightMultiplier: "0" },
+      { id: 450001, name: "DL Cabinetry", brandName: null, code: "DL", baseMultiplier: null, freightMultiplier: null },
+    ]);
+    const rows = await readVendorCostFactors(db as never);
+    expect(rows[0]).toMatchObject({ distributorId: 210001, costFactor: 0.6329, source: "Distributor Multipliers base multiplier" });
+    expect(rows[1]).toMatchObject({ distributorId: 450001, costFactor: null, source: "no cost factor set on Distributor Multipliers" });
+  });
+
+  it("mentions freight when the vendor has a rate", async () => {
+    const db = fakeDb([{ id: 1, name: "X", code: "X", baseMultiplier: "0.6", freightMultiplier: "0.05" }]);
+    const rows = await readVendorCostFactors(db as never);
+    expect(rows[0].costFactor).toBeCloseTo(0.63, 6);
+    expect(rows[0].source).toContain("freight rate");
+  });
+
+  it("falls back to no factor when the 0252 columns are missing", async () => {
+    const db = fakeDb([{ id: 1, name: "X", code: "X", baseMultiplier: null, freightMultiplier: null }], "Unknown column 'costMultiplier' in 'field list'");
+    // First select succeeds in this double; the point is it never throws.
+    const rows = await readVendorCostFactors(db as never);
+    expect(rows.length).toBeGreaterThan(0);
+  });
+});
+
+describe("setting a factor", () => {
+  it("refuses a factor outside 0.01…1 rather than storing a wrong percentage", async () => {
+    const db = fakeDb();
+    await expect(setVendorCostFactor(db as never, { distributorId: 1, baseMultiplier: 1.58 })).resolves.toMatchObject({ ok: false });
+    expect(db.execute).not.toHaveBeenCalled();
+  });
+
+  it("refuses a negative freight rate", async () => {
+    const db = fakeDb();
+    await expect(setVendorCostFactor(db as never, { distributorId: 1, baseMultiplier: 0.6, freightMultiplier: -1 })).resolves.toMatchObject({ ok: false });
+  });
+
+  it("saves a valid factor", async () => {
+    const db = fakeDb();
+    await expect(setVendorCostFactor(db as never, { distributorId: 210001, baseMultiplier: 0.6329, freightMultiplier: 0 })).resolves.toEqual({ ok: true });
+    expect(db.execute).toHaveBeenCalledOnce();
+  });
+
+  it("explains that the SQL has to run first", async () => {
+    const db = fakeDb([], "Unknown column 'costMultiplier' in 'field list'");
+    const result = await setVendorCostFactor(db as never, { distributorId: 1, baseMultiplier: 0.6 });
+    expect(result.ok).toBe(false);
+    expect(result.error).toContain("0252");
+  });
+});
diff --git a/shared/cabinetSkuDimensions.ts b/shared/cabinetSkuDimensions.ts
new file mode 100644
--- /dev/null
+++ b/shared/cabinetSkuDimensions.ts
@@ -0,0 +1,53 @@
+/**
+ * Reading a cabinet's width, height and depth out of its SKU.
+ *
+ * This mirrors `wallCabinetSkuDimensions` in `client/src/lib/design.ts` — the
+ * parser the 3D Designer itself uses — so a dimension derived here builds the
+ * same box the plan will. It lives in `shared/` because the server needs the same
+ * answer when it validates an admin override.
+ *
+ * Only unambiguous codes resolve. A code that does not match one of these exact
+ * shapes returns null, and the caller must then refuse rather than guess.
+ */
+
+export type CabinetDimensionsIn = { width: number; height: number; depth: number };
+
+/** The wall-cabinet code shapes, in the Designer's own precedence order. */
+export function wallCabinetSkuDimensions(masterCode: string | null | undefined): CabinetDimensionsIn | null {
+  const code = (masterCode ?? "").trim().toUpperCase();
+  const match = (pattern: RegExp) => code.match(pattern);
+  let parsed = match(/(?:^|[^A-Z0-9])W-(\d{2})-(\d{2})$/);
+  if (parsed) return { width: Number(parsed[1]), height: Number(parsed[2]), depth: 12 };
+  parsed = match(/(?:^|[^A-Z0-9])WR(\d{2})(\d{2})$/);
+  if (parsed) return { width: Number(parsed[1]), height: Number(parsed[2]), depth: 24 };
+  parsed = match(/(?:^|[^A-Z0-9])W(\d{2})(\d{2})GD$/);
+  if (parsed) return { width: Number(parsed[1]), height: Number(parsed[2]), depth: 12 };
+  parsed = match(/(?:^|[^A-Z0-9])W(\d{2})(\d{2})(\d{2})$/);
+  if (parsed) return { width: Number(parsed[1]), height: Number(parsed[2]), depth: Number(parsed[3]) };
+  parsed = match(/(?:^|[^A-Z0-9])W(\d{2})(\d{2})$/);
+  if (parsed) return { width: Number(parsed[1]), height: Number(parsed[2]), depth: 12 };
+  return null;
+}
+
+/**
+ * Standard base-cabinet depth. Base codes carry width and height but not depth,
+ * so 24" is the convention rather than a parse — it is only used when the code
+ * really is a base cabinet (B24, B30FH, 3DB18 …).
+ */
+export const BASE_CABINET_DEPTH_IN = 24;
+
+/** `B24` → 24W × 34.5H × 24D. `B30FH` → 30W × 34.5H × 24D. */
+export function baseCabinetSkuDimensions(masterCode: string | null | undefined): CabinetDimensionsIn | null {
+  const code = (masterCode ?? "").trim().toUpperCase();
+  const parsed = code.match(/(?:^|[^A-Z0-9])(?:B|3DB|2DB|DB)(\d{2})(?:FH)?$/);
+  if (!parsed) return null;
+  return { width: Number(parsed[1]), height: 34.5, depth: BASE_CABINET_DEPTH_IN };
+}
+
+/**
+ * Dimensions from a SKU, wall first then base. Returns null when neither shape
+ * matches — never a best guess.
+ */
+export function cabinetSkuDimensions(masterCode: string | null | undefined): CabinetDimensionsIn | null {
+  return wallCabinetSkuDimensions(masterCode) ?? baseCabinetSkuDimensions(masterCode);
+}
