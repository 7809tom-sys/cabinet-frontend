+    expect(designerOffLabel({ designerReadyOverride: "ready" }, () => null, NOW)).toBeNull();
+  });
+
+  it("names who turned it off and when", () => {
+    expect(designerOffAttribution({
+      designerReadyOverride: "off",
+      designerReadyOverrideBy: "Dana Reaves <dana@cabinetdealz.com>",
+      designerReadyOverrideAt: "2026-11-05T19:47:00.000Z",
+    }, () => "Nov 5, 2026, 1:47 PM CT", NOW)).toBe("Turned off by Dana Reaves · Nov 5, 2026, 1:47 PM CT");
+  });
+});
+
+describe("automatic return on the back-in-stock date", () => {
+  const off = {
+    ...w3024,
+    width: 30, height: 24, depth: 12,
+    designerEligible: true,
+    designerReadyOverride: "off" as const,
+    designerOffReason: "Out of stock",
+    designerOffUntil: "2027-08-01T00:00:00.000Z",
+  };
+
+  it("stays off before the date", () => {
+    expect(effectiveDesignerEligible(off, new Date("2027-07-30T23:59:00.000Z"))).toBe(false);
+  });
+
+  it("returns to automatic on that Central calendar date, with no cron", () => {
+    // "2027-08-01" means August 1 in Central. 2027-08-01T05:00:00Z is midnight CDT
+    // on the 1st, which is the first instant it is back.
+    const onTheDay = new Date("2027-08-01T05:00:00.000Z");
+    expect(effectiveDesignerEligible(off, onTheDay)).toBe(true);
+    expect(activeDesignerOverride(off, onTheDay)).toBeNull();
+    expect(designerOffExpired(off, onTheDay)).toBe(true);
+    // An hour earlier it is still July 31 in Central, so still off.
+    expect(effectiveDesignerEligible(off, new Date("2027-08-01T04:00:00.000Z"))).toBe(false);
+  });
+
+  it("falls back to the catalog's own answer, not to 'on'", () => {
+    const wasIneligible = { ...off, designerEligible: false };
+    expect(effectiveDesignerEligible(wasIneligible, new Date("2027-08-01T05:00:00.000Z"))).toBe(false);
+  });
+
+  it("stays off forever when no date was given", () => {
+    const noDate = { ...off, designerOffUntil: null };
+    expect(effectiveDesignerEligible(noDate, new Date("2030-01-01T00:00:00.000Z"))).toBe(false);
+    expect(designerOffExpired(noDate, new Date("2030-01-01T00:00:00.000Z"))).toBe(false);
+  });
+
+  it("stops showing the Off label once it has expired", () => {
+    expect(designerOffLabel(off, () => "Aug 1, 2027", new Date("2027-08-03T00:00:00.000Z"))).toBeNull();
+  });
+});
+
+describe("saved designs that contain the item", () => {
+  it("keeps the item and marks it unavailable while turned off", () => {
+    expect(savedDesignItemAvailability({
+      ...w3024,
+      designerEligible: true,
+      designerReadyOverride: "off",
+      designerOffReason: "Out of stock",
+    })).toEqual({ available: false, label: "Unavailable — Out of stock" });
+  });
+
+  it("leaves an available item alone", () => {
+    expect(savedDesignItemAvailability({ ...w3024, width: 30, height: 24, depth: 12, designerEligible: true }))
+      .toEqual({ available: true, label: null });
+  });
+
+  it("marks an item the rules never allowed, too", () => {
+    expect(savedDesignItemAvailability(w3024)).toEqual({ available: false, label: "Unavailable — not designer ready" });
+  });
+});
diff --git a/server/lib/designerOverride.ts b/server/lib/designerOverride.ts
new file mode 100644
--- /dev/null
+++ b/server/lib/designerOverride.ts
@@ -0,0 +1,143 @@
+// Admin override of a cabinet's Designer availability.
+//
+// The stored column is a tri-state (`ENUM('ready','off') NULL`), never a boolean:
+// NULL means automatic, and the catalog's own `designerEligible` rules decide.
+// Both overrides record who and when, and both are reversible.
+//
+// When an administrator approves an item whose dimensions had to be derived from
+// its SKU, those dimensions are written onto the cabinet as well, so the Designer
+// has a real box to build immediately rather than a flag it cannot render.
+
+import { eq, sql } from "drizzle-orm";
+import { cabinets } from "../../drizzle/schema";
+import { getDb } from "../db";
+import { isMissingSchemaError, schemaErrorMessage } from "./orderSchemaGuard";
+
+type Database = NonNullable<Awaited<ReturnType<typeof getDb>>>;
+
+export type DesignerOverrideState = "ready" | "off";
+
+export type DesignerOverrideResult =
+  | { ok: true; state: DesignerOverrideState | null }
+  | { ok: false; error: string };
+
+/** "Name <email>" for the attribution column. */
+export function overrideActorLabel(name: string | null | undefined, email: string | null | undefined): string {
+  const who = (name ?? "").trim();
+  const address = (email ?? "").trim();
+  if (who && address) return `${who} <${address}>`.slice(0, 255);
+  if (who) return who.slice(0, 255);
+  if (address) return address.slice(0, 255);
+  return "admin";
+}
+
+/**
+ * Force a cabinet into or out of the Designer.
+ *
+ * `dimensions` is only used for "ready", and only when they were derived; the
+ * caller passes nulls otherwise so a complete catalog row is never overwritten.
+ */
+export async function setDesignerOverride(
+  db: Database,
+  input: {
+    cabinetId: number;
+    state: DesignerOverrideState;
+    by: string;
+    /** "ready" only: dimensions derived from the SKU, when the row lacked them. */
+    derivedFrom?: string | null;
+    width?: number | null;
+    height?: number | null;
+    depth?: number | null;
+    /** "off" only: why, and any back-in-stock calendar date (YYYY-MM-DD). */
+    offReason?: string | null;
+    offUntil?: string | null;
+    now?: Date;
+  },
+): Promise<DesignerOverrideResult> {
+  const now = (input.now ?? new Date()).toISOString();
+  try {
+    if (input.state === "ready") {
+      await db.execute(sql`
+        UPDATE cabinets
+        SET designerReadyOverride = 'ready',
+            designerReadyOverrideBy = ${input.by.slice(0, 255)},
+            designerReadyOverrideAt = ${now},
+            designerReadyDerivedFrom = ${input.derivedFrom ? input.derivedFrom.slice(0, 64) : null},
+            designerOffReason = NULL,
+            designerOffUntil = NULL,
+            width = COALESCE(${input.width ?? null}, width),
+            height = COALESCE(${input.height ?? null}, height),
+            depth = COALESCE(${input.depth ?? null}, depth)
+        WHERE id = ${input.cabinetId}
+      `);
+      return { ok: true, state: "ready" };
+    }
+
+    await db.execute(sql`
+      UPDATE cabinets
+      SET designerReadyOverride = 'off',
+          designerReadyOverrideBy = ${input.by.slice(0, 255)},
+          designerReadyOverrideAt = ${now},
+          designerOffReason = ${(input.offReason ?? "Out of stock").slice(0, 255)},
+          designerOffUntil = ${input.offUntil ?? null}
+      WHERE id = ${input.cabinetId}
+    `);
+    return { ok: true, state: "off" };
+  } catch (error) {
+    if (isMissingSchemaError(error)) {
+      return { ok: false, error: "Run docs/sql/0253 before changing Designer availability." };
+    }
+    return { ok: false, error: schemaErrorMessage(error) };
+  }
+}
+
+/** Reset to automatic: the catalog's own rules decide again. */
+export async function clearDesignerOverride(db: Database, cabinetId: number): Promise<DesignerOverrideResult> {
+  try {
+    await db.execute(sql`
+      UPDATE cabinets
+      SET designerReadyOverride = NULL,
+          designerReadyOverrideBy = NULL,
+          designerReadyOverrideAt = NULL,
+          designerReadyDerivedFrom = NULL,
+          designerOffReason = NULL,
+          designerOffUntil = NULL
+      WHERE id = ${cabinetId}
+    `);
+    return { ok: true, state: null };
+  } catch (error) {
+    if (isMissingSchemaError(error)) {
+      return { ok: false, error: "Run docs/sql/0253 before changing Designer availability." };
+    }
+    return { ok: false, error: schemaErrorMessage(error) };
+  }
+}
+
+/** One cabinet's override columns, for the admin screens. */
+export async function readDesignerOverride(
+  db: Database,
+  cabinetId: number,
+): Promise<Record<string, unknown> | null> {
+  try {
+    const [row] = await db
+      .select({
+        id: cabinets.id,
+        masterCode: cabinets.masterCode,
+        designerEligible: cabinets.designerEligible,
+        designerReadyOverride: sql<string | null>`designerReadyOverride`,
+        designerReadyOverrideBy: sql<string | null>`designerReadyOverrideBy`,
+        designerReadyOverrideAt: sql<string | null>`designerReadyOverrideAt`,
+        designerReadyDerivedFrom: sql<string | null>`designerReadyDerivedFrom`,
+        designerOffReason: sql<string | null>`designerOffReason`,
+        designerOffUntil: sql<string | null>`designerOffUntil`,
+      })
+      .from(cabinets)
+      .where(eq(cabinets.id, cabinetId))
+      .limit(1);
+    return (row as Record<string, unknown>) ?? null;
+  } catch (error) {
+    if (isMissingSchemaError(error)) return null;
+    console.error(`[DesignerOverride] Could not read cabinet ${cabinetId}: ${schemaErrorMessage(error)}`);
+    return null;
+  }
+}
