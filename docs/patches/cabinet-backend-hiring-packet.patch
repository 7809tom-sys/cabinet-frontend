+  const n = digits.split("").map((digit) => Number(digit));
+  const sum = 3 * (n[0]! + n[3]! + n[6]!) + 7 * (n[1]! + n[4]! + n[7]!) + (n[2]! + n[5]! + n[8]!);
+  return sum % 10 === 0;
+}
