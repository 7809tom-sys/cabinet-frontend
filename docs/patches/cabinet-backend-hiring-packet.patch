+++ b/drizzle/hiringPacketSchema.ts
@@ -0,0 +1,81 @@
+import { int, mysqlTable, text, timestamp, uniqueIndex, varchar, index } from "drizzle-orm/mysql-core";
+
+// Hiring packets. SQL 0274 creates these tables. Nothing here deletes rows.
+// payloadJson can hold an SSN or bank number. Do not log it.
+
+export const hiringPackets = mysqlTable("hiring_packets", {
+  id: int("id").autoincrement().primaryKey(),
+  userId: int("userId"),
+  applicantEmail: varchar("applicantEmail", { length: 320 }).notNull(),
+  applicantName: varchar("applicantName", { length: 255 }),
+  workerType: varchar("workerType", { length: 32 }).default("contractor_1099").notNull(),
+  workState: varchar("workState", { length: 2 }),
+  createdAt: timestamp("createdAt").defaultNow().notNull(),
+  updatedAt: timestamp("updatedAt").defaultNow().onUpdateNow().notNull(),
+}, (table) => ({
+  userIdx: index("hiring_packets_user_idx").on(table.userId),
+  emailIdx: index("hiring_packets_email_idx").on(table.applicantEmail),
+}));
+
+export const hiringPacketDocuments = mysqlTable("hiring_packet_documents", {
+  id: int("id").autoincrement().primaryKey(),
+  packetId: int("packetId").notNull(),
+  kind: varchar("kind", { length: 40 }).notNull(),
+  status: varchar("status", { length: 16 }).default("not_started").notNull(),
+  payloadJson: text("payloadJson"),
+  signedAt: timestamp("signedAt"),
+  signedByUserId: int("signedByUserId"),
+  signedByName: varchar("signedByName", { length: 255 }),
+  reviewedAt: timestamp("reviewedAt"),
+  reviewedByUserId: int("reviewedByUserId"),
+  reviewedByName: varchar("reviewedByName", { length: 255 }),
+  contentSha256: varchar("contentSha256", { length: 64 }),
+  createdAt: timestamp("createdAt").defaultNow().notNull(),
+  updatedAt: timestamp("updatedAt").defaultNow().onUpdateNow().notNull(),
+}, (table) => ({
+  packetKind: uniqueIndex("hiring_packet_documents_packet_kind_uq").on(table.packetId, table.kind),
+  statusIdx: index("hiring_packet_documents_status_idx").on(table.status),
+}));
+
+export const hiringPacketFiles = mysqlTable("hiring_packet_files", {
+  id: int("id").autoincrement().primaryKey(),
+  packetId: int("packetId").notNull(),
+  documentKind: varchar("documentKind", { length: 40 }).notNull(),
+  slot: varchar("slot", { length: 32 }).notNull(),
+  storageKey: varchar("storageKey", { length: 512 }).notNull(),
+  filename: varchar("filename", { length: 255 }).notNull(),
+  mimeType: varchar("mimeType", { length: 128 }).notNull(),
+  sizeBytes: int("sizeBytes").notNull(),
+  uploadedByUserId: int("uploadedByUserId"),
+  createdAt: timestamp("createdAt").defaultNow().notNull(),
+}, (table) => ({
+  packetIdx: index("hiring_packet_files_packet_idx").on(table.packetId, table.documentKind),
+}));
+
+export const hiringPacketSignatures = mysqlTable("hiring_packet_signatures", {
+  id: int("id").autoincrement().primaryKey(),
+  packetId: int("packetId").notNull(),
+  documentId: int("documentId").notNull(),
+  kind: varchar("kind", { length: 40 }).notNull(),
+  signerUserId: int("signerUserId"),
+  signerName: varchar("signerName", { length: 255 }).notNull(),
+  signerEmail: varchar("signerEmail", { length: 320 }),
+  contentSha256: varchar("contentSha256", { length: 64 }).notNull(),
+  provider: varchar("provider", { length: 16 }).default("typed-name").notNull(),
+  providerSubmissionId: varchar("providerSubmissionId", { length: 64 }),
+  signedAt: timestamp("signedAt").defaultNow().notNull(),
+  createdAt: timestamp("createdAt").defaultNow().notNull(),
+}, (table) => ({
+  documentHash: uniqueIndex("hiring_packet_signatures_document_hash_uq").on(table.documentId, table.contentSha256),
+  packetIdx: index("hiring_packet_signatures_packet_idx").on(table.packetId),
+}));
+
+export const hiringSettings = mysqlTable("hiring_settings", {
+  id: int("id").autoincrement().primaryKey(),
+  stateCode: varchar("stateCode", { length: 2 }),
+  handbookTitle: varchar("handbookTitle", { length: 255 }),
+  handbookVersion: varchar("handbookVersion", { length: 64 }),
+  handbookBody: text("handbookBody"),
+  updatedByUserId: int("updatedByUserId"),
+  updatedAt: timestamp("updatedAt").defaultNow().onUpdateNow().notNull(),
+});
