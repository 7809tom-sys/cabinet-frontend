diff --git a/server/routers/hiringPacket.storage.test.ts b/server/routers/hiringPacket.storage.test.ts
new file mode 100644
index 0000000..38920d8
--- /dev/null
+++ b/server/routers/hiringPacket.storage.test.ts
@@ -0,0 +1,14 @@
+import { describe, expect, it } from "vitest";
+import { bucketForKey, PRIVATE_BUCKET } from "../storage";
+import { privateStorageDecision } from "../lib/storageAccess";
+import { hiringObjectKey } from "@shared/hiringPacket";
+
+describe("hiring packet file storage", () => {
+  it("keeps ID uploads in the private bucket and off the public proxy, even for an admin", () => {
+    const key = hiringObjectKey(4, "i9_section1", "list_a", "passport.pdf");
+    expect(bucketForKey(key)).toBe(PRIVATE_BUCKET);
+    const admin = { id: 1, role: "admin", email: "tom@cabinetdealz.com", distributorId: null };
+    expect(privateStorageDecision(key, admin)).toBe("affiliate-document");
+    expect(privateStorageDecision(key, null)).toBe("affiliate-document");
+  });
+});
diff --git a/server/routers/hiringPacket.ts b/server/routers/hiringPacket.ts
new file mode 100644
index 0000000..74b0b01
--- /dev/null
+++ b/server/routers/hiringPacket.ts
@@ -0,0 +1,469 @@
+import { z } from "zod";
+import { and, eq } from "drizzle-orm";
+import { TRPCError } from "@trpc/server";
+import { adminProcedure, protectedProcedure, router } from "../_core/trpc";
+import { getDb } from "../db";
+import { PRIVATE_BUCKET, storageDeleteFromBucket, storageGetSignedUrl, storagePut } from "../storage";
+import {
+  hiringPacketDocuments,
+  hiringPacketFiles,
+  hiringPacketSignatures,
+  hiringPackets,
+  hiringSettings,
+} from "../../drizzle/hiringPacketSchema";
+import {
+  EMPTY_HIRING_SETTINGS,
+  HIRING_DOCUMENT_KINDS,
+  HIRING_SIGNED_URL_SECONDS,
+  acceptIdUpload,
+  canReviewDocument,
+  canSignDocument,
+  canonicalPayload,
+  deriveStatus,
+  documentHasProgress,
+  hiringAccess,
+  hiringObjectKey,
+  isHiringStorageKey,
+  isPublicStorageUrl,
+  mergeSensitiveFields,
+  payloadForActor,
+  formsForWorker,
+  progressForWorker,
+  progressFromStatuses,
+  safeErrorMessage,
+  signatureEvidence,
+  normalizeWorkState,
+  normalizeWorkerType,
+  stateProfile,
+  toPacketSummary,
+  toPublicDocument,
+  type HiringActor,
+  type HiringDocumentKind,
+  type HiringFileRef,
+  type HiringSettings,
+  type PublicFile,
+  type PublicPacket,
+  type WorkStateCode,
+  type WorkerType,
+} from "@shared/hiringPacket";
+
+type Database = NonNullable<Awaited<ReturnType<typeof getDb>>>;
+type SessionUser = { id: number; role: string; email: string | null; name?: string | null };
+type DocumentRow = typeof hiringPacketDocuments.$inferSelect;
+type FileRow = typeof hiringPacketFiles.$inferSelect;
+
+const kindSchema = z.enum(HIRING_DOCUMENT_KINDS as unknown as [HiringDocumentKind, ...HiringDocumentKind[]]);
+const answerSchema = z.union([z.string().max(4000), z.number(), z.boolean(), z.null()]);
+const payloadSchema = z.record(z.string().max(80), answerSchema);
+
+function requireDb(db: Database | null): Database {
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
+  return db;
+}
+
+function actorOf(user: SessionUser): HiringActor {
+  return { userId: user.id, role: user.role, email: user.email };
+}
+
+function parsePayload(raw: string | null): Record<string, unknown> {
+  if (!raw) return {};
+  try {
+    const parsed = JSON.parse(raw) as unknown;
+    return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed as Record<string, unknown> : {};
+  } catch {
+    return {};
+  }
+}
+
+function publicFiles(rows: FileRow[]): PublicFile[] {
+  return rows.map((row) => ({
+    id: row.id,
+    documentKind: row.documentKind as HiringDocumentKind,
+    slot: row.slot,
+    filename: row.filename,
+    mimeType: row.mimeType,
+  }));
+}
+
+function presentPacket(packet: { id: number; userId: number | null; applicantName: string | null; applicantEmail: string; workerType?: string | null; workState?: string | null }, documents: DocumentRow[], files: FileRow[]): PublicPacket {
+  return {
+    id: packet.id,
+    userId: packet.userId,
+    applicantName: packet.applicantName ?? "",
+    applicantEmail: packet.applicantEmail,
+    workerType: normalizeWorkerType(packet.workerType),
+    workState: normalizeWorkState(packet.workState),
+    documents: documents.map((document) => toPublicDocument({
+      kind: document.kind as HiringDocumentKind,
+      payload: parsePayload(document.payloadJson),
+      signedAt: document.signedAt ? new Date(document.signedAt).toISOString() : null,
+      signedByName: document.signedByName,
+      reviewedAt: document.reviewedAt ? new Date(document.reviewedAt).toISOString() : null,
+      reviewedByName: document.reviewedByName,
+      files: publicFiles(files.filter((file) => file.documentKind === document.kind)),
+    })),
+  };
+}
+
+async function loadBundle(db: Database, packetId: number) {
+  const [packet] = await db.select().from(hiringPackets).where(eq(hiringPackets.id, packetId)).limit(1);
+  if (!packet) return null;
+  const documents = await db.select().from(hiringPacketDocuments).where(eq(hiringPacketDocuments.packetId, packetId));
+  const files = await db.select().from(hiringPacketFiles).where(eq(hiringPacketFiles.packetId, packetId));
+  return { packet, documents, files };
+}
+
+function assertView(user: SessionUser, packet: { id: number; userId: number | null; applicantEmail: string }) {
+  const access = hiringAccess(actorOf(user), packet);
+  if (!access.view) {
+    throw new TRPCError({ code: "FORBIDDEN", message: "You can only open your own hiring packet." });
+  }
+  return access;
+}
+
+async function settingsOf(db: Database): Promise<HiringSettings> {
+  const [row] = await db.select().from(hiringSettings).where(eq(hiringSettings.id, 1)).limit(1);
+  if (!row) return EMPTY_HIRING_SETTINGS;
+  return {
+    stateCode: row.stateCode,
+    handbookTitle: row.handbookTitle ?? EMPTY_HIRING_SETTINGS.handbookTitle,
+    handbookVersion: row.handbookVersion ?? "",
+    handbookBody: row.handbookBody ?? "",
+  };
+}
+
+async function documentRow(db: Database, packetId: number, kind: HiringDocumentKind): Promise<DocumentRow> {
+  const [existing] = await db.select().from(hiringPacketDocuments).where(and(eq(hiringPacketDocuments.packetId, packetId), eq(hiringPacketDocuments.kind, kind))).limit(1);
+  if (existing) return existing;
+  const inserted = await db.insert(hiringPacketDocuments).values({ packetId, kind, status: "not_started" });
+  const id = insertedId(inserted);
+  const [created] = await db.select().from(hiringPacketDocuments).where(eq(hiringPacketDocuments.id, id)).limit(1);
+  if (!created) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "The form could not be saved." });
+  return created;
+}
+
+function fileRefs(files: FileRow[], kind: HiringDocumentKind): HiringFileRef[] {
+  return files.filter((file) => file.documentKind === kind).map((file) => ({ documentKind: kind, slot: file.slot }));
+}
+
+function decodeUpload(value: string): Buffer {
+  const cleaned = value.replace(/^data:[^;]+;base64,/, "").replace(/\s/g, "");
+  if (!cleaned) throw new TRPCError({ code: "BAD_REQUEST", message: "The file could not be read." });
+  return Buffer.from(cleaned, "base64");
+}
+
+function insertedId(result: unknown): number {
+  const row = Array.isArray(result) ? result[0] : result;
+  return Number((row as { insertId?: number } | undefined)?.insertId);
+}
+
+function duplicateKey(error: unknown): boolean {
+  const record = error as { errno?: number; code?: string; cause?: { errno?: number; code?: string } };
+  return record.errno === 1062 || record.code === "ER_DUP_ENTRY" || record.cause?.errno === 1062 || record.cause?.code === "ER_DUP_ENTRY";
+}
+
+async function guarded<T>(work: () => Promise<T>): Promise<T> {
+  try {
+    return await work();
+  } catch (error) {
+    if (error instanceof TRPCError) throw error;
+    throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: safeErrorMessage(error) });
+  }
+}
+
+export const hiringPacketRouter = router({
+  settings: router({
+    get: protectedProcedure.query(async () => {
+      const db = requireDb(await getDb());
+      return settingsOf(db);
+    }),
+    set: adminProcedure.input(z.object({
+      stateCode: z.string().trim().max(2).nullable(),
+      handbookTitle: z.string().trim().max(255),
+      handbookVersion: z.string().trim().max(64),
+      handbookBody: z.string().max(60000),
+    })).mutation(async ({ ctx, input }) => guarded(async () => {
+      if (input.stateCode && !stateProfile(input.stateCode)) {
+        throw new TRPCError({ code: "BAD_REQUEST", message: "Choose a state from the list." });
+      }
+      const db = requireDb(await getDb());
+      const stateCode = input.stateCode ? input.stateCode.toUpperCase() : null;
+      const values = {
+        id: 1,
+        stateCode,
+        handbookTitle: input.handbookTitle,
+        handbookVersion: input.handbookVersion,
+        handbookBody: input.handbookBody,
+        updatedByUserId: ctx.user.id,
+      };
+      const [existing] = await db.select({ id: hiringSettings.id }).from(hiringSettings).where(eq(hiringSettings.id, 1)).limit(1);
+      if (existing) {
+        await db.update(hiringSettings).set(values).where(eq(hiringSettings.id, 1));
+      } else {
+        await db.insert(hiringSettings).values(values);
+      }
+      return settingsOf(db);
+    })),
+  }),
+
+  mine: protectedProcedure.query(async ({ ctx }) => guarded(async () => {
+    const db = requireDb(await getDb());
+    const email = (ctx.user.email ?? "").trim().toLowerCase();
+    if (!email) throw new TRPCError({ code: "BAD_REQUEST", message: "Sign in with an email address before opening a hiring packet." });
+    const [byUser] = await db.select().from(hiringPackets).where(eq(hiringPackets.userId, ctx.user.id)).limit(1);
+    let packet = byUser;
+    if (!packet) {
+      const [byEmail] = await db.select().from(hiringPackets).where(eq(hiringPackets.applicantEmail, email)).limit(1);
+      packet = byEmail;
+      if (packet && packet.userId == null) {
+        await db.update(hiringPackets).set({ userId: ctx.user.id }).where(eq(hiringPackets.id, packet.id));
+        packet = { ...packet, userId: ctx.user.id };
+      }
+    }
+    if (!packet) {
+      const inserted = await db.insert(hiringPackets).values({
+        userId: ctx.user.id,
+        applicantEmail: email,
+        applicantName: ctx.user.name?.trim() || email,
+      });
+      const id = insertedId(inserted);
