diff --git a/server/lib/priceFloorSettings.ts b/server/lib/priceFloorSettings.ts
new file mode 100644
index 00000000..25b2434c
--- /dev/null
+++ b/server/lib/priceFloorSettings.ts
@@ -0,0 +1,78 @@
+import { and, desc, eq } from "drizzle-orm";
+import { contractorPriceOverrides, pricingSettingsPriceFloors } from "../../drizzle/schema";
+import { DEFAULT_PRICE_FLOORS, normalizePriceFloors, type PriceFloorSettings } from "../../shared/priceFloors";
+import { getDb } from "../db";
+
+// Tom's price floors (Nov 16, 2026). The columns and the override table come
+// from hand-run SQL (docs/sql/0281_price_floor_enforcement.tidb.sql, same as
+// /workspace/auto-design/fixed-upload.sql). Until it runs, every read here
+// falls back to the 1.15 / 1.38 constants and "no override".
+
+const CACHE_MS = 60_000;
+let cached: { at: number; floors: PriceFloorSettings } | null = null;
+let floorsWarned = false;
+let overridesWarned = false;
+
+/** Subject kind used in contractor_price_overrides for a per-store override. */
+export const STORE_OVERRIDE_SUBJECT = "affiliate";
+
+/** Clear the in-process cache (tests, and right after an admin save). */
+export function resetPriceFloorCache(): void {
+  cached = null;
+}
+
+/** Floors from pricing_settings with safe fallbacks. Never below 1.15 / 1.38 unless the row says a higher-or-equal value. */
+export async function getPriceFloorSettings(): Promise<PriceFloorSettings> {
+  if (cached && Date.now() - cached.at < CACHE_MS) return cached.floors;
+  let floors = DEFAULT_PRICE_FLOORS;
+  try {
+    const db = await getDb();
+    if (db) {
+      const [row] = await db.select({
+        minMarginOverCostBps: pricingSettingsPriceFloors.minMarginOverCostBps,
+        contractorRecommendedBps: pricingSettingsPriceFloors.contractorRecommendedBps,
+      }).from(pricingSettingsPriceFloors).limit(1);
+      floors = normalizePriceFloors(row ?? null);
+    }
+  } catch (error) {
+    if (!floorsWarned) {
+      floorsWarned = true;
+      console.warn(
+        "[Pricing] Price floor columns not readable; using cost × 1.15 / × 1.38",
+        error instanceof Error ? error.message : "unknown error",
+      );
+    }
+  }
+  cached = { at: Date.now(), floors };
+  return floors;
+}
+
+type OverrideDb = NonNullable<Awaited<ReturnType<typeof getDb>>>;
+
+/**
+ * Latest admin override for one store, as a multiplier on Cabinet Dealz cost.
+ * Null = no override (the 1.38 floor). A missing table also reads as null.
+ */
+export async function storeContractorOverrideBps(db: OverrideDb, affiliateId: number | null | undefined): Promise<number | null> {
+  if (affiliateId == null) return null;
+  try {
+    const [row] = await db.select({ newBps: contractorPriceOverrides.newBps })
+      .from(contractorPriceOverrides)
+      .where(and(
+        eq(contractorPriceOverrides.subjectKind, STORE_OVERRIDE_SUBJECT),
+        eq(contractorPriceOverrides.subjectId, affiliateId),
+      ))
+      .orderBy(desc(contractorPriceOverrides.id))
+      .limit(1);
+    return typeof row?.newBps === "number" ? row.newBps : null;
+  } catch (error) {
+    if (!overridesWarned) {
+      overridesWarned = true;
+      console.warn(
+        "[Pricing] contractor_price_overrides not readable; no store overrides apply",
+        error instanceof Error ? error.message : "unknown error",
+      );
+    }
+    return null;
+  }
+}
