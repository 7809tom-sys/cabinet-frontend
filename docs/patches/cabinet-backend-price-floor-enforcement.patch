@@ -0,0 +1,60 @@
+-- TiDB SQL editor version. Numbered 0281. Run after 0280.
+-- Paste ONE numbered statement at a time. Do not paste the whole file.
+-- Every table is cabinet_dealz.<table>. Never touches freight_zones.
+-- PLAIN ADD COLUMN, one schema change per ALTER. Do not use ADD COLUMN IF NOT
+-- EXISTS / DROP COLUMN IF EXISTS: this project's TiDB Cloud editor has rejected
+-- them (see /workspace/auto-design/fixed-upload.sql, Nov 16, 2026).
+-- If an ADD answers "Duplicate column name ...", the column is already there
+-- (for example from fixed-upload.sql). That is safe: skip to the next statement.
+--
+-- NOT RUN. Delivered with cabinet-backend branch feat/price-floor-enforcement
+-- (Tom, voice, Nov 16, 2026 11:54 AM CT). Inserts no rows, changes no prices,
+-- no backfill. Statements 2, 3 and 4 are identical to fixed-upload.sql
+-- statements 2, 3 and 5, so running either file is enough.
+--
+-- The branch works WITHOUT this file: it reads these columns with fallbacks
+-- (cost x 1.15 hard floor, cost x 1.38 contractor floor) and treats a missing
+-- contractor_price_overrides table as "no override". Only the admin "set
+-- override" save needs statement 4 and returns a clear error until it runs.
+--
+-- users.contractorPriceBps (fixed-upload.sql statement 4) is NOT used by this
+-- branch. Harmless if already added.
+
+-- 1. READ-ONLY CHECK. Shows which of these already exist.
+SELECT TABLE_NAME, COLUMN_NAME, COLUMN_TYPE, COLUMN_DEFAULT
+FROM information_schema.COLUMNS
+WHERE TABLE_SCHEMA = 'cabinet_dealz'
+  AND ((TABLE_NAME = 'pricing_settings' AND COLUMN_NAME IN ('contractorRecommendedBps', 'minMarginOverCostBps'))
+       OR TABLE_NAME = 'contractor_price_overrides')
+ORDER BY TABLE_NAME, COLUMN_NAME;
+
+-- 2. Recommended contractor price / contractor floor over Cabinet Dealz cost (13800 = x1.38).
+ALTER TABLE cabinet_dealz.pricing_settings ADD COLUMN contractorRecommendedBps INT NOT NULL DEFAULT 13800;
+
+-- 3. Hard minimum over Cabinet Dealz cost for every sell price (11500 = x1.15).
+ALTER TABLE cabinet_dealz.pricing_settings ADD COLUMN minMarginOverCostBps INT NOT NULL DEFAULT 11500;
+
+-- 4. Admin-only contractor price overrides, append-only history.
+--    Per-store rows use subjectKind = 'affiliate', subjectId = affiliates.id.
+--    newBps is the store's contractor floor on cost (12000 = x1.20, 11500 minimum);
+--    13800 means "override cleared". The latest row per store wins.
+CREATE TABLE IF NOT EXISTS cabinet_dealz.contractor_price_overrides (
+  id BIGINT NOT NULL AUTO_INCREMENT,
+  subjectKind VARCHAR(16) NOT NULL,
+  subjectId BIGINT NOT NULL,
+  oldBps INT NULL,
+  newBps INT NOT NULL,
+  setByUserId BIGINT NOT NULL,
+  setByName VARCHAR(255) NULL,
+  reason VARCHAR(500) NULL,
+  createdAt DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  PRIMARY KEY (id),
+  KEY contractor_price_overrides_subject (subjectKind, subjectId)
+) ENGINE=InnoDB;
+
+-- 5. VERIFY (read-only). Expect 13800 / 11500, and 0 override rows on a first apply.
+SELECT contractorMarkupBps, contractorRecommendedBps, minMarginOverCostBps
+FROM cabinet_dealz.pricing_settings;
+
+SELECT COUNT(*) AS overrideRows
+FROM cabinet_dealz.contractor_price_overrides;
