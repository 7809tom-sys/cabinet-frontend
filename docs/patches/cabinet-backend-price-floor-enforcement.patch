+const SITE: TierMarkupBps = { homeownerMarkupBps: 15800, contractorMarkupBps: 12900, wholesaleMarkupBps: 12500 };
+
+type StoreTier = { basis: "cost_multiplier" | "list_discount"; basisPoints: number } | null;
+
+/** Contractor price for a contractor tied to a store with this markup (store pays cost × 1.05 unless a tier is given). */
+function contractor(row: typeof SCM, markupBps: number, adminOverrideBps: number | null = null, tier: StoreTier = null) {
+  return sellPriceForTier(row, {
+    ...SITE,
+    affiliateContractorCost: { markupBps, tier, platformAffiliateMarkupBps: 500, adminOverrideBps },
+  }, "contractor");
+}
+
+describe("constants and floor math", () => {
+  it("uses cost × 1.15 and cost × 1.38, rounded up to the cent", () => {
+    expect(HARD_FLOOR_MULTIPLIER_BPS).toBe(11500);
+    expect(CONTRACTOR_FLOOR_MULTIPLIER_BPS).toBe(13800);
+    expect(costFloorCents(34799, 11500)).toBe(40019);
+    expect(costFloorCents(34799, 13800)).toBe(48023);
+    expect(costFloorCents(17744, 11500)).toBe(20406);
+    expect(costFloorCents(null, 11500)).toBeNull();
+    expect(costFloorCents(0, 11500)).toBeNull();
+  });
