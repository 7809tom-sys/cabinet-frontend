+/**
+ * A customer's CRM view must list only designs linked to that customer.
+ *
+ * Owner-reported symptom this locks down: opening customer 5192 showed every
+ * saved design on the account, because the drawer read the customer directory
+ * (affiliateCustomers.get), which lists every design owned by the merged person.
+ *
+ * crm.customerDesigns filters server-side on the stored link:
+ * - crm_deal_designs.dealId = the deal being viewed, and
+ * - kitchen_designs.contractorCustomerId = the deal's contractor customer folder.
+ * A design with no link is absent, not guessed.
+ */
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { affiliates, crmDealDesigns, crmDeals, kitchenDesigns } from "../../drizzle/schema";
+import { crmRouter } from "./crm";
+import { memoryStore, type Row } from "../lib/__testDb";
+
+const { getDbMock } = vi.hoisted(() => ({ getDbMock: vi.fn() }));
+
+vi.mock("../db", () => ({ getDb: getDbMock }));
+vi.mock("../lib/affiliateAccess", () => ({ resolveAffiliateAccess: async () => null }));
+vi.mock("../lib/affiliateSiteScope", () => ({ listAccessibleAffiliateIds: async () => [] }));
+vi.mock("../lib/affiliateHostScope", () => ({
+  resolveRequestStoreScope: async () => ({ pinned: false, affiliateId: null }),
+}));
+
+const STORE = { id: 7, slug: "store-a", storeName: "Store A", status: "active", referralCode: "STOREA" };
+
+function deal(id: number, patch: Row = {}): Row {
+  return {
+    id,
+    affiliateId: 7,
+    ownerUserId: 1,
+    contractorCustomerId: null,
+    title: `Deal ${id}`,
+    stage: "new",
+    priority: "medium",
+    contactName: "Riley Buyer",
+    contactEmail: "riley@example.com",
+    contactPhone: null,
+    company: null,
+    language: "en",
+    estimatedValue: null,
+    source: "manual",
+    nextFollowUpAt: null,
+    createdAt: new Date(),
+    updatedAt: new Date(),
+    ...patch,
+  };
+}
+
+function design(id: number, patch: Row = {}): Row {
+  return {
+    id,
+    userId: 900,
+    affiliateId: 7,
+    contractorCustomerId: null,
+    name: `Design ${id}`,
+    thumbnailUrl: null,
+    assistLabel: null,
+    placedCabinets: [],
+    createdAt: new Date(),
+    updatedAt: new Date(),
+    ...patch,
+  };
+}
+
+let tables: Map<unknown, Row[]>;
+
+beforeEach(() => {
+  // Deal 5192 is Tom's customer. It links design 4401 only.
+  // Designs 4402/4403/4404 belong to the same person and store but are linked
+  // to nothing, and 4405 is linked to a different deal in the same store.
+  tables = new Map<unknown, Row[]>([
+    [affiliates, [STORE]],
+    [crmDeals, [deal(5192), deal(6001)]],
+    [crmDealDesigns, [
+      { id: 1, dealId: 5192, designId: 4401, designName: "Design 4401", linkedByUserId: 1, createdAt: new Date() },
+      { id: 2, dealId: 6001, designId: 4405, designName: "Design 4405", linkedByUserId: 1, createdAt: new Date() },
+    ]],
+    [kitchenDesigns, [
+      design(4401), design(4402), design(4403), design(4404), design(4405),
+    ]],
+  ]);
+  getDbMock.mockResolvedValue(memoryStore(tables));
+});
+
+function caller(user: { id: number; role: string } = { id: 1, role: "admin" }) {
+  return crmRouter.createCaller({
+    user: { id: user.id, email: `crm-${user.id}@example.test`, role: user.role },
+    req: { protocol: "https", headers: { host: "www.cabinetdealz.com" } } as never,
+    res: {} as never,
+  } as never);
+}
+
+describe("crm.customerDesigns links only", () => {
+  it("returns only the design linked to the deal, never every design on the account", async () => {
+    const result = await caller().customerDesigns({ dealId: 5192 });
+    expect(result.dealId).toBe(5192);
+    expect(result.designs.map((row) => row.id)).toEqual([4401]);
+    expect(result.designs[0]).toMatchObject({ id: 4401, linkKind: "deal" });
+  });
+
+  it("shows nothing for a customer with no stored link instead of guessing", async () => {
+    tables.set(crmDealDesigns, []);
+    const empty = await caller().customerDesigns({ dealId: 6001 });
+    expect(empty.designs).toEqual([]);
+    expect(empty.schemaReady).toBe(true);
+  });
+
+  it("never lists a design linked to a different customer", async () => {
+    const result = await caller().customerDesigns({ dealId: 5192 });
+    expect(result.designs.map((row) => row.id)).not.toContain(4405);
+  });
+
+  it("adds designs from the deal's contractor customer folder", async () => {
+    tables.set(crmDeals, [deal(5192, { contractorCustomerId: 88 }), deal(6001)]);
+    tables.set(kitchenDesigns, [
+      design(4401),
+      design(5501, { contractorCustomerId: 88 }),
+      design(5502, { contractorCustomerId: 89 }),
+    ]);
+    const result = await caller().customerDesigns({ dealId: 5192 });
+    expect(result.contractorCustomerId).toBe(88);
+    expect(result.designs.map((row) => row.id).sort()).toEqual([4401, 5501]);
+    expect(result.designs.find((row) => row.id === 5501)?.linkKind).toBe("customerFolder");
+    expect(result.designs.map((row) => row.id)).not.toContain(5502);
+  });
+
+  it("drops a linked design that belongs to another store", async () => {
+    tables.set(crmDealDesigns, [
+      { id: 1, dealId: 5192, designId: 4401, designName: "Design 4401", linkedByUserId: 1, createdAt: new Date() },
+      { id: 2, dealId: 5192, designId: 4409, designName: "Design 4409", linkedByUserId: 1, createdAt: new Date() },
+    ]);
+    tables.set(kitchenDesigns, [design(4401), design(4409, { affiliateId: 9 })]);
+    const result = await caller().customerDesigns({ dealId: 5192 });
+    expect(result.designs.map((row) => row.id)).toEqual([4401]);
+  });
+
+  it("returns the store path to open each linked design", async () => {
+    const result = await caller().customerDesigns({ dealId: 5192 });
+    expect(result.designs[0]?.designUrl).toBe("/store/store-a/design?load=4401&preview=3d&crmDeal=5192");
+    expect(result.designs[0]?.linkId).toBe(1);
+  });
+
+  it("refuses another contractor's deal", async () => {
+    await expect(caller({ id: 901, role: "contractor" }).customerDesigns({ dealId: 5192 }))
+      .rejects.toThrow(/Deal not found/);
+  });
+});
