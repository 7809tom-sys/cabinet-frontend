+/**
+ * Where a linked design opens from the CRM. The design's OWN store decides the
+ * route, never the store of the customer record that links to it — the same rule
+ * as shared/designOwnerScope.ts's designOpenPath on the client, and the reason a
+ * platform design linked to a First Class customer still opens on /design.
+ * `crmDeal` keeps the CRM context on the Designer.
+ */
+function customerDesignOpenPath(
+  design: { id: number; affiliateSlug: string | null },
+  dealId: number,
+): string {
+  return designScopePath(design.affiliateSlug ?? null, design.id, dealId);
+}
+
+/**
+ * The contractor customer folder this deal belongs to, when it has one.
+ * kitchen_designs.contractorCustomerId is the second stored design link.
+ */
+function customerFolderDealId(deal: { contractorCustomerId?: number | null }): number | null {
+  const id = deal.contractorCustomerId;
+  return typeof id === "number" && Number.isInteger(id) && id > 0 ? id : null;
+}
+
+export type CustomerLinkedDesign = {
+  id: number;
+  name: string;
+  thumbnailUrl: string | null;
+  assistLabel: string | null;
+  updatedAt: Date | string | null;
+  linkKind: "deal" | "customerFolder";
+  /** crm_deal_designs.id for a deal link; null for a contractor folder link. */
+  linkId: number | null;
+  /**
+   * The store the design itself belongs to (kitchen_designs.affiliateId). The
+   * client builds the Designer link from this with designOpenPath, so a design
+   * never opens under whichever store's CRM happens to be showing it.
+   */
+  affiliateSlug: string | null;
+};
+
+/**
+ * Designs with a stored link to this customer, newest first. Shared by the deal
+ * drawer (customerDesigns) and the staff quick lookup (customerLookup) so the
+ * two can never disagree about what "linked" means.
+ *
+ * A linked design is NOT filtered by the deal's store. Since main's #274 a saved
+ * design belongs to the account that saved it and opens under its own store, so
+ * a platform design linked to a First Class customer is a real link and must
+ * show — under the account's own designer route, not the store's.
+ */
+async function loadCustomerLinkedDesigns(
+  db: NonNullable<Awaited<ReturnType<typeof getDb>>>,
+  deal: { id: number; affiliateId: number | null; contractorCustomerId?: number | null },
+): Promise<CustomerLinkedDesign[]> {
+  const contractorCustomerId = customerFolderDealId(deal);
+  const linkRows = await db
+    .select({ id: crmDealDesigns.id, designId: crmDealDesigns.designId })
+    .from(crmDealDesigns)
+    .where(eq(crmDealDesigns.dealId, deal.id));
+  const linkedIds = Array.from(new Set(linkRows.map((row) => Number(row.designId))));
+  // The contractor customer folder column ships with SQL 0234. If a database
+  // predates it, the deal link alone still answers the customer view.
+  let folderIds: number[] = [];
+  if (contractorCustomerId != null) {
+    try {
+      const folderRows = await db
+        .select({ id: kitchenDesigns.id })
+        .from(kitchenDesigns)
+        .where(eq(kitchenDesigns.contractorCustomerId, contractorCustomerId));
+      folderIds = folderRows.map((row) => Number(row.id));
+    } catch (error) {
+      if (!isMissingSchemaError(error)) throw error;
+    }
+  }
+  const designIds = Array.from(new Set([...linkedIds, ...folderIds]));
+  if (designIds.length === 0) return [];
+  const rows = await db
+    .select({
+      id: kitchenDesigns.id,
+      name: kitchenDesigns.name,
+      thumbnailUrl: kitchenDesigns.thumbnailUrl,
+      assistLabel: kitchenDesigns.assistLabel,
+      contractorCustomerId: kitchenDesigns.contractorCustomerId,
+      affiliateId: kitchenDesigns.affiliateId,
+      updatedAt: kitchenDesigns.updatedAt,
+    })
+    .from(kitchenDesigns)
+    .where(inArray(kitchenDesigns.id, designIds))
+    .orderBy(desc(kitchenDesigns.updatedAt));
+  const designAffiliateIds = Array.from(new Set(
+    rows.map((row) => row.affiliateId).filter((id): id is number => id != null),
+  ));
+  const storeRows = designAffiliateIds.length === 0
+    ? []
+    : await db.select({ id: affiliates.id, slug: affiliates.slug }).from(affiliates).where(inArray(affiliates.id, designAffiliateIds));
+  const slugByAffiliateId = new Map(storeRows.map((store) => [store.id, store.slug]));
+  return selectCustomerDesigns(
+    rows.map((row) => ({
+      designId: row.id,
+      dealIds: linkedIds.includes(row.id) ? [deal.id] : [],
+      contractorCustomerId: row.contractorCustomerId,
+      row,
+    })),
+    { dealId: deal.id, contractorCustomerId },
+  ).map((entry) => ({
+    id: entry.row.id,
+    name: entry.row.name,
+    thumbnailUrl: entry.row.thumbnailUrl,
+    assistLabel: entry.row.assistLabel,
+    updatedAt: entry.row.updatedAt,
+    linkKind: entry.linkKind,
+    // crm_deal_designs.id, so the drawer can unlink without a second query.
+    linkId: entry.linkKind === "deal"
+      ? linkRows.find((link) => Number(link.designId) === entry.row.id && link.id != null)?.id ?? null
+      : null,
+    affiliateSlug: entry.row.affiliateId == null ? null : slugByAffiliateId.get(entry.row.affiliateId) ?? null,
+  }));
+}
+
