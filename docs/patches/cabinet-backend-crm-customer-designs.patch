+      const where = scopeWhere(scope);
+      const rows = await db
+        .select()
+        .from(crmDeals)
+        .where(where ? and(eq(crmDeals.id, identifier.dealId), where) : eq(crmDeals.id, identifier.dealId))
+        .limit(1);
+      const deal = rows[0];
+      if (!deal) {
