diff --git a/server/routers/legalPages.ts b/server/routers/legalPages.ts
new file mode 100644
index 0000000..810c79d
--- /dev/null
+++ b/server/routers/legalPages.ts
@@ -0,0 +1,167 @@
+import { z } from "zod";
+import { TRPCError } from "@trpc/server";
+import { adminProcedure, publicProcedure, router } from "../_core/trpc";
+import { getDb } from "../db";
+import { presentLegalSlot, slugifyLegalSlot, type LegalSheet, type LegalSlot, type LegalVersion } from "@shared/legalPages";
+import {
+  addLegalSlotRow,
+  isMissingSchema,
+  listLegalSlots,
+  parseSheet,
+  publishLegalVersion,
+  rollbackLegalVersion,
+  versionsForSlot,
+} from "../lib/membershipProgramStore";
+
+const sheetSchema = z.object({
+  headers: z.array(z.string()),
+  rows: z.array(z.array(z.string())),
+});
+
+function versionOf(row: Record<string, unknown>): LegalVersion {
+  return {
+    version: Number(row.version),
+    source: (row.source as LegalVersion["source"]) ?? "migration",
+    bodyText: row.bodyText == null ? null : String(row.bodyText),
+    file: row.fileName ? { fileName: String(row.fileName), mimeType: String(row.mimeType ?? "application/octet-stream") } : null,
+    sheet: parseSheet(row.sheetJson),
+    uploadedAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : String(row.createdAt ?? ""),
+    uploadedBy: String(row.uploadedBy ?? ""),
+  };
+}
+
+function slotView(slot: Record<string, unknown>, versions: Record<string, unknown>[]) {
+  const legal: LegalSlot = {
+    slug: String(slot.slug),
+    title: String(slot.title),
+    publicPath: String(slot.publicPath),
+    publishedVersion: Number(slot.publishedVersion),
+    versions: versions.map(versionOf),
+  };
+  const published = legal.versions.find((version) => version.version === legal.publishedVersion);
+  const presentation = presentLegalSlot(legal);
+  const fileDataUrl = published?.source === "file" && typeof versions.find((row) => Number(row.version) === legal.publishedVersion)?.fileBase64 === "string"
+    ? `data:${published.file?.mimeType ?? "application/octet-stream"};base64,${String(versions.find((row) => Number(row.version) === legal.publishedVersion)?.fileBase64)}`
+    : null;
+  return {
+    slug: legal.slug,
+    title: legal.title,
+    publicPath: legal.publicPath,
+    publishedVersion: legal.publishedVersion,
+    versions: legal.versions.map((version) => ({
+      version: version.version,
+      source: version.source,
+      bodyText: version.bodyText,
+      fileName: version.file?.fileName ?? null,
+      uploadedAt: version.uploadedAt,
+      uploadedBy: version.uploadedBy,
+      hasSheet: Boolean(version.sheet),
+    })),
+    presentation: { ...presentation, fileDataUrl },
+  };
+}
+
+export const legalPagesRouter = router({
+  published: publicProcedure.input(z.object({ slug: z.string().min(1).max(64) })).query(async ({ input }) => {
+    const db = await getDb();
+    if (!db) return { render: "site-page" as const, bodyText: null, file: null, sheet: null, version: null, versionLabel: null, schemaMissing: true };
+    try {
+      const slots = await listLegalSlots(db);
+      const slot = slots.find((row) => row.slug === input.slug);
+      if (!slot) return { render: "site-page" as const, bodyText: null, file: null, sheet: null, version: null, versionLabel: null };
+      const versions = await versionsForSlot(db, Number(slot.id));
+      return slotView(slot, versions).presentation;
+    } catch (error) {
+      if (isMissingSchema(error)) {
+        return { render: "site-page" as const, bodyText: null, file: null, sheet: null, version: null, versionLabel: null, schemaMissing: true };
+      }
+      throw error;
+    }
+  }),
+
+  list: adminProcedure.query(async () => {
+    const db = await getDb();
+    if (!db) return { slots: [], schemaMissing: true };
+    try {
+      const slots = await listLegalSlots(db);
+      const views = [];
+      for (const slot of slots) {
+        const versions = await versionsForSlot(db, Number(slot.id));
+        views.push(slotView(slot, versions));
+      }
+      return { slots: views, schemaMissing: false };
+    } catch (error) {
+      if (isMissingSchema(error)) return { slots: [], schemaMissing: true };
+      throw error;
+    }
+  }),
+
+  publish: adminProcedure.input(z.object({
+    slug: z.string().min(1).max(64),
+    bodyText: z.string().max(200000).nullable().optional(),
+    fileName: z.string().max(255).nullable().optional(),
+    mimeType: z.string().max(128).nullable().optional(),
+    fileBase64: z.string().max(6_000_000).nullable().optional(),
+    sheet: sheetSchema.nullable().optional(),
+  })).mutation(async ({ ctx, input }) => {
+    const db = await getDb();
+    if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
+    const text = (input.bodyText ?? "").trim();
+    const sheet = (input.sheet ?? null) as LegalSheet | null;
+    const fileBase64 = input.fileBase64 ?? null;
+    if (!text && !sheet && !fileBase64) {
+      throw new TRPCError({ code: "BAD_REQUEST", message: "Add text, a document, or a spreadsheet before saving." });
+    }
+    const source = input.slug === "warranty" && sheet && !text && !fileBase64 ? "sheet" : fileBase64 && !text ? "file" : sheet && !text ? "sheet" : "text";
+    try {
+      await publishLegalVersion(db, {
+        slug: input.slug,
+        bodyText: text || null,
+        fileName: input.fileName ?? null,
+        mimeType: input.mimeType ?? null,
+        fileBase64,
+        sheet,
+        uploadedBy: ctx.user.name || ctx.user.email || `User ${ctx.user.id}`,
+        source,
+      });
+      return { ok: true };
+    } catch (error) {
+      if (isMissingSchema(error)) {
+        throw new TRPCError({ code: "PRECONDITION_FAILED", message: "Legal page tables are missing. Run docs/sql/0278_affiliate_membership_checkout.tidb.sql." });
+      }
+      throw new TRPCError({ code: "BAD_REQUEST", message: error instanceof Error ? error.message : "Could not publish." });
+    }
+  }),
+
+  rollback: adminProcedure.input(z.object({ slug: z.string(), version: z.number().int().positive() })).mutation(async ({ input }) => {
+    const db = await getDb();
+    if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
+    try {
+      await rollbackLegalVersion(db, input.slug, input.version);
+      return { ok: true };
+    } catch (error) {
+      if (isMissingSchema(error)) {
+        throw new TRPCError({ code: "PRECONDITION_FAILED", message: "Legal page tables are missing. Run docs/sql/0278_affiliate_membership_checkout.tidb.sql." });
+      }
+      throw new TRPCError({ code: "BAD_REQUEST", message: error instanceof Error ? error.message : "Could not roll back." });
+    }
+  }),
+
+  addSlot: adminProcedure.input(z.object({ title: z.string().min(1).max(255), publicPath: z.string().min(2).max(255) })).mutation(async ({ input }) => {
+    const slug = slugifyLegalSlot(input.title);
+    if (!slug || !input.publicPath.startsWith("/")) {
+      throw new TRPCError({ code: "BAD_REQUEST", message: "Enter a name and a public address that starts with /." });
+    }
+    const db = await getDb();
+    if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
+    try {
+      await addLegalSlotRow(db, input.title.trim(), input.publicPath.trim(), slug);
+      return { ok: true, slug };
+    } catch (error) {
+      if (isMissingSchema(error)) {
+        throw new TRPCError({ code: "PRECONDITION_FAILED", message: "Legal page tables are missing. Run docs/sql/0278_affiliate_membership_checkout.tidb.sql." });
+      }
+      throw new TRPCError({ code: "BAD_REQUEST", message: "That page already exists." });
+    }
+  }),
+});
diff --git a/server/routers/salesRepProgram.ts b/server/routers/salesRepProgram.ts
new file mode 100644
index 0000000..2660072
--- /dev/null
+++ b/server/routers/salesRepProgram.ts
@@ -0,0 +1,181 @@
+import { z } from "zod";
+import { TRPCError } from "@trpc/server";
+import { adminProcedure, protectedProcedure, publicProcedure, router } from "../_core/trpc";
+import { getDb } from "../db";
+import { normalizeCommissionSettings } from "@shared/salesRepCommission";
+import {
+  insertApplication,
+  isMissingSchema,
+  listAffiliateSaleCommissions,
+  listApplications,
+  listApprovedReps,
+  loadCommissionSettings,
+  saveCommissionSettings,
+  setApplicationStatus,
+  approvedRepExists,
+} from "../lib/membershipProgramStore";
+
+function missing(error: unknown): never {
+  if (isMissingSchema(error)) {
+    throw new TRPCError({ code: "PRECONDITION_FAILED", message: "Sales rep tables are missing. Run docs/sql/0278_affiliate_membership_checkout.tidb.sql." });
+  }
+  throw error;
+}
+
+export const salesRepProgramRouter = router({
+  approvedReps: publicProcedure.query(async () => {
+    const db = await getDb();
+    if (!db) return [];
+    try {
+      return await listApprovedReps(db);
+    } catch (error) {
+      if (isMissingSchema(error)) return [];
+      throw error;
+    }
+  }),
+
+  apply: publicProcedure.input(z.object({
+    fullName: z.string().min(1).max(256),
+    email: z.string().email().max(320),
+    phone: z.string().max(32).optional(),
+    state: z.string().max(64).optional(),
+    businessName: z.string().max(256).optional(),
+    agreementVersion: z.string().min(1).max(80),
+    agreementAcceptedAt: z.string().min(1),
+  })).mutation(async ({ input }) => {
+    const db = await getDb();
+    if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
+    try {
+      await insertApplication(db, {
+        fullName: input.fullName.trim(),
+        email: input.email.trim(),
+        phone: input.phone?.trim() || null,
+        state: input.state?.trim() || null,
+        businessName: input.businessName?.trim() || null,
+        agreementVersion: input.agreementVersion,
+        agreementAcceptedAt: input.agreementAcceptedAt,
+      });
+      return { ok: true };
+    } catch (error) {
+      missing(error);
+    }
+  }),
+
+  listApplications: adminProcedure.query(async () => {
+    const db = await getDb();
+    if (!db) return { rows: [], schemaMissing: true };
+    try {
+      const rows = await listApplications(db);
+      return {
+        schemaMissing: false,
+        rows: rows.map((row) => ({
+          id: Number(row.id),
+          fullName: String(row.fullName),
+          email: String(row.email),
+          phone: row.phone == null ? null : String(row.phone),
+          state: row.state == null ? null : String(row.state),
+          businessName: row.businessName == null ? null : String(row.businessName),
+          status: String(row.status) as "pending" | "approved" | "rejected",
+          userId: Number(row.id),
+          createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : String(row.createdAt ?? ""),
+        })),
+      };
+    } catch (error) {
+      if (isMissingSchema(error)) return { rows: [], schemaMissing: true };
+      throw error;
+    }
+  }),
+
+  setApplicationStatus: adminProcedure.input(z.object({
+    id: z.number().int().positive(),
+    status: z.enum(["approved", "rejected"]),
+  })).mutation(async ({ input }) => {
+    const db = await getDb();
+    if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
+    try {
+      await setApplicationStatus(db, input.id, input.status);
+      return { ok: true };
+    } catch (error) {
+      missing(error);
+    }
+  }),
+
+  assignRep: adminProcedure.input(z.object({
+    affiliateId: z.number().int().positive(),
+    salesRepUserId: z.number().int().positive().nullable(),
+  })).mutation(async ({ input }) => {
+    const db = await getDb();
+    if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
+    if (input.salesRepUserId != null && !(await approvedRepExists(db, input.salesRepUserId))) {
+      throw new TRPCError({ code: "BAD_REQUEST", message: "That sales rep is not approved." });
+    }
+    try {
+      const { assignRepToAffiliate } = await import("../lib/membershipProgramStore");
+      await assignRepToAffiliate(db, input.affiliateId, input.salesRepUserId);
+      return { ok: true };
+    } catch (error) {
+      missing(error);
+    }
+  }),
+
+  commissionSettings: protectedProcedure.query(async () => {
+    const db = await getDb();
+    if (!db) return { ...normalizeOrDefault(null), schemaMissing: true };
+    try {
+      const loaded = await loadCommissionSettings(db);
+      return { ...loaded.settings, schemaMissing: loaded.schemaMissing };
+    } catch (error) {
+      if (isMissingSchema(error)) return { ...normalizeOrDefault(null), schemaMissing: true };
+      throw error;
+    }
+  }),
+
+  saveCommissionSettings: adminProcedure.input(z.object({
+    flatFeeUsd: z.number().min(0),
+    residualRate: z.number().min(0).max(1),
+    residualBase: z.literal("confirmed_order_gross"),
+    repFeeUsd: z.number().positive().nullable(),
+    repFeeCheckoutEnabled: z.boolean(),
+  })).mutation(async ({ ctx, input }) => {
+    const normalized = normalizeCommissionSettings(input);
+    if (!normalized.ok) throw new TRPCError({ code: "BAD_REQUEST", message: normalized.message });
+    const db = await getDb();
+    if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
+    try {
+      await saveCommissionSettings(db, normalized.settings, ctx.user.id);
+      return normalized.settings;
+    } catch (error) {
+      missing(error);
+    }
+  }),
+
+  listAffiliateSaleCommissions: protectedProcedure.query(async () => {
+    const db = await getDb();
+    if (!db) return [];
+    try {
+      const rows = await listAffiliateSaleCommissions(db);
+      return rows.map((row) => ({
+        id: Number(row.id),
+        repName: String(row.repName ?? ""),
+        repUserId: Number(row.salesRepApplicationId),
+        affiliateName: String(row.affiliateName ?? ""),
+        kind: String(row.kind) as "flat" | "residual",
+        amountCents: Number(row.amountCents),
+        flatFeeCents: Number(row.flatFeeCents),
+        residualRateBps: Number(row.residualRateBps),
+        residualBase: String(row.residualBase),
+        status: String(row.status),
+        earnedAt: row.earnedAt instanceof Date ? row.earnedAt.toISOString() : String(row.earnedAt ?? ""),
+      }));
+    } catch (error) {
+      if (isMissingSchema(error)) return [];
+      throw error;
+    }
+  }),
+});
+
+function normalizeOrDefault(value: null) {
+  const normalized = normalizeCommissionSettings(value);
+  if (!normalized.ok) throw new Error(normalized.message);
+  return normalized.settings;
+}
