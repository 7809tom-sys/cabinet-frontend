+  const snapshot = await loadMembershipSnapshot(db, affiliateId);
+  const requestedCancelAtMs = subscription.cancel_at ? subscription.cancel_at * 1000 : null;
+  const decision = monthlyMinimumStripeGuard({
+    plan: snapshot?.plan ?? metadata.membership_plan,
+    nowMs: Date.now(),
+    commitmentEndsAtMs: snapshot?.committedUntil?.getTime() ?? null,
+    cancelRequested: subscription.cancel_at_period_end || subscription.cancel_at != null,
+    requestedCancelAtMs,
+  });
+  if (decision.action === "allow") return { handled: true, action: "membership_cancel_allowed", affiliateId };
+  const { resolveStripeCredentials } = await import("../stripeConfig");
+  if (resolveStripeCredentials().environment !== "test") {
+    console.error("[Affiliate membership] left an early cancel unchanged because membership billing is test mode only.");
+    return { handled: true, action: "membership_minimum_skipped_outside_test_mode", affiliateId };
+  }
+  const { getStripe } = await import("../stripe");
+  await getStripe().subscriptions.update(subscription.id, {
+    cancel_at_period_end: false,
+    cancel_at: Math.floor(decision.cancelAtMs / 1000),
+  });
+  return { handled: true, action: "membership_minimum_billed_through", affiliateId };
+}
