+import { sql } from "drizzle-orm";
+import { getDb } from "../db";
+import {
+  defaultCommissionSettings,
+  residualLines,
+  snapshotRates,
+  type ConfirmedOrder,
+  type SalesRepCommissionSettings,
+} from "@shared/salesRepCommission";
+import { LEGAL_PAGE_SEED_SLOTS, type LegalSheet } from "@shared/legalPages";
+
+type Database = NonNullable<Awaited<ReturnType<typeof getDb>>>;
+
+export function isMissingSchema(error: unknown): boolean {
+  const message = error instanceof Error ? error.message : String(error);
+  return /doesn't exist|does not exist|unknown table|no such table|ER_NO_SUCH_TABLE/i.test(message);
+}
+
+export function rowsFrom(result: unknown): Record<string, unknown>[] {
+  if (Array.isArray(result)) {
+    const first = result[0];
+    if (Array.isArray(first)) return first as Record<string, unknown>[];
+    if (first && typeof first === "object" && !("affectedRows" in (first as object))) {
+      return result as Record<string, unknown>[];
+    }
+    return [];
+  }
+  if (result && typeof result === "object" && Array.isArray((result as { rows?: unknown }).rows)) {
+    return (result as { rows: Record<string, unknown>[] }).rows;
+  }
+  return [];
+}
+
+async function run(db: Database, query: ReturnType<typeof sql>): Promise<Record<string, unknown>[]> {
+  const result = await (db as unknown as { execute: (query: unknown) => Promise<unknown> }).execute(query);
+  return rowsFrom(result);
+}
+
+function text(value: unknown): string {
+  return value == null ? "" : String(value);
+}
+
+function nullableNumber(value: unknown): number | null {
+  if (value == null || value === "") return null;
+  const parsed = Number(value);
+  return Number.isFinite(parsed) ? parsed : null;
+}
+
+export function settingsFromRow(row: Record<string, unknown> | undefined): SalesRepCommissionSettings {
+  if (!row) return defaultCommissionSettings();
+  const repFeeCents = nullableNumber(row.repFeeCents);
+  return {
+    flatFeeUsd: (nullableNumber(row.flatFeeCents) ?? 40000) / 100,
+    residualRate: (nullableNumber(row.residualRateBps) ?? 50) / 10000,
+    residualBase: "confirmed_order_gross",
+    repFeeUsd: repFeeCents == null ? null : repFeeCents / 100,
+    repFeeCheckoutEnabled: Number(row.repFeeCheckoutEnabled) === 1 && repFeeCents != null && repFeeCents > 0,
+  };
+}
+
+export async function loadCommissionSettings(db: Database): Promise<{ settings: SalesRepCommissionSettings; schemaMissing: boolean }> {
+  try {
+    const rows = await run(db, sql`SELECT flatFeeCents, residualRateBps, residualBase, repFeeCents, repFeeCheckoutEnabled FROM cabinet_dealz.sales_rep_commission_settings WHERE id = 1 LIMIT 1`);
+    return { settings: settingsFromRow(rows[0]), schemaMissing: false };
+  } catch (error) {
+    if (isMissingSchema(error)) return { settings: defaultCommissionSettings(), schemaMissing: true };
+    throw error;
+  }
+}
+
+export async function saveCommissionSettings(db: Database, settings: SalesRepCommissionSettings, userId: number | null): Promise<void> {
+  const snap = snapshotRates(settings, new Date().toISOString());
+  await run(db, sql`
+    INSERT INTO cabinet_dealz.sales_rep_commission_settings (id, flatFeeCents, residualRateBps, residualBase, repFeeCents, repFeeCheckoutEnabled, updatedByUserId)
+    VALUES (1, ${snap.flatFeeCents}, ${snap.residualRateBps}, ${snap.residualBase}, ${settings.repFeeUsd == null ? null : Math.round(settings.repFeeUsd * 100)}, ${settings.repFeeCheckoutEnabled ? 1 : 0}, ${userId})
+    ON DUPLICATE KEY UPDATE flatFeeCents = VALUES(flatFeeCents), residualRateBps = VALUES(residualRateBps), residualBase = VALUES(residualBase), repFeeCents = VALUES(repFeeCents), repFeeCheckoutEnabled = VALUES(repFeeCheckoutEnabled), updatedByUserId = VALUES(updatedByUserId)
+  `);
+}
+
+export async function insertApplication(db: Database, input: {
+  fullName: string;
+  email: string;
+  phone: string | null;
+  state: string | null;
+  businessName: string | null;
+  agreementVersion: string;
+  agreementAcceptedAt: string;
+}): Promise<void> {
+  await run(db, sql`
+    INSERT INTO cabinet_dealz.sales_rep_applications (fullName, email, phone, state, businessName, status, agreementVersion, agreementAcceptedAt)
+    VALUES (${input.fullName}, ${input.email}, ${input.phone}, ${input.state}, ${input.businessName}, 'pending', ${input.agreementVersion}, ${input.agreementAcceptedAt.slice(0, 19).replace("T", " ")})
+  `);
+}
+
+export async function listApplications(db: Database): Promise<Record<string, unknown>[]> {
+  return run(db, sql`SELECT id, fullName, email, phone, state, businessName, status, createdAt FROM cabinet_dealz.sales_rep_applications ORDER BY id DESC`);
+}
+
+export async function setApplicationStatus(db: Database, id: number, status: "approved" | "rejected"): Promise<void> {
+  await run(db, sql`UPDATE cabinet_dealz.sales_rep_applications SET status = ${status} WHERE id = ${id}`);
+}
+
+export async function listApprovedReps(db: Database): Promise<{ userId: number; name: string; email: string | null; state: string | null }[]> {
+  const rows = await run(db, sql`SELECT id, fullName, email, state FROM cabinet_dealz.sales_rep_applications WHERE status = 'approved' ORDER BY fullName`);
+  return rows.map((row) => ({
+    userId: Number(row.id),
+    name: text(row.fullName),
+    email: row.email == null ? null : text(row.email),
+    state: row.state == null ? null : text(row.state),
+  }));
+}
+
+export async function assignRepToAffiliate(db: Database, affiliateId: number, salesRepApplicationId: number | null): Promise<void> {
+  if (salesRepApplicationId == null) {
+    await run(db, sql`DELETE FROM cabinet_dealz.sales_rep_affiliate_assignments WHERE affiliateId = ${affiliateId}`);
+    return;
+  }
+  await run(db, sql`
+    INSERT INTO cabinet_dealz.sales_rep_affiliate_assignments (affiliateId, salesRepApplicationId)
+    VALUES (${affiliateId}, ${salesRepApplicationId})
+    ON DUPLICATE KEY UPDATE salesRepApplicationId = VALUES(salesRepApplicationId)
+  `);
+}
+
+export async function assignedRepId(db: Database, affiliateId: number): Promise<number | null> {
+  const rows = await run(db, sql`SELECT salesRepApplicationId FROM cabinet_dealz.sales_rep_affiliate_assignments WHERE affiliateId = ${affiliateId} LIMIT 1`);
+  const id = rows[0]?.salesRepApplicationId;
+  return id == null ? null : Number(id);
+}
+
+export async function approvedRepExists(db: Database, id: number): Promise<boolean> {
+  const rows = await run(db, sql`SELECT id FROM cabinet_dealz.sales_rep_applications WHERE id = ${id} AND status = 'approved' LIMIT 1`);
+  return rows.length > 0;
+}
+
+export async function saveAcknowledgement(db: Database, input: {
+  affiliateId: number;
+  userId: number;
+  plan: "annual" | "monthly";
+  salesRepApplicationId: number | null;
+  operatorNoticeAcceptedAt: string;
+  agreementVersion: string;
+  agreementAcceptedAt: string;
+  stripeSessionId: string | null;
+}): Promise<void> {
+  await run(db, sql`
+    INSERT INTO cabinet_dealz.affiliate_checkout_acknowledgements
+      (affiliateId, userId, plan, salesRepApplicationId, operatorNoticeAcceptedAt, agreementVersion, agreementAcceptedAt, stripeSessionId)
+    VALUES (
+      ${input.affiliateId},
+      ${input.userId},
+      ${input.plan},
+      ${input.salesRepApplicationId},
+      ${input.operatorNoticeAcceptedAt.slice(0, 19).replace("T", " ")},
+      ${input.agreementVersion},
+      ${input.agreementAcceptedAt.slice(0, 19).replace("T", " ")},
+      ${input.stripeSessionId}
+    )
+  `);
+}
+
+export async function recordFlatCommission(db: Database, input: {
+  affiliateId: number;
+  salesRepApplicationId: number;
+  paymentRef: string;
+  earnedAt: string;
+}): Promise<void> {
+  const { settings } = await loadCommissionSettings(db);
+  const snap = snapshotRates(settings, input.earnedAt);
+  const earned = input.earnedAt.slice(0, 19).replace("T", " ");
+  await run(db, sql`
+    INSERT INTO cabinet_dealz.sales_rep_affiliate_credits
+      (salesRepApplicationId, affiliateId, paymentRef, flatFeeCents, residualRateBps, residualBase, capturedAt)
+    VALUES (${input.salesRepApplicationId}, ${input.affiliateId}, ${input.paymentRef}, ${snap.flatFeeCents}, ${snap.residualRateBps}, ${snap.residualBase}, ${earned})
+    ON DUPLICATE KEY UPDATE affiliateId = affiliateId
+  `);
+  await run(db, sql`
+    INSERT INTO cabinet_dealz.sales_rep_commission_entries
+      (salesRepApplicationId, affiliateId, kind, sourceKey, amountCents, flatFeeCents, residualRateBps, residualBase, status, earnedAt)
+    VALUES (
+      ${input.salesRepApplicationId}, ${input.affiliateId}, 'flat', ${`flat:affiliate:${input.affiliateId}`},
+      ${snap.flatFeeCents}, ${snap.flatFeeCents}, ${snap.residualRateBps}, ${snap.residualBase}, 'pending', ${earned}
+    )
+    ON DUPLICATE KEY UPDATE sourceKey = sourceKey
+  `);
+}
+
+export async function listAffiliateSaleCommissions(db: Database): Promise<Record<string, unknown>[]> {
+  const credits = await run(db, sql`
+    SELECT c.salesRepApplicationId, c.affiliateId, c.flatFeeCents, c.residualRateBps, c.residualBase, c.capturedAt,
+           a.fullName AS repName, af.storeName AS affiliateName
+    FROM cabinet_dealz.sales_rep_affiliate_credits c
+    JOIN cabinet_dealz.sales_rep_applications a ON a.id = c.salesRepApplicationId
+    JOIN cabinet_dealz.affiliates af ON af.id = c.affiliateId
+  `);
+  const entries = await run(db, sql`
+    SELECT e.id, e.salesRepApplicationId, e.affiliateId, e.kind, e.amountCents, e.flatFeeCents, e.residualRateBps, e.residualBase, e.status, e.earnedAt,
+           a.fullName AS repName, af.storeName AS affiliateName
+    FROM cabinet_dealz.sales_rep_commission_entries e
+    JOIN cabinet_dealz.sales_rep_applications a ON a.id = e.salesRepApplicationId
+    JOIN cabinet_dealz.affiliates af ON af.id = e.affiliateId
+    WHERE e.kind = 'flat'
+    ORDER BY e.id DESC
+  `);
+  const residualRows: Record<string, unknown>[] = [];
+  for (const credit of credits) {
+    const affiliateId = Number(credit.affiliateId);
+    const orders = await run(db, sql`SELECT id, totalAmount, status FROM cabinet_dealz.order_requests WHERE affiliateId = ${affiliateId} AND status = 'confirmed'`);
+    const confirmed: ConfirmedOrder[] = orders.map((order) => ({
+      id: Number(order.id),
+      totalAmount: order.totalAmount == null ? null : Number(order.totalAmount),
+      status: text(order.status),
+    }));
+    const lines = residualLines(confirmed, {
+      flatFeeCents: Number(credit.flatFeeCents),
+      residualRateBps: Number(credit.residualRateBps),
+      residualBase: "confirmed_order_gross",
+      capturedAt: text(credit.capturedAt),
+    });
+    lines.forEach((line, index) => {
+      residualRows.push({
+        id: Number(`${affiliateId}${index + 1}`),
+        salesRepApplicationId: Number(credit.salesRepApplicationId),
+        affiliateId,
+        kind: "residual",
+        amountCents: line.amountCents,
+        flatFeeCents: Number(credit.flatFeeCents),
+        residualRateBps: line.residualRateBps,
+        residualBase: line.residualBase,
+        status: "pending",
+        earnedAt: text(credit.capturedAt),
+        repName: text(credit.repName),
+        affiliateName: text(credit.affiliateName),
+      });
+    });
+  }
+  return [...entries, ...residualRows];
+}
+
+function parseSheet(value: unknown): LegalSheet | null {
+  if (typeof value !== "string" || !value.trim()) return null;
+  try {
+    const parsed = JSON.parse(value) as LegalSheet;
+    if (!parsed || !Array.isArray(parsed.headers) || !Array.isArray(parsed.rows)) return null;
+    return parsed;
+  } catch {
+    return null;
+  }
+}
+
+export async function listLegalSlots(db: Database): Promise<Record<string, unknown>[]> {
+  const slots = await run(db, sql`SELECT id, slug, title, publicPath, publishedVersion FROM cabinet_dealz.legal_page_slots ORDER BY id`);
+  if (slots.length === 0) {
+    for (const seed of LEGAL_PAGE_SEED_SLOTS) {
+      await run(db, sql`INSERT INTO cabinet_dealz.legal_page_slots (slug, title, publicPath, publishedVersion) VALUES (${seed.slug}, ${seed.title}, ${seed.publicPath}, 1)`);
+      const inserted = await run(db, sql`SELECT id FROM cabinet_dealz.legal_page_slots WHERE slug = ${seed.slug} LIMIT 1`);
+      const slotId = Number(inserted[0]?.id);
+      if (slotId) {
+        await run(db, sql`INSERT INTO cabinet_dealz.legal_page_versions (slotId, version, source, bodyText, uploadedBy) VALUES (${slotId}, 1, 'migration', NULL, 'Site page')`);
+      }
+    }
+    return run(db, sql`SELECT id, slug, title, publicPath, publishedVersion FROM cabinet_dealz.legal_page_slots ORDER BY id`);
+  }
+  return slots;
+}
+
+export async function versionsForSlot(db: Database, slotId: number): Promise<Record<string, unknown>[]> {
+  return run(db, sql`SELECT version, source, bodyText, fileName, mimeType, fileBase64, sheetJson, uploadedBy, createdAt FROM cabinet_dealz.legal_page_versions WHERE slotId = ${slotId} ORDER BY version`);
+}
+
+export async function publishLegalVersion(db: Database, input: {
+  slug: string;
+  bodyText: string | null;
+  fileName: string | null;
+  mimeType: string | null;
+  fileBase64: string | null;
+  sheet: LegalSheet | null;
+  uploadedBy: string;
+  source: "text" | "file" | "sheet";
+}): Promise<void> {
+  const slots = await run(db, sql`SELECT id, publishedVersion FROM cabinet_dealz.legal_page_slots WHERE slug = ${input.slug} LIMIT 1`);
+  const slot = slots[0];
+  if (!slot) throw new Error("That legal page does not exist.");
+  const slotId = Number(slot.id);
+  const current = await run(db, sql`SELECT bodyText, fileName, mimeType, fileBase64, sheetJson FROM cabinet_dealz.legal_page_versions WHERE slotId = ${slotId} AND version = ${Number(slot.publishedVersion)} LIMIT 1`);
+  const previous = current[0];
+  const keepSheet = input.sheet ? JSON.stringify(input.sheet) : (previous ? text(previous.sheetJson) || null : null);
+  const body = input.source === "sheet" ? (previous?.bodyText == null ? null : text(previous.bodyText) || null) : input.bodyText;
+  const nextVersion = Number(slot.publishedVersion) + 1;
+  await run(db, sql`
+    INSERT INTO cabinet_dealz.legal_page_versions (slotId, version, source, bodyText, fileName, mimeType, fileBase64, sheetJson, uploadedBy)
+    VALUES (
+      ${slotId}, ${nextVersion}, ${input.source}, ${body},
+      ${input.fileName ?? (previous ? text(previous.fileName) || null : null)},
+      ${input.mimeType ?? (previous ? text(previous.mimeType) || null : null)},
+      ${input.fileBase64 ?? (input.source === "sheet" && previous ? text(previous.fileBase64) || null : null)},
+      ${keepSheet}, ${input.uploadedBy}
+    )
+  `);
+  await run(db, sql`UPDATE cabinet_dealz.legal_page_slots SET publishedVersion = ${nextVersion} WHERE id = ${slotId}`);
+}
+
+export async function rollbackLegalVersion(db: Database, slug: string, version: number): Promise<void> {
+  const slots = await run(db, sql`SELECT id FROM cabinet_dealz.legal_page_slots WHERE slug = ${slug} LIMIT 1`);
+  const slotId = Number(slots[0]?.id);
+  if (!slotId) throw new Error("That legal page does not exist.");
+  const found = await run(db, sql`SELECT version FROM cabinet_dealz.legal_page_versions WHERE slotId = ${slotId} AND version = ${version} LIMIT 1`);
+  if (!found[0]) throw new Error("That version is not in the history.");
+  await run(db, sql`UPDATE cabinet_dealz.legal_page_slots SET publishedVersion = ${version} WHERE id = ${slotId}`);
+}
+
+export async function addLegalSlotRow(db: Database, title: string, publicPath: string, slug: string): Promise<void> {
+  await run(db, sql`INSERT INTO cabinet_dealz.legal_page_slots (slug, title, publicPath, publishedVersion) VALUES (${slug}, ${title}, ${publicPath}, 1)`);
+  const rows = await run(db, sql`SELECT id FROM cabinet_dealz.legal_page_slots WHERE slug = ${slug} LIMIT 1`);
+  await run(db, sql`INSERT INTO cabinet_dealz.legal_page_versions (slotId, version, source, uploadedBy) VALUES (${Number(rows[0]?.id)}, 1, 'migration', 'Admin')`);
+}
+
+export { parseSheet };
