+async function handleSubscriptionUpdated(subscription: Stripe.Subscription): Promise<MembershipWebhookOutcome> {
+  const db = await getDb();
+  if (!db) throw new Error("Database not available");
+  const metadata = metadataOf(subscription.metadata);
+  const affiliateId =
+    positiveInt(metadata.affiliate_id) ?? (await findAffiliateIdBySubscriptionId(db, subscription.id));
