+/**
+ * The one Pelican price a viewer may see.
+ *
+ * On an affiliate storefront the customer price is the affiliate's marked-up
+ * retail, exactly as `pelican.byCategory` and the cart compute it. The platform
+ * price above is the owner/store price and must never be shown there. Measured
+ * on 6 Nov 2026 for reaves-way-cabinet-shop: PL-3099 White basin $46.44 in the
+ * Designer vs $112.47 on that storefront, Aviles 20mil planks $95.70 vs $148.34,
+ * Bahia 12mil vinyl $74.25 vs $115.09.
+ */
+export function surfaceSellPriceOf(
+  p: { listPrice: string | null; yourCost: string | null; category: string },
+  map: MarkupMap,
+  affiliatePricing: AffiliateStorefrontPricing | null,
+): number | null {
+  const platform = sellPriceOf(p, map);
+  if (platform == null) return null;
+  if (!affiliatePricing) return platform;
+  const costCents = dollarsToCents(p.yourCost);
+  if (costCents == null || costCents <= 0) return platform;
+  return affiliateStorefrontSale(affiliatePricing, costCents, {
+    categoryKey: p.category,
+    listPriceCents: dollarsToCents(p.listPrice),
+    referenceRetailCents: Math.round(platform * 100),
+  }).retailCents / 100;
+}
