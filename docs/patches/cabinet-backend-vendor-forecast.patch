diff --git a/server/salesForecast/rates.ts b/server/salesForecast/rates.ts
new file mode 100644
index 0000000..29aa32a
--- /dev/null
+++ b/server/salesForecast/rates.ts
@@ -0,0 +1,60 @@
+import { eq } from "drizzle-orm";
+import { vendorForecastRates } from "../../drizzle/schema";
+import { validateVendorForecastPercent, type VendorForecastRateInput } from "../../shared/salesForecast";
+import { getDb } from "../db";
+
+type Database = NonNullable<Awaited<ReturnType<typeof getDb>>>;
+
+export type StoredVendorForecastRate = {
+  vendorScope: string;
+  closePercent: string | null;
+  setByUserId: number | null;
+  setByName: string | null;
+  setAt: Date | null;
+};
+
+export async function loadVendorForecastRates(db: Database): Promise<StoredVendorForecastRate[]> {
+  try {
+    return await db.select({
+      vendorScope: vendorForecastRates.vendorScope,
+      closePercent: vendorForecastRates.closePercent,
+      setByUserId: vendorForecastRates.setByUserId,
+      setByName: vendorForecastRates.setByName,
+      setAt: vendorForecastRates.setAt,
+    }).from(vendorForecastRates);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    if (/vendor_forecast_rates|doesn't exist|does not exist|unknown table/i.test(message)) return [];
+    throw error;
+  }
+}
+
+export function ratesForForecast(rows: readonly StoredVendorForecastRate[]): VendorForecastRateInput[] {
+  return rows.map((row) => {
+    const percent = row.closePercent == null || row.closePercent === "" ? null : Number(row.closePercent);
+    return {
+      scope: row.vendorScope,
+      percent: percent != null && Number.isFinite(percent) ? percent : null,
+    };
+  });
+}
+
+export async function saveVendorForecastRate(
+  db: Database,
+  input: { scope: string; percent: number | null; userId: number | null; userName: string | null },
+) {
+  const problem = validateVendorForecastPercent(input.percent);
+  if (problem) throw new Error(problem);
+  const values = {
+    closePercent: input.percent == null ? null : input.percent.toFixed(2),
+    setByUserId: input.userId,
+    setByName: input.userName,
+    setAt: new Date(),
+  };
+  const existing = await db.select({ id: vendorForecastRates.id }).from(vendorForecastRates).where(eq(vendorForecastRates.vendorScope, input.scope)).limit(1);
+  if (existing[0]) {
+    await db.update(vendorForecastRates).set(values).where(eq(vendorForecastRates.id, existing[0].id));
+    return;
+  }
+  await db.insert(vendorForecastRates).values({ vendorScope: input.scope, ...values });
+}
