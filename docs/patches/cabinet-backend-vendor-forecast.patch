+// Product editor opened from Sales Forecast. Admin, designer, and sales_rep may
+// name any vendor. A distributor stays limited to their own line. isAdmin on
+// this context means "may pass a distributor id", not the rest of admin.
+export const catalogEditorProcedure = t.procedure.use(
+  t.middleware(async opts => {
+    const { ctx, next } = opts;
+    if (!ctx.user) {
+      throw new TRPCError({ code: "UNAUTHORIZED", message: UNAUTHED_ERR_MSG });
+    }
+    const isDistributor = ctx.user.role === "distributor";
+    const isCompany = isCompanySalesForecastRole(ctx.user.role);
+    if (!isDistributor && !isCompany) {
+      throw new TRPCError({ code: "FORBIDDEN", message: "Catalog editor access required" });
+    }
+    if (isDistributor && ctx.user.distributorId == null && ctx.user.approvedVendorLineId == null) {
+      throw new TRPCError({
+        code: "FORBIDDEN",
+        message: "Your account is not linked to an approved vendor record yet. Contact the platform admin.",
+      });
+    }
+    const linkedDistributorIds = isDistributor ? await loadLinkedCatalogLineIds(ctx.user) : [];
+    return next({
+      ctx: {
+        ...ctx,
+        user: ctx.user,
+        isAdmin: isCompany,
+        distributorId: isDistributor ? ctx.user.distributorId : null,
+        approvedVendorLineId: isDistributor ? ctx.user.approvedVendorLineId : null,
+        linkedDistributorIds,
+      },
+    });
+  }),
+);
