+import { describe, expect, it } from "vitest";
+import { pelicanCatalogAccess } from "./pelicanCatalogAccess";
+
+describe("pelican catalog ownership", () => {
+  it("allows the Pelican vendor and admin, and denies another vendor", () => {
+    expect(pelicanCatalogAccess({ role: "distributor", isApproved: true, approvedSourceKey: "pelican" })).toBe("allow");
+    expect(pelicanCatalogAccess({ role: "admin" })).toBe("allow");
+    expect(pelicanCatalogAccess({ role: "designer" })).toBe("allow");
+    expect(pelicanCatalogAccess({ role: "sales_rep" })).toBe("allow");
+    expect(pelicanCatalogAccess({ role: "distributor", isApproved: true, approvedSourceKey: "skyline" })).toBe("deny");
+    expect(pelicanCatalogAccess({ role: "distributor", isApproved: false, approvedSourceKey: "pelican", distributorActive: true, distributorCode: "SKY" })).toBe("deny");
+    expect(pelicanCatalogAccess({ role: "partner" })).toBe("deny");
+    expect(pelicanCatalogAccess({ role: "user" })).toBe("deny");
+    expect(pelicanCatalogAccess({ role: "contractor" })).toBe("deny");
+  });
+});
diff --git a/server/lib/pelicanCatalogAccess.ts b/server/lib/pelicanCatalogAccess.ts
new file mode 100644
index 0000000..4157521
--- /dev/null
+++ b/server/lib/pelicanCatalogAccess.ts
@@ -0,0 +1,19 @@
+/**
+ * Pelican catalog identity. Admin, designer, and sales_rep may open any Pelican
+ * product from the company Sales Forecast. A vendor may open Pelican products
+ * only when their approved vendor record is the Pelican line (or the legacy PEL
+ * supply line). Every other role and vendor is denied.
+ */
+export function pelicanCatalogAccess(input: {
+  role: string;
+  approvedSourceKey?: string | null;
+  isApproved?: boolean;
+  distributorCode?: string | null;
+  distributorActive?: boolean;
+}): "allow" | "deny" {
+  if (input.role === "admin" || input.role === "designer" || input.role === "sales_rep") return "allow";
+  if (input.role !== "distributor") return "deny";
+  if (input.isApproved && input.approvedSourceKey?.trim().toLowerCase() === "pelican") return "allow";
+  if (input.distributorActive && input.distributorCode === "PEL") return "allow";
+  return "deny";
+}
