+-- TiDB SQL editor version of the vendor-entered sales forecast percentage.
+-- Paste each numbered block on its own.
+-- One statement per block. Do not paste drizzle breakpoint markers into these blocks.
+-- Safe to re-run: IF NOT EXISTS, tables qualified as cabinet_dealz.<table>.
+-- The owner runs this SQL. The application does not apply it.
+
+-- 1
+CREATE TABLE IF NOT EXISTS cabinet_dealz.vendor_forecast_rates (
+  id INT NOT NULL AUTO_INCREMENT,
+  vendorScope VARCHAR(32) NOT NULL,
+  closePercent DECIMAL(5, 2) NULL,
+  setByUserId INT NULL,
+  setByName VARCHAR(255) NULL,
+  setAt TIMESTAMP NULL,
+  PRIMARY KEY (id),
+  UNIQUE KEY vendor_forecast_rates_scope_uq (vendorScope)
+);
