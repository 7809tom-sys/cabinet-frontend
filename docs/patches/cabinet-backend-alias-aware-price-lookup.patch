+    expect(chain.encounteredCycle).toBe(true);
+    expect(resolveCanonicalCatalogSources(
+      [{ sourceMasterCode: "A" }],
+      [
+        { aliasCode: "A", masterCode: "B" },
+        { aliasCode: "B", masterCode: "C" },
+        { aliasCode: "C", masterCode: "A" },
