+++ b/server/lib/cabinetPriceResolver.ts
@@ -0,0 +1,709 @@
+/**
+ * Alias-aware cabinet price and sellable-source resolution.
+ *
+ * Owner rule: when looking up a cabinet's price, check the main SKU code and
+ * any alias codes. If a price exists under either code, that price is the
+ * truth. Resolve a SKU to its main code and every alias code, look up supplier
+ * prices across all of those cabinet rows, and return the price from whichever
+ * code has it. One module owns that rule so a future alias inherits it with
+ * no new call-site work.
+ *
+ * Alias rows stay as they are. This module never splits an alias into its own
+ * sellable code and never deletes or rewrites alias data.
+ *
+ * Which row wins when more than one code is priced:
+ *   the master cabinet's own row for that door style and distributor. An alias
+ *   row is used only when the master has no priced, published, available row
+ *   for that same style and distributor. A different style, or the same style
+ *   on a different distributor, is kept beside the master's row.
+ *
+ * Visibility (isActive, showInCatalog, showInDesigner, designerEligible) is
+ * read from the master. When the master has a flag off, any group member that
+ * has that flag on supplies it. The shopper still sees the master code.
+ * LWR3015 is the Cabinet Config record with Active and Show in Designer on
+ * while WRC3015 may have those flags off; the group still shows.
+ *
+ * A blank subcategory does not hide a cabinet. Category "Standard Wall" with
+ * no subcategory is a wall cabinet. When the master has no category and no
+ * placement, the alias member's category is used for the Designer wall list.
+ *
+ * Self-aliases (WRC3015 → WRC3015) are no-ops. They keep lookup history and
+ * are not hops and not cycles. A loop across two different codes stays
+ * quarantined: those codes do not share a price group, and catalog projection
+ * drops the source.
+ *
+ * Groups are directed `sku_master_aliases` rows with conflictStatus 'ok', plus
+ * `cabinet_aliases` routes (alias text → that cabinet's master code). This is
+ * not the undirected cabinet_code_equivalences graph and it does not read
+ * altSku cells.
+ *
+ * List endpoints must not call the loader once per cabinet. They use the SQL
+ * predicates below (`hasPositivePublishedCabinetPriceSql`,
+ * `isCanonicalCabinetMasterSql`, `cabinetOrAliasGroupHasFlag`) so one
+ * statement filters the page. `loadCabinetGroupIndex` is the batched read for
+ * a single cabinet or a caller that already needs every group.
+ */
+import { and, eq, inArray, ne, sql, type SQL } from "drizzle-orm";
+import { cabinetAliases, cabinets, distributorSkus, skuMasterAliases } from "../../drizzle/schema";
+
+/**
+ * Drizzle handle from getDb(). Structural and loose so this module does not
+ * import server/db.ts (db.ts imports the SQL helpers below).
+ */
+type Db = {
+  select: (...args: any[]) => any;
+};
+
+function listOf<T>(values: { forEach: (fn: (value: T) => void) => void }): T[] {
+  const out: T[] = [];
+  values.forEach((value) => out.push(value));
+  return out;
+}
+
+export type CabinetVisibilityFlag = "isActive" | "showInCatalog" | "showInDesigner" | "designerEligible";
+
+export type CabinetCodeGroup = {
+  masterCode: string;
+  masterCabinetId: number | null;
+  /** Other codes in the group. The master code and self-aliases are omitted. */
+  aliasCodes: string[];
+  /** Master cabinet id plus every alias cabinet id. */
+  cabinetIds: number[];
+};
+
+export type AliasLink = {
+  aliasCode: string | null;
+  masterCode: string | null;
+  conflictStatus?: string | null;
+};
+
+export type CabinetRef = {
+  id: number;
+  masterCode: string | null;
+};
+
+export type CabinetRouteAlias = {
+  alias: string | null;
+  cabinetId: number;
+};
+
+export type CabinetPriceSourceRow = {
+  cabinetId: number | null;
+  styleId?: number | null;
+  distributorId?: number | null;
+  listPrice?: string | number | null;
+  yourCost?: string | number | null;
+  isAvailable?: boolean | null;
+  isPublished?: boolean | null;
+};
+
+export type CabinetVisibility = {
+  isActive: boolean;
+  showInCatalog: boolean;
+  showInDesigner: boolean;
+  designerEligible: boolean;
+};
+
+export type CabinetGroupIndex = {
+  byCode: Map<string, CabinetCodeGroup>;
+  byCabinetId: Map<number, CabinetCodeGroup>;
+  cabinetsById: Map<number, CabinetRef>;
+  cabinetsByCode: Map<string, CabinetRef>;
+};
+
+const EMPTY_GROUP: CabinetCodeGroup = {
+  masterCode: "",
+  masterCabinetId: null,
+  aliasCodes: [],
+  cabinetIds: [],
+};
+
+export function codeKey(code: string | null | undefined): string {
+  return code?.trim().toUpperCase() ?? "";
+}
+
+/** Punctuation-only variants (B12 and B-12) share one identity key. */
+export function normalizedIdentityKey(code: string): string {
+  return codeKey(code).replace(/[\s_-]/g, "");
+}
+
+export function isSelfAlias(aliasCode: string | null | undefined, masterCode: string | null | undefined): boolean {
+  const alias = codeKey(aliasCode);
+  const master = codeKey(masterCode);
+  return Boolean(alias) && alias === master;
+}
+
+/**
+ * Walk alias → master. A code that points at itself stops the walk and is not
+ * a cycle. A loop of different codes is a cycle. A loop whose codes differ
+ * only by hyphen, space, or underscore is one nomenclature identity, matching
+ * the historical B12 ↔ B-12 rule, and is not quarantined.
+ */
+export function followApprovedAliasChain(
+  sourceKey: string,
+  aliasToMaster: ReadonlyMap<string, string>,
+): { canonicalKey: string; encounteredCycle: boolean } {
+  let canonicalKey = sourceKey;
+  const visited = new Set<string>();
+  while (true) {
+    visited.add(canonicalKey);
+    const next = aliasToMaster.get(canonicalKey);
+    if (!next || next === canonicalKey) {
+      return { canonicalKey, encounteredCycle: false };
+    }
+    if (visited.has(next)) {
+      const sourceIdentity = normalizedIdentityKey(sourceKey);
+      const punctuationOnly = listOf(visited).every(
+        (code) => normalizedIdentityKey(code) === sourceIdentity,
+      );
+      return {
+        canonicalKey: punctuationOnly ? sourceKey : canonicalKey,
+        encounteredCycle: !punctuationOnly,
+      };
+    }
+    canonicalKey = next;
+  }
+}
+
+function rememberSpelling(spellings: Map<string, string>, code: string | null | undefined): string {
+  const key = codeKey(code);
+  if (!key) return "";
+  if (!spellings.has(key)) spellings.set(key, code!.trim());
+  return key;
+}
+
+function singletonGroup(masterCode: string, masterCabinetId: number | null): CabinetCodeGroup {
+  return {
+    masterCode,
+    masterCabinetId,
+    aliasCodes: [],
+    cabinetIds: masterCabinetId == null ? [] : [masterCabinetId],
+  };
+}
+
+/**
+ * Build every directed alias group from already loaded rows. Safe to call for
+ * a whole alias table at once (list callers that need groups in memory).
+ * Cyclic codes stay in their own group so a true loop cannot share a price.
+ */
+export function buildCabinetGroupIndex(
+  links: readonly AliasLink[],
+  cabinetRows: readonly CabinetRef[],
+  routeLinks: readonly CabinetRouteAlias[] = [],
+): CabinetGroupIndex {
+  const spellings = new Map<string, string>();
+  const cabinetsById = new Map<number, CabinetRef>();
+  const cabinetsByCode = new Map<string, CabinetRef>();
+  for (const cabinet of cabinetRows) {
+    cabinetsById.set(cabinet.id, cabinet);
+    const key = rememberSpelling(spellings, cabinet.masterCode);
+    if (key && !cabinetsByCode.has(key)) cabinetsByCode.set(key, cabinet);
+  }
+
+  const parent = new Map<string, string>();
+  const addEdge = (aliasCode: string | null | undefined, masterCode: string | null | undefined) => {
+    const from = rememberSpelling(spellings, aliasCode);
+    const to = rememberSpelling(spellings, masterCode);
+    if (!from || !to || from === to) return;
+    if (!parent.has(from)) parent.set(from, to);
+  };
+  for (const link of links) {
+    if (link.conflictStatus != null && link.conflictStatus !== "ok") continue;
+    addEdge(link.aliasCode, link.masterCode);
+  }
+  for (const route of routeLinks) {
+    const target = cabinetsById.get(route.cabinetId);
+    addEdge(route.alias, target?.masterCode ?? null);
+  }
+
+  const rootOf = (code: string): { root: string; cyclic: boolean } => {
+    const seen = new Set<string>();
+    let cursor = code;
+    while (parent.has(cursor)) {
+      if (seen.has(cursor)) return { root: cursor, cyclic: true };
+      seen.add(cursor);
+      cursor = parent.get(cursor)!;
+      if (seen.size > 12) return { root: cursor, cyclic: true };
+    }
+    return { root: cursor, cyclic: false };
+  };
+
+  const membersByRoot = new Map<string, Set<string>>();
+  const cyclic = new Set<string>();
+  const codes = new Set<string>();
+  parent.forEach((to, from) => {
+    codes.add(from);
+    codes.add(to);
+  });
+  codes.forEach((code) => {
+    const { root, cyclic: loop } = rootOf(code);
+    if (loop) {
+      cyclic.add(code);
+      return;
+    }
+    const bucket = membersByRoot.get(root) ?? new Set<string>();
+    bucket.add(code);
+    bucket.add(root);
+    membersByRoot.set(root, bucket);
+  });
+
+  const byCode = new Map<string, CabinetCodeGroup>();
+  const byCabinetId = new Map<number, CabinetCodeGroup>();
+  const publish = (group: CabinetCodeGroup, keys: readonly string[]) => {
+    for (const key of keys) byCode.set(key, group);
+    for (const id of group.cabinetIds) byCabinetId.set(id, group);
+  };
+
+  membersByRoot.forEach((members, root) => {
+    const masterCabinet = chooseMasterCabinet(root, members, cabinetRows, routeLinks);
+    const aliasCodes = listOf(members).filter((key) => key !== root).map((key) => spellings.get(key) ?? key);
+    aliasCodes.sort((a, b) => a.localeCompare(b));
+    const group: CabinetCodeGroup = {
+      masterCode: spellings.get(root) ?? root,
+      masterCabinetId: masterCabinet?.id ?? null,
+      aliasCodes,
+      cabinetIds: cabinetIdsFor(members, cabinetRows, masterCabinet?.id ?? null),
+    };
+    publish(group, listOf(members));
+  });
+  cyclic.forEach((code) => {
+    const cabinet = cabinetsByCode.get(code) ?? null;
+    publish(singletonGroup(spellings.get(code) ?? code, cabinet?.id ?? null), [code]);
+  });
+
+  return { byCode, byCabinetId, cabinetsById, cabinetsByCode };
+}
+
+function chooseMasterCabinet(
+  root: string,
+  members: Set<string>,
+  cabinetRows: readonly CabinetRef[],
+  routeLinks: readonly CabinetRouteAlias[],
+): CabinetRef | null {
+  const matches = cabinetRows.filter((cabinet) => codeKey(cabinet.masterCode) === root);
+  const routed = routeLinks.find(
+    (route) => members.has(codeKey(route.alias)) && matches.some((cabinet) => cabinet.id === route.cabinetId),
+  );
+  if (routed) return matches.find((cabinet) => cabinet.id === routed.cabinetId) ?? null;
+  if (matches.length === 0) return null;
+  return matches.reduce((best, cabinet) => (cabinet.id < best.id ? cabinet : best));
+}
+
+function cabinetIdsFor(members: Set<string>, cabinetRows: readonly CabinetRef[], masterCabinetId: number | null): number[] {
+  const ids = new Set<number>();
+  if (masterCabinetId != null) ids.add(masterCabinetId);
+  for (const cabinet of cabinetRows) {
+    if (members.has(codeKey(cabinet.masterCode))) ids.add(cabinet.id);
+  }
+  return listOf(ids).sort((a, b) => a - b);
+}
+
+/** Resolve one code or cabinet id against a group index loaded in batch. */
+export function resolveCabinetCodeGroup(index: CabinetGroupIndex, key: string | number): CabinetCodeGroup {
+  if (typeof key === "number") {
+    return index.byCabinetId.get(key)
+      ?? singletonGroup(index.cabinetsById.get(key)?.masterCode ?? "", key);
+  }
+  const normalized = codeKey(key);
+  if (!normalized) return EMPTY_GROUP;
+  return index.byCode.get(normalized)
+    ?? singletonGroup(index.cabinetsByCode.get(normalized)?.masterCode ?? key.trim(), index.cabinetsByCode.get(normalized)?.id ?? null);
+}
+
+/**
+ * One read of the alias tables, then one cabinet read. Call this once per
+ * request, then `resolveCabinetCodeGroup` for each id. Do not call it inside
+ * a per-cabinet loop.
+ */
+export async function loadCabinetGroupIndex(db: Db): Promise<CabinetGroupIndex> {
+  const [aliasRows, routeRows] = await Promise.all([
+    db
+      .select({
+        aliasCode: skuMasterAliases.aliasCode,
+        masterCode: skuMasterAliases.masterCode,
+        conflictStatus: skuMasterAliases.conflictStatus,
+      })
+      .from(skuMasterAliases)
+      .where(eq(skuMasterAliases.conflictStatus, "ok")),
+    db
+      .select({
+        alias: cabinetAliases.alias,
+        cabinetId: cabinetAliases.cabinetId,
+        masterCode: cabinets.masterCode,
+      })
+      .from(cabinetAliases)
+      .innerJoin(cabinets, eq(cabinets.id, cabinetAliases.cabinetId))
+      .where(ne(cabinets.conflictStatus, "conflict")),
+  ]);
+
+  const codes = new Set<string>();
+  for (const row of aliasRows) {
+    if (row.aliasCode) codes.add(row.aliasCode);
+    if (row.masterCode) codes.add(row.masterCode);
+  }
+  for (const row of routeRows) {
+    if (row.alias) codes.add(row.alias);
+    if (row.masterCode) codes.add(row.masterCode);
+  }
+  const codeList = listOf(codes);
+  const loadedCabinets = codeList.length === 0
+    ? []
+    : await db
+      .select({ id: cabinets.id, masterCode: cabinets.masterCode })
+      .from(cabinets)
+      .where(inArray(cabinets.masterCode, codeList));
+  const cabinetRows: CabinetRef[] = [...loadedCabinets];
+  const known = new Map(cabinetRows.map((row) => [row.id, row]));
+  for (const route of routeRows) {
+    if (!known.has(route.cabinetId)) {
+      const row = { id: route.cabinetId, masterCode: route.masterCode };
+      known.set(row.id, row);
+      cabinetRows.push(row);
+    }
+  }
+  return buildCabinetGroupIndex(aliasRows, cabinetRows, routeRows);
+}
+
+export async function resolveCabinetCodeGroupFromDb(db: Db, key: string | number): Promise<CabinetCodeGroup> {
+  const index = await loadCabinetGroupIndex(db);
+  if (typeof key === "number" && !index.byCabinetId.has(key) && !index.cabinetsById.has(key)) {
+    const [cabinet] = await db
+      .select({ id: cabinets.id, masterCode: cabinets.masterCode })
+      .from(cabinets)
+      .where(eq(cabinets.id, key))
+      .limit(1);
+    if (cabinet) {
+      index.cabinetsById.set(cabinet.id, cabinet);
+      const normalized = codeKey(cabinet.masterCode);
+      if (normalized && !index.cabinetsByCode.has(normalized)) index.cabinetsByCode.set(normalized, cabinet);
+      return singletonGroup(cabinet.masterCode ?? "", cabinet.id);
+    }
+  }
+  if (typeof key === "string" && !index.byCode.has(codeKey(key))) {
+    const [cabinet] = await db
+      .select({ id: cabinets.id, masterCode: cabinets.masterCode })
+      .from(cabinets)
+      .where(eq(cabinets.masterCode, key.trim()))
+      .limit(1);
+    if (cabinet) return singletonGroup(cabinet.masterCode ?? key.trim(), cabinet.id);
+  }
+  return resolveCabinetCodeGroup(index, key);
+}
+
+export function isPositiveMoney(value: string | number | null | undefined): boolean {
+  const parsed = Number(value ?? 0);
+  return Number.isFinite(parsed) && parsed > 0;
+}
+
+/** Priced, published, and available. Omitted flags were already filtered by the caller. */
+export function isSellablePriceRow(row: CabinetPriceSourceRow): boolean {
+  if (row.isAvailable === false || row.isPublished === false) return false;
+  if (row.cabinetId == null) return false;
+  return isPositiveMoney(row.listPrice) || isPositiveMoney(row.yourCost);
+}
+
+export function hasPositivePublishedPrice(rows: readonly CabinetPriceSourceRow[]): boolean {
+  return rows.some(isSellablePriceRow);
+}
+
+/**
+ * Sellable distributor_skus rows for every cabinet in the group.
+ * Same style + distributor: the master cabinet's row wins. Style and
+ * distributor filters are optional.
+ */
+export function resolveCabinetPriceSources<T extends CabinetPriceSourceRow>(
+  group: CabinetCodeGroup,
+  rows: readonly T[],
+  options?: { styleId?: number; distributorId?: number },
+): T[] {
+  const ids = new Set(group.cabinetIds);
+  const filtered = rows.filter((row) => {
+    if (!isSellablePriceRow(row) || row.cabinetId == null || !ids.has(row.cabinetId)) return false;
+    if (options?.styleId != null && row.styleId !== options.styleId) return false;
+    if (options?.distributorId != null && row.distributorId !== options.distributorId) return false;
+    return true;
+  });
+  const masterId = group.masterCabinetId;
+  const byStyleAndDistributor = new Map<string, T[]>();
+  for (const row of filtered) {
+    const key = `${row.styleId ?? "*"}:${row.distributorId ?? "*"}`;
+    const bucket = byStyleAndDistributor.get(key) ?? [];
+    bucket.push(row);
+    byStyleAndDistributor.set(key, bucket);
+  }
+  const chosen: T[] = [];
+  byStyleAndDistributor.forEach((bucket) => {
+    const masterRows = masterId == null ? [] : bucket.filter((row) => row.cabinetId === masterId);
+    const kept = masterRows.length > 0 ? masterRows : bucket;
+    for (const row of kept) chosen.push(row);
+  });
+  return chosen;
+}
+
+/**
+ * Master's flag when it is on. When the master has the flag off, any group
+ * member that has it on supplies the flag. The displayed cabinet is still the
+ * master.
+ */
+export type CabinetCatalogIdentity = {
+  category: string | null;
+  subCategory: string | null;
+  placementType: string | null;
+};
+
+/**
+ * Wall / base / tall bucket from category and placement. A null or blank
+ * subcategory is ignored, so "Standard Wall" with no subcategory stays on
+ * the Designer wall list.
+ */
+export function placementFromIdentity(
+  row: { category?: string | null; subCategory?: string | null; placementType?: string | null },
+): "base" | "wall" | "tall" | null {
+  const placement = (row.placementType ?? "").trim().toLowerCase();
+  if (placement === "base" || placement === "wall" || placement === "tall") return placement;
+  if (placement.includes("wall")) return "wall";
+  if (placement.includes("tall") || placement.includes("pantry") || placement.includes("oven") || placement.includes("utility")) {
+    return "tall";
+  }
+  if (placement) return "base";
+  const category = (row.category ?? "").trim().toLowerCase();
+  if (!category) return null;
+  if (category.includes("wall")) return "wall";
+  if (category.includes("tall")) return "tall";
+  if (category.includes("base") || category.includes("vanity") || category === "corner") return "base";
+  return null;
+}
+
+/**
+ * Keep the master's category when it already places the cabinet. Otherwise
+ * use an alias member that does. An empty subcategory is copied through as
+ * empty; it is not a reason to drop the row.
+ */
+export function resolveDisplayedCabinetIdentity(
+  master: CabinetCatalogIdentity,
+  member: CabinetCatalogIdentity | null,
+): CabinetCatalogIdentity & { placement: "base" | "wall" | "tall" | null } {
+  const masterPlacement = placementFromIdentity(master);
+  if (masterPlacement) {
+    return {
+      category: master.category,
+      subCategory: master.subCategory ?? null,
+      placementType: master.placementType?.trim() ? master.placementType : masterPlacement,
+      placement: masterPlacement,
+    };
+  }
+  const memberPlacement = member ? placementFromIdentity(member) : null;
+  if (member && memberPlacement) {
+    return {
+      category: member.category,
+      subCategory: member.subCategory ?? null,
+      placementType: member.placementType?.trim() ? member.placementType : memberPlacement,
+      placement: memberPlacement,
+    };
+  }
+  return {
+    category: master.category,
+    subCategory: master.subCategory ?? null,
+    placementType: master.placementType,
+    placement: null,
+  };
+}
+
+/**
+ * 3D Designer list gate. A cabinet with no alias still needs its own
+ * designerEligible flag, because Show in Designer defaults on. A master whose
+ * flags are off is included when an alias member has Show in Designer on
+ * (LWR3015) or designerEligible on.
+ */
+export function aliasBackedDesignerListSql(): SQL {
+  return sql`(
+    ${cabinetOrAliasGroupHasFlag("designerEligible")}
+    OR EXISTS (
+      SELECT 1
+      FROM sku_master_aliases group_alias
+      INNER JOIN cabinets group_member
+        ON group_member.masterCode = group_alias.aliasCode
+      WHERE group_alias.conflictStatus = 'ok'
+        AND UPPER(TRIM(group_alias.aliasCode)) <> UPPER(TRIM(group_alias.masterCode))
+        AND group_alias.masterCode = ${cabinets.masterCode}
+        AND group_member.id <> ${cabinets.id}
+        AND group_member.conflictStatus <> 'conflict'
+        AND group_member.showInDesigner = true
+        AND group_member.isActive = true
+    )
+  )`;
+}
+
+export function resolveGroupVisibility(
+  master: CabinetVisibility | null,
+  members: readonly CabinetVisibility[],
+): CabinetVisibility {
+  const pick = (flag: CabinetVisibilityFlag) =>
+    Boolean(master?.[flag]) || members.some((member) => member[flag]);
+  return {
+    isActive: pick("isActive"),
+    showInCatalog: pick("showInCatalog"),
+    showInDesigner: pick("showInDesigner"),
+    designerEligible: pick("designerEligible"),
+  };
+}
+
+const VISIBILITY_COLUMN = {
+  isActive: cabinets.isActive,
+  showInCatalog: cabinets.showInCatalog,
+  showInDesigner: cabinets.showInDesigner,
+  designerEligible: cabinets.designerEligible,
+} as const;
+
+function memberHasFlagSql(flag: CabinetVisibilityFlag): SQL {
+  return sql`group_member.${sql.raw(flag)} = true`;
+}
+
+/**
+ * This cabinet's flag is on, or it is the master of an approved alias whose
+ * cabinet has the flag on (one hop, plus the grandchild hop used by format
+ * chains such as B-24 → B24 → BASE-24). Self-aliases do not count.
+ */
+export function cabinetOrAliasGroupHasFlag(flag: CabinetVisibilityFlag): SQL {
+  const column = VISIBILITY_COLUMN[flag];
+  const memberFlag = memberHasFlagSql(flag);
+  return sql`(
+    ${eq(column, true)}
+    OR EXISTS (
+      SELECT 1
+      FROM sku_master_aliases group_alias
+      INNER JOIN cabinets group_member
+        ON group_member.masterCode = group_alias.aliasCode
+      WHERE group_alias.conflictStatus = 'ok'
+        AND UPPER(TRIM(group_alias.aliasCode)) <> UPPER(TRIM(group_alias.masterCode))
+        AND group_alias.masterCode = ${cabinets.masterCode}
+        AND group_member.id <> ${cabinets.id}
+        AND group_member.conflictStatus <> 'conflict'
+        AND ${memberFlag}
+    )
+    OR EXISTS (
+      SELECT 1
+      FROM sku_master_aliases group_alias
+      INNER JOIN sku_master_aliases group_hop
+        ON group_hop.conflictStatus = 'ok'
+       AND UPPER(TRIM(group_hop.aliasCode)) <> UPPER(TRIM(group_hop.masterCode))
+       AND group_hop.masterCode = group_alias.aliasCode
+      INNER JOIN cabinets group_member
+        ON group_member.masterCode = group_hop.aliasCode
+      WHERE group_alias.conflictStatus = 'ok'
+        AND UPPER(TRIM(group_alias.aliasCode)) <> UPPER(TRIM(group_alias.masterCode))
+        AND group_alias.masterCode = ${cabinets.masterCode}
+        AND group_member.id <> ${cabinets.id}
+        AND group_member.conflictStatus <> 'conflict'
+        AND ${memberFlag}
+    )
+  )`;
+}
+
+/**
+ * True when this cabinet, an approved alias cabinet, or the cabinet an alias
+ * points at has a positive published available supplier row. Self-aliases are
+ * ignored. List queries use this instead of a per-cabinet lookup.
+ */
+export function hasPositivePublishedCabinetPriceSql(): SQL {
+  return sql`EXISTS (
+    SELECT 1
+    FROM distributor_skus sellable_price
+    INNER JOIN cabinets price_cabinet
+      ON price_cabinet.id = sellable_price.cabinetId
+    WHERE sellable_price.isAvailable = true
+      AND sellable_price.isPublished = true
+      AND (COALESCE(sellable_price.listPrice, 0) > 0 OR COALESCE(sellable_price.yourCost, 0) > 0)
+      AND price_cabinet.conflictStatus <> 'conflict'
+      AND (
+        price_cabinet.id = ${cabinets.id}
+        OR EXISTS (
+          SELECT 1
+          FROM sku_master_aliases price_alias
+          WHERE price_alias.conflictStatus = 'ok'
+            AND UPPER(TRIM(price_alias.aliasCode)) <> UPPER(TRIM(price_alias.masterCode))
+            AND (
+              (price_alias.masterCode = ${cabinets.masterCode} AND price_alias.aliasCode = price_cabinet.masterCode)
+              OR (price_alias.aliasCode = ${cabinets.masterCode} AND price_alias.masterCode = price_cabinet.masterCode)
+            )
+        )
+        OR EXISTS (
+          SELECT 1
+          FROM sku_master_aliases price_alias
+          INNER JOIN sku_master_aliases price_hop
+            ON price_hop.conflictStatus = 'ok'
+           AND UPPER(TRIM(price_hop.aliasCode)) <> UPPER(TRIM(price_hop.masterCode))
+           AND price_hop.aliasCode = price_cabinet.masterCode
+           AND price_hop.masterCode = price_alias.aliasCode
+          WHERE price_alias.conflictStatus = 'ok'
+            AND UPPER(TRIM(price_alias.aliasCode)) <> UPPER(TRIM(price_alias.masterCode))
+            AND price_alias.masterCode = ${cabinets.masterCode}
+        )
+        OR EXISTS (
+          SELECT 1
+          FROM cabinet_aliases route_alias
+          WHERE route_alias.cabinetId = ${cabinets.id}
+            AND route_alias.alias = price_cabinet.masterCode
+            AND UPPER(TRIM(route_alias.alias)) <> UPPER(TRIM(${cabinets.masterCode}))
+        )
+      )
+  )`;
+}
+
+/**
+ * Hide a duplicate alias cabinet when its approved master is a different,
+ * still-live product. A self-alias never retires the cabinet it names.
+ * A positive price on the alias cabinet also counts as the master's supplier
+ * source, so the alias is not published as a second product.
+ */
+export function isCanonicalCabinetMasterSql(): SQL {
+  return sql`NOT EXISTS (
+    SELECT 1
+    FROM sku_master_aliases canonical_sku_alias
+    INNER JOIN cabinets canonical_cabinet
+      ON canonical_cabinet.masterCode = canonical_sku_alias.masterCode
+    WHERE canonical_sku_alias.aliasCode = ${cabinets.masterCode}
+      AND canonical_sku_alias.conflictStatus = 'ok'
+      AND UPPER(TRIM(canonical_sku_alias.aliasCode)) <> UPPER(TRIM(canonical_sku_alias.masterCode))
+      AND canonical_cabinet.id <> ${cabinets.id}
+      AND (
+        canonical_cabinet.isActive = true
+        OR canonical_cabinet.showInCatalog = true
+        OR canonical_cabinet.showInDesigner = true
+        OR EXISTS (
+          SELECT 1
+          FROM distributor_skus canonical_supplier_sku
+          WHERE canonical_supplier_sku.cabinetId = canonical_cabinet.id
+        )
+        OR (
+          canonical_cabinet.conflictStatus <> 'conflict'
+          AND EXISTS (
+            SELECT 1
+            FROM distributor_skus alias_group_price
+            WHERE alias_group_price.cabinetId = ${cabinets.id}
+              AND alias_group_price.isAvailable = true
+              AND alias_group_price.isPublished = true
+              AND (COALESCE(alias_group_price.listPrice, 0) > 0 OR COALESCE(alias_group_price.yourCost, 0) > 0)
+          )
+        )
+      )
+  )`;
+}
+
+export function positivePublishedSkuSql(): SQL {
+  return sql`(
+    ${distributorSkus.isAvailable} = true
+    AND ${distributorSkus.isPublished} = true
+    AND (COALESCE(${distributorSkus.listPrice}, 0) > 0 OR COALESCE(${distributorSkus.yourCost}, 0) > 0)
+  )`;
+}
+
+/** Shared public-catalog predicate. Re-exported from server/db.ts as notInConflict(). */
+export function notInConflictSql(): SQL | undefined {
+  return and(
+    cabinetOrAliasGroupHasFlag("isActive"),
+    ne(cabinets.conflictStatus, "conflict"),
+    isCanonicalCabinetMasterSql(),
+    hasPositivePublishedCabinetPriceSql(),
+  );
+}
