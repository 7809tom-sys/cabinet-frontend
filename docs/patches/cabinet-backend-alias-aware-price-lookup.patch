+
+describe("Standard Wall with no subcategory", () => {
+  it("places the alias member's Standard Wall category on the wall list when the master has no category", () => {
+    expect(placementFromIdentity({ category: "Standard Wall", subCategory: null, placementType: null })).toBe("wall");
+    expect(placementFromIdentity({ category: "Standard Wall", subCategory: "", placementType: null })).toBe("wall");
