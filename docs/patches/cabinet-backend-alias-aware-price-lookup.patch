+    const alias = row({
+      id: 32,
+      cabinetId: 9390050,
+      styleId: 330007,
+      distributorId: 210001,
+      listPrice: "294.76",
+    });
+    const otherStyle = row({
+      id: 33,
+      cabinetId: 9390050,
+      styleId: 330011,
+      distributorId: 210001,
+      listPrice: "301.00",
+    });
+    const otherDistributor = row({
+      id: 34,
+      cabinetId: 9390050,
+      styleId: 390001,
+      distributorId: 180001,
+      listPrice: "250.00",
+    });
+    const priced = resolveCabinetPriceSources(group, [alias, master, otherStyle, otherDistributor]);
