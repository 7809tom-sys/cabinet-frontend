+} from "./cabinetPriceResolver";
+
+const dialect = new MySqlDialect();
+
+const WINE_LINKS = [
+  { aliasCode: "LWR3015", masterCode: "WRC3015", conflictStatus: "ok" as const },
+  { aliasCode: "WRC3015", masterCode: "WRC3015", conflictStatus: "ok" as const },
+];
+const WINE_CABINETS = [
+  { id: 9360166, masterCode: "WRC3015" },
+  { id: 9390050, masterCode: "LWR3015" },
+];
+const WINE_ROUTES = [{ alias: "LWR3015", cabinetId: 9360166 }];
+
+function wineGroup() {
+  return resolveCabinetCodeGroup(
+    buildCabinetGroupIndex(WINE_LINKS, WINE_CABINETS, WINE_ROUTES),
+    9360166,
+  );
+}
+
+function row(partial: CabinetPriceSourceRow & { id: number }): CabinetPriceSourceRow & { id: number } {
+  return {
+    isAvailable: true,
+    isPublished: true,
+    yourCost: null,
+    ...partial,
+  };
+}
+
+describe("resolveCabinetCodeGroup", () => {
+  it("keeps LWR3015 as an alias of WRC3015 and ignores the self-alias", () => {
+    const group = wineGroup();
+    expect(group).toEqual({
+      masterCode: "WRC3015",
+      masterCabinetId: 9360166,
+      aliasCodes: ["LWR3015"],
+      cabinetIds: [9360166, 9390050],
+    });
+    const byAlias = resolveCabinetCodeGroup(
+      buildCabinetGroupIndex(WINE_LINKS, WINE_CABINETS, WINE_ROUTES),
+      "LWR3015",
+    );
+    expect(byAlias.masterCabinetId).toBe(9360166);
+  });
+
+  it("does not share prices across a true alias cycle", () => {
+    const index = buildCabinetGroupIndex(
+      [
+        { aliasCode: "A", masterCode: "B", conflictStatus: "ok" },
+        { aliasCode: "B", masterCode: "A", conflictStatus: "ok" },
+      ],
+      [
+        { id: 1, masterCode: "A" },
+        { id: 2, masterCode: "B" },
+      ],
+    );
+    const group = resolveCabinetCodeGroup(index, "A");
+    expect(group.aliasCodes).toEqual([]);
+    expect(group.cabinetIds).toEqual([1]);
+    const priced = resolveCabinetPriceSources(group, [
+      row({ id: 10, cabinetId: 2, styleId: 1, distributorId: 1, listPrice: "50" }),
+    ]);
+    expect(priced).toEqual([]);
+    expect(hasPositivePublishedPrice(priced)).toBe(false);
+  });
+});
+
+describe("resolveCabinetPriceSources", () => {
+  const group = wineGroup();
+
+  it("uses the alias cabinet when that is the only priced code", () => {
+    const alias = row({
+      id: 11,
+      cabinetId: 9390050,
+      styleId: 330007,
+      distributorId: 210001,
+      listPrice: "294.76",
