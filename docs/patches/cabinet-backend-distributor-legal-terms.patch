+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { describe, expect, it } from "vitest";
+import { legalTermSectionAllowed } from "./distributorLegalTerms";
+
+describe("distributor legal terms", () => {
+  it("allows the five distributors and the shared Cabinet Deals row, and nothing else", () => {
+    for (const key of ["us-cabinet-depot", "skyline", "faircrest", "milestone", "pelican"]) {
+      expect(legalTermSectionAllowed(key, "shipping")).toBe(true);
+      expect(legalTermSectionAllowed(key, "returns")).toBe(true);
+      expect(legalTermSectionAllowed(key, "warranty")).toBe(true);
+      expect(legalTermSectionAllowed(key, "return-rules")).toBe(false);
+    }
+    expect(legalTermSectionAllowed("cabinet-deals", "return-rules")).toBe(true);
+    expect(legalTermSectionAllowed("cabinet-deals", "returns")).toBe(false);
+    expect(legalTermSectionAllowed("forevermark", "warranty")).toBe(false);
+  });
+
+  it("keeps list and save admin-only and does not delete rows", () => {
+    const router = readFileSync(resolve(process.cwd(), "server/routers/distributorLegalTerms.ts"), "utf8");
+    expect(router).toContain("list: adminProcedure");
+    expect(router).toContain("save: adminProcedure");
+    expect(router).not.toContain("delete(");
+    expect(router).not.toContain(".delete(");
+    expect(router).toContain("legalTermSectionAllowed");
+  });
+});
