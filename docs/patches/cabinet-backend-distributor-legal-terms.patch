+/**
+ * Which Legal-tab rows an admin may save.
+ *
+ * Distributor sections are shipping, returns, and warranty. The shared
+ * Cabinet Deals return rules are a separate row and cannot be written into a
+ * distributor section. There is no delete.
+ */
+export const DISTRIBUTOR_LEGAL_TERM_KEYS = [
+  "us-cabinet-depot",
+  "skyline",
+  "faircrest",
+  "milestone",
+  "pelican",
+] as const;
+
+export const DISTRIBUTOR_LEGAL_SECTIONS = ["shipping", "returns", "warranty"] as const;
+
+export const CABINET_DEALS_LEGAL_KEY = "cabinet-deals";
+export const CABINET_DEALS_RETURN_SECTION = "return-rules";
+
+export function legalTermSectionAllowed(distributorKey: string, sectionKey: string): boolean {
+  if (distributorKey === CABINET_DEALS_LEGAL_KEY) return sectionKey === CABINET_DEALS_RETURN_SECTION;
+  return (
+    (DISTRIBUTOR_LEGAL_TERM_KEYS as readonly string[]).includes(distributorKey) &&
+    (DISTRIBUTOR_LEGAL_SECTIONS as readonly string[]).includes(sectionKey)
+  );
+}
