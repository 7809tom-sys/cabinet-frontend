From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 10 Nov 2026 13:40:00 +0000
Subject: [PATCH] Store admin Legal tab terms per distributor

Admin-only list and save for the Legal tab. One row per distributor
section (shipping, returns, warranty) plus one shared Cabinet Deals
return-rules row. Saving null bodyText puts the captured wording back.
This router does not delete and does not migrate.

Run cabinet-frontend docs/sql/0274_distributor_legal_terms.tidb.sql in
the TiDB editor before deploy. bodyText stays NULL until an admin pastes.

Apply from the cabinet-backend repository root:

    git apply /path/to/cabinet-backend-distributor-legal-terms.patch

---
diff --git a/drizzle/schema.ts b/drizzle/schema.ts
index d753a9d..aa94299 100644
--- a/drizzle/schema.ts
+++ b/drizzle/schema.ts
@@ -4849,3 +4849,22 @@ export const affiliateLegalSignatures = mysqlTable("affiliate_legal_signatures",
 }));
 export type AffiliateLegalSignature = typeof affiliateLegalSignatures.$inferSelect;
 export type InsertAffiliateLegalSignature = typeof affiliateLegalSignatures.$inferInsert;
+
+// Admin Legal tab. One row per distributor section. bodyText NULL means the
+// admin page shows the captured wording shipped with the frontend. This table
+// does not hold customer-facing copy. Created by hand from
+// docs/sql/0274_distributor_legal_terms.tidb.sql in cabinet-frontend.
+export const distributorLegalTerms = mysqlTable("distributor_legal_terms", {
+  id: int("id").autoincrement().primaryKey(),
+  distributorKey: varchar("distributorKey", { length: 64 }).notNull(),
+  sectionKey: varchar("sectionKey", { length: 32 }).notNull(),
+  bodyText: text("bodyText"),
+  sourceUrl: text("sourceUrl"),
+  capturedOn: varchar("capturedOn", { length: 10 }),
+  updatedByName: varchar("updatedByName", { length: 255 }),
+  createdAt: timestamp("createdAt").defaultNow().notNull(),
+  updatedAt: timestamp("updatedAt").defaultNow().onUpdateNow().notNull(),
+}, (t) => ({
+  keyUnique: uniqueIndex("distributor_legal_terms_key_uq").on(t.distributorKey, t.sectionKey),
+}));
+export type DistributorLegalTerm = typeof distributorLegalTerms.$inferSelect;
