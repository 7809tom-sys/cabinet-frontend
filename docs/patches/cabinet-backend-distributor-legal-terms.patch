diff --git a/server/routers/distributorLegalTerms.ts b/server/routers/distributorLegalTerms.ts
new file mode 100644
index 0000000..58f8aed
--- /dev/null
+++ b/server/routers/distributorLegalTerms.ts
@@ -0,0 +1,115 @@
+/**
+ * Admin Legal tab. The table is created by hand from
+ * cabinet-frontend docs/sql/0274_distributor_legal_terms.tidb.sql.
+ * This router does not migrate and does not delete.
+ *
+ * list and save are admin-only. A missing table returns a precondition error
+ * the admin screen already explains. bodyText NULL means the frontend shows
+ * the captured distributor wording. Saving a string replaces that section
+ * only. Saving null puts the capture back.
+ */
+import { TRPCError } from "@trpc/server";
+import { and, asc, eq } from "drizzle-orm";
+import { z } from "zod";
+import { distributorLegalTerms } from "../../drizzle/schema";
+import { legalTermSectionAllowed } from "../lib/distributorLegalTerms";
+import { adminProcedure, router } from "../_core/trpc";
+import { getDb } from "../db";
+
+const SQL_FILE = "docs/sql/0274_distributor_legal_terms.tidb.sql";
+
+function editorName(user: { name?: string | null }): string {
+  return user.name?.trim() || "admin";
+}
+
+function missingTable(error: unknown): boolean {
+  const message = error instanceof Error ? error.message : String(error);
+  return /ER_NO_SUCH_TABLE|1146|doesn't exist|does not exist|no such table/i.test(message);
+}
+
+function schemaError(): TRPCError {
+  return new TRPCError({
+    code: "PRECONDITION_FAILED",
+    message: `The distributor legal terms table is not on the database yet. Run ${SQL_FILE} in the TiDB editor.`,
+  });
+}
+
+async function database() {
+  const db = await getDb();
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
+  return db;
+}
+
+function toRow(row: typeof distributorLegalTerms.$inferSelect) {
+  return {
+    distributorKey: row.distributorKey,
+    sectionKey: row.sectionKey,
+    bodyText: row.bodyText,
+    sourceUrl: row.sourceUrl,
+    capturedOn: row.capturedOn,
+    updatedByName: row.updatedByName,
+    updatedAt: row.updatedAt ? new Date(row.updatedAt).toISOString() : null,
+  };
+}
+
+export const distributorLegalTermsRouter = router({
+  list: adminProcedure.query(async () => {
+    try {
+      const db = await database();
+      const rows = await db
+        .select()
+        .from(distributorLegalTerms)
+        .orderBy(asc(distributorLegalTerms.distributorKey), asc(distributorLegalTerms.sectionKey));
+      return rows.map(toRow);
+    } catch (error) {
+      if (error instanceof TRPCError) throw error;
+      if (missingTable(error)) throw schemaError();
+      throw error;
+    }
+  }),
+
+  save: adminProcedure.input(z.object({
+    distributorKey: z.string().trim().min(1).max(64),
+    sectionKey: z.string().trim().min(1).max(32),
+    bodyText: z.string().max(200_000).nullable(),
+    sourceUrl: z.string().trim().max(2000).nullable().optional(),
+    capturedOn: z.string().trim().regex(/^\d{4}-\d{2}-\d{2}$/).nullable().optional(),
+  })).mutation(async ({ ctx, input }) => {
+    if (!legalTermSectionAllowed(input.distributorKey, input.sectionKey)) {
+      throw new TRPCError({ code: "BAD_REQUEST", message: "That legal section cannot be saved." });
+    }
+    try {
+      const db = await database();
+      const existing = await db
+        .select()
+        .from(distributorLegalTerms)
+        .where(and(
+          eq(distributorLegalTerms.distributorKey, input.distributorKey),
+          eq(distributorLegalTerms.sectionKey, input.sectionKey),
+        ))
+        .limit(1);
+      const editor = editorName(ctx.user);
+      if (existing[0]) {
+        await db.update(distributorLegalTerms).set({
+          bodyText: input.bodyText,
+          updatedByName: editor,
+          updatedAt: new Date(),
+        }).where(eq(distributorLegalTerms.id, existing[0].id));
+      } else {
+        await db.insert(distributorLegalTerms).values({
+          distributorKey: input.distributorKey,
+          sectionKey: input.sectionKey,
+          bodyText: input.bodyText,
+          sourceUrl: input.sourceUrl ?? null,
+          capturedOn: input.capturedOn ?? null,
+          updatedByName: editor,
+        });
+      }
+      return { ok: true as const, updatedByName: editor };
+    } catch (error) {
+      if (error instanceof TRPCError) throw error;
+      if (missingTable(error)) throw schemaError();
+      throw error;
+    }
+  }),
+});
