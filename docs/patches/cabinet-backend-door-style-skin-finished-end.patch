+    expect(isMissingDoorStyleNeedColumn({ code: "ER_BAD_FIELD_ERROR", sqlMessage: "Unknown column 'skinNeeded' in 'field list'" })).toBe(true);
+    expect(isMissingDoorStyleNeedColumn(new Error("Unknown column 'finishedEndNeeded'"))).toBe(true);
+    expect(isMissingDoorStyleNeedColumn(new Error("connection reset"))).toBe(false);
+  });
+});
diff --git a/server/lib/doorStyleNeedFlags.ts b/server/lib/doorStyleNeedFlags.ts
new file mode 100644
index 0000000..dcb79bc
--- /dev/null
+++ b/server/lib/doorStyleNeedFlags.ts
@@ -0,0 +1,110 @@
+import { sql } from "drizzle-orm";
+import { TRPCError } from "@trpc/server";
+import { canHaveSkins, DOOR_STYLE_NEED_SQL_MESSAGE, type SkinEligibilityStyle } from "../../shared/canHaveSkins";
+
+const MISSING_COLUMN = /unknown column|ER_BAD_FIELD_ERROR|no such column|does not exist/i;
+
+type ExecuteDb = {
+  execute: (query: ReturnType<typeof sql>) => Promise<unknown>;
+};
+
+export function isMissingDoorStyleNeedColumn(error: unknown): boolean {
+  const parts: string[] = [];
+  const seen = new Set<unknown>();
+  let current: unknown = error;
+  while (current != null && typeof current === "object" && !seen.has(current)) {
+    seen.add(current);
+    const row = current as { message?: unknown; sqlMessage?: unknown; cause?: unknown };
+    if (typeof row.message === "string") parts.push(row.message);
+    if (typeof row.sqlMessage === "string") parts.push(row.sqlMessage);
+    current = row.cause;
+  }
+  if (typeof error === "string") parts.push(error);
+  return MISSING_COLUMN.test(parts.join(" "));
+}
+
+function rowsFrom(result: unknown): Array<Record<string, unknown>> {
+  if (Array.isArray(result)) {
+    const first = result[0];
+    if (Array.isArray(first)) return first as Array<Record<string, unknown>>;
+    if (first && typeof first === "object") return result as Array<Record<string, unknown>>;
+  }
+  if (result && typeof result === "object" && Array.isArray((result as { rows?: unknown }).rows)) {
+    return (result as { rows: Array<Record<string, unknown>> }).rows;
+  }
+  return [];
+}
+
+function storedFlag(value: unknown): boolean | null {
+  if (value === null || value === undefined) return null;
+  if (value === true || value === 1 || value === "1") return true;
+  if (value === false || value === 0 || value === "0") return false;
+  return null;
+}
+
+export type DoorStyleNeedFlags = {
+  skinNeeded: boolean | null;
+  finishedEndNeeded: boolean | null;
+};
+
+/** Reads return null for both flags when the columns are not applied yet. */
+export async function readDoorStyleNeedFlags(db: ExecuteDb, ids: readonly number[]): Promise<Map<number, DoorStyleNeedFlags>> {
+  const flags = new Map<number, DoorStyleNeedFlags>();
+  for (const id of ids) flags.set(id, { skinNeeded: null, finishedEndNeeded: null });
+  if (ids.length === 0) return flags;
+  try {
+    const result = await db.execute(sql`SELECT id, skinNeeded, finishedEndNeeded FROM door_styles WHERE id IN (${sql.join(ids.map((id) => sql`${id}`), sql`, `)})`);
+    for (const row of rowsFrom(result)) {
+      const id = Number(row.id);
+      if (!flags.has(id)) continue;
+      flags.set(id, {
+        skinNeeded: storedFlag(row.skinNeeded),
+        finishedEndNeeded: storedFlag(row.finishedEndNeeded),
+      });
+    }
+  } catch (error) {
+    if (isMissingDoorStyleNeedColumn(error)) return flags;
+    throw error;
+  }
+  return flags;
+}
+
+export function attachDoorStyleNeedFlags<T extends { id: number }>(rows: readonly T[], flags: Map<number, DoorStyleNeedFlags>): Array<T & DoorStyleNeedFlags> {
+  return rows.map((row) => ({
+    ...row,
+    ...(flags.get(row.id) ?? { skinNeeded: null, finishedEndNeeded: null }),
+  }));
+}
+
+/**
+ * Writes fail with a clear message until the SQL is applied. A Skin needed
+ * Yes is rejected unless the style is hickory frameless.
+ */
+export async function writeDoorStyleNeedFlags(
+  db: ExecuteDb,
+  id: number,
+  patch: { skinNeeded?: boolean; finishedEndNeeded?: boolean },
+): Promise<void> {
+  if (patch.skinNeeded === undefined && patch.finishedEndNeeded === undefined) return;
+  if (patch.skinNeeded === true) {
+    const result = await db.execute(sql`
+      SELECT styleCode, ourName, aliasName, distributorName, doorStyle, woodSpecies, finish, color, boxConstruction, overlayType
+      FROM door_styles WHERE id = ${id} LIMIT 1
+    `);
+    const row = rowsFrom(result)[0] as SkinEligibilityStyle | undefined;
+    if (!canHaveSkins(row ?? null)) {
+      throw new TRPCError({ code: "BAD_REQUEST", message: "Only hickory frameless gets skins" });
+    }
+  }
+  const statements: Array<ReturnType<typeof sql>> = [];
+  if (patch.skinNeeded !== undefined) statements.push(sql`UPDATE door_styles SET skinNeeded = ${patch.skinNeeded ? 1 : 0} WHERE id = ${id}`);
+  if (patch.finishedEndNeeded !== undefined) statements.push(sql`UPDATE door_styles SET finishedEndNeeded = ${patch.finishedEndNeeded ? 1 : 0} WHERE id = ${id}`);
+  try {
+    for (const statement of statements) await db.execute(statement);
+  } catch (error) {
+    if (isMissingDoorStyleNeedColumn(error)) {
+      throw new TRPCError({ code: "BAD_REQUEST", message: DOOR_STYLE_NEED_SQL_MESSAGE });
+    }
+    throw error;
+  }
+}
