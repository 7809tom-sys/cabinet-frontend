+import { describe, expect, it } from "vitest";
+import { canHaveSkins, skinsAreNeeded } from "./canHaveSkins";
+
+describe("canHaveSkins", () => {
+  it("is true only for hickory frameless and ignores a forced yes", () => {
+    expect(canHaveSkins({ woodSpecies: "Hickory", styleCode: "SSH", boxConstruction: "frameless" })).toBe(true);
+    expect(canHaveSkins({ woodSpecies: "Hickory", boxConstruction: "face frame", styleCode: "HS", skinNeeded: true })).toBe(false);
+    expect(skinsAreNeeded({ woodSpecies: "Maple", boxConstruction: "frameless", skinNeeded: true })).toBe(false);
+    expect(skinsAreNeeded({ ourName: "Forest Rust", styleCode: "RH", skinNeeded: 1 })).toBe(false);
+    expect(skinsAreNeeded({ woodSpecies: "Hickory", styleCode: "SSH" })).toBe(true);
+    expect(skinsAreNeeded({ woodSpecies: "Hickory", styleCode: "SSH", skinNeeded: false })).toBe(false);
+  });
+});
diff --git a/shared/canHaveSkins.ts b/shared/canHaveSkins.ts
new file mode 100644
index 0000000..66d0086
--- /dev/null
+++ b/shared/canHaveSkins.ts
@@ -0,0 +1,77 @@
+/**
+ * Keep this in step with cabinet-frontend shared/canHaveSkins.ts.
+ * Only hickory frameless door styles get skins. A style code or a forced
+ * checkbox cannot override that.
+ */
+
+const HICKORY_WORD = /\bhickory\b/i;
+const FRAMELESS_TEXT = /frameless|altaeuro|alta euro|\baef\b|us cabinet depot/i;
+const USCD_STYLE_CODE = /^(TWP|TGW|TDW|PGW|ZS[A-Z]|ZC[A-Z]|SC[A-Z]|LS[A-Z]|SS[A-Z])$/i;
+const NAMED_AEF_STYLE_CODE = /\b(?:TWP|TGW|TDW|PGW|(?:LS|ZS|ZC|SS|SC)[A-Z])\b/;
+
+export type SkinEligibilityStyle = {
+  styleCode?: string | null;
+  ourName?: string | null;
+  name?: string | null;
+  aliasName?: string | null;
+  distributorName?: string | null;
+  supplierBrandName?: string | null;
+  supplierName?: string | null;
+  doorStyle?: string | null;
+  woodSpecies?: string | null;
+  finish?: string | null;
+  color?: string | null;
+  boxConstruction?: string | null;
+  overlayType?: string | null;
+  constructionMethod?: string | null;
+  isFrameless?: boolean | null;
+  frameless?: boolean | null;
+  skinNeeded?: boolean | number | null;
+  finishedEndNeeded?: boolean | number | null;
+};
+
+function text(parts: Array<string | null | undefined>): string {
+  return parts.filter((part) => part && String(part).trim()).join(" ");
+}
+
+function framelessCode(styleCode: string | null | undefined): boolean {
+  const code = (styleCode ?? "").trim();
+  if (!code) return false;
+  if (USCD_STYLE_CODE.test(code)) return true;
+  return /^(?:LS|ZS|ZC|SS|SC)[A-Z]$/i.test(code) || /^(?:TWP|TGW|TDW|PGW)$/i.test(code);
+}
+
+export function canHaveSkins(style: SkinEligibilityStyle | null | undefined): boolean {
+  if (!style) return false;
+  const hickory = HICKORY_WORD.test(text([
+    style.woodSpecies,
+    style.ourName,
+    style.name,
+    style.aliasName,
+    style.distributorName,
+    style.doorStyle,
+    style.finish,
+    style.color,
+  ]));
+  if (!hickory) return false;
+  if (style.isFrameless === true || style.frameless === true) return true;
+  const named = text([style.ourName, style.aliasName]).toUpperCase();
+  const namedCode = named.match(NAMED_AEF_STYLE_CODE)?.[0] ?? null;
+  if (framelessCode(style.styleCode) || framelessCode(namedCode)) return true;
+  return FRAMELESS_TEXT.test(text([
+    style.boxConstruction,
+    style.overlayType,
+    style.constructionMethod,
+    style.distributorName,
+    style.supplierBrandName,
+    style.supplierName,
+  ]));
+}
+
+export function skinsAreNeeded(style: SkinEligibilityStyle | null | undefined): boolean {
+  if (!canHaveSkins(style)) return false;
+  return style?.skinNeeded !== false && style?.skinNeeded !== 0;
+}
+
+export const DOOR_STYLE_NEED_SQL_MESSAGE =
+  "door_styles.skinNeeded and finishedEndNeeded are missing. Run docs/sql/0243_door_style_skin_finished_end.tidb.sql before saving these checkboxes.";
