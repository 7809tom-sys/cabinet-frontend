@@ -0,0 +1,19 @@
+-- TiDB SQL editor version. Numbered 0243. Run after 0242.
+-- Paste each numbered block on its own. One statement per block.
+-- Every table is cabinet_dealz.<table>.
+-- Nullable on purpose: an unset checkbox keeps the application default.
+-- Skin needed defaults to Yes only for hickory frameless. Finished end needed defaults to No.
+-- Do not run this from an application. The owner pastes it in the TiDB editor.
+-- Safe to re-run: ADD COLUMN IF NOT EXISTS.
+
+-- 1
+ALTER TABLE cabinet_dealz.door_styles ADD COLUMN IF NOT EXISTS skinNeeded TINYINT(1) NULL;
+
+-- 2
+ALTER TABLE cabinet_dealz.door_styles ADD COLUMN IF NOT EXISTS finishedEndNeeded TINYINT(1) NULL;
+
+-- 3
+COMMIT;
+
+-- 4
+SELECT 'COMMITTED';
