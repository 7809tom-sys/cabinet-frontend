+import { describe, expect, it, vi } from "vitest";
+import { generateImage } from "../_core/imageGeneration";
+import {
+  ATTACH_CUSTOMER_MESSAGE,
+  IMAGE_GENERATED_NOTE,
+  ImageCustomerRequiredError,
+  emptyImageLinkFacts,
+  markOrderImageGenerated,
+  resolveImageCustomerLink,
+  resolveLinkedOrderId,
+  runPaidImageGeneration,
+  type ImageLedgerDraft,
+  type ImageLinkFacts,
+  type ImageLinkRequest,
+  type PaidImageEffects,
+} from "./imageCustomerLink";
+
+function facts(patch: Partial<ImageLinkFacts> = {}): ImageLinkFacts {
+  return { ...emptyImageLinkFacts(), ...patch };
+}
+
+function request(patch: Partial<ImageLinkRequest> = {}): ImageLinkRequest {
+  return {
+    imageType: "photoreal",
+    model: "gemini-3.1-flash-image",
+    requestedByUserId: 9,
+    actorRole: "user",
+    ...patch,
+  };
+}
+
+function effects() {
+  const ledger: ImageLedgerDraft[] = [];
+  const orders: number[] = [];
+  const notes: Array<{ dealId: number; authorUserId: number | null }> = [];
+  const api: PaidImageEffects = {
+    async writeLedger(row) { ledger.push(row); },
+    async markOrderImageGenerated(orderId) { orders.push(orderId); return "updated"; },
+    async noteImageGenerated(dealId, authorUserId) { notes.push({ dealId, authorUserId }); },
+  };
+  return { ledger, orders, notes, api };
+}
+
+describe("paid image customer guard", () => {
+  it("blocks a generation that has no customer and writes a blocked ledger row", async () => {
+    const fx = effects();
+    const run = vi.fn();
+    await expect(runPaidImageGeneration({
+      request: request(),
+      facts: facts(),
+      effects: fx.api,
+      run,
+    })).rejects.toThrow(ATTACH_CUSTOMER_MESSAGE);
+    expect(run).not.toHaveBeenCalled();
+    expect(fx.ledger).toEqual([expect.objectContaining({
+      status: "blocked",
+      purpose: "customer",
+      customerId: null,
+      orderId: null,
+    })]);
+    expect(fx.orders).toEqual([]);
+    expect(fx.notes).toEqual([]);
+  });
+
+  it("allows a generation when the design owner is the customer", async () => {
+    const fx = effects();
+    const result = await runPaidImageGeneration({
+      request: request({ imageType: "room_scene", designId: 40 }),
+      facts: facts({ design: { id: 40, userId: 7 }, userIds: [7] }),
+      effects: fx.api,
+      run: async () => ({ imageUrl: "https://cdn.example/room.png", value: { ok: true } }),
+    });
+    expect(result.link).toMatchObject({
+      purpose: "customer",
+      customerId: 7,
+      customerKind: "user",
+      designId: 40,
+    });
+    expect(result.value).toEqual({ ok: true });
+    expect(fx.ledger).toEqual([expect.objectContaining({
+      status: "succeeded",
+      customerId: 7,
+      designId: 40,
+      imageUrl: "https://cdn.example/room.png",
+    })]);
+  });
+
+  it("resolves the customer and order from the design's order_requests link", async () => {
+    const link = resolveImageCustomerLink(
+      request({ designId: 40, imageType: "design_render" }),
+      facts({
+        design: { id: 40, userId: null },
+        orderRequests: [{ id: 18, userId: 4, kitchenDesignId: 40 }],
+        orderDeals: [{ orderRequestId: 18, dealId: 90 }],
+        userIds: [4],
+        crmDealIds: [90],
+      }),
+    );
+    expect(link).toMatchObject({
+      purpose: "customer",
+      customerId: 4,
+      customerKind: "user",
+      orderId: 18,
+      crmDealId: 90,
+      designId: 40,
+    });
+    expect(resolveLinkedOrderId(request({ designId: 40 }), facts({
+      design: { id: 40, userId: null },
+      orderRequests: [
+        { id: 3, userId: 4, kitchenDesignId: 40 },
+        { id: 18, userId: 4, kitchenDesignId: 40 },
+      ],
+    }))).toBe(18);
+  });
+
+  it("resolves the order through crm_deal_designs and the deal's order request", async () => {
+    const link = resolveImageCustomerLink(
+      request({ designId: 12 }),
+      facts({
+        design: { id: 12, userId: null },
+        designDealIds: [55],
+        dealOrders: [{ dealId: 55, orderRequestId: 70 }],
+        orderRequests: [{ id: 70, userId: null, kitchenDesignId: null }],
+        orderDeals: [{ orderRequestId: 70, dealId: 55 }],
+        crmDealIds: [55],
+      }),
+    );
+    expect(link).toMatchObject({
+      purpose: "customer",
+      customerId: 55,
+      customerKind: "crm",
+      orderId: 70,
+      crmDealId: 55,
+      designId: 12,
+    });
+  });
+
+  it("allows an internal admin audit with no customer and labels it internal", async () => {
+    const fx = effects();
+    const result = await runPaidImageGeneration({
+      request: request({
+        imageType: "door_style",
+        internalWork: "door_rendering_audit",
+        actorRole: "admin",
+        requestedByUserId: 3,
+      }),
+      facts: facts(),
+      effects: fx.api,
+      run: async () => ({ imageUrl: "https://cdn.example/audit.png", value: "ok" }),
+    });
+    expect(result.link).toMatchObject({
+      purpose: "internal",
+      customerId: null,
+      customerKind: null,
+      requestedByUserId: 3,
+    });
+    expect(fx.ledger[0]).toMatchObject({ status: "succeeded", purpose: "internal", customerId: null });
+    expect(fx.orders).toEqual([]);
+  });
+
+  it("does not let a non-admin catalog call through as internal", async () => {
+    const fx = effects();
+    await expect(runPaidImageGeneration({
+      request: request({ internalWork: "admin_catalog", actorRole: "distributor", requestedByUserId: 8 }),
+      facts: facts(),
+      effects: fx.api,
+      run: async () => ({ value: "nope" }),
+    })).rejects.toBeInstanceOf(ImageCustomerRequiredError);
+    expect(fx.ledger[0]?.status).toBe("blocked");
+  });
+
+  it("writes a failed ledger row and does not stamp the order when generation throws", async () => {
+    const fx = effects();
+    await expect(runPaidImageGeneration({
+      request: request({ orderId: 18, customerId: 4, customerKind: "user" }),
+      facts: facts({
+        userIds: [4],
+        orderRequests: [{ id: 18, userId: 4, kitchenDesignId: null }],
+        orderDeals: [{ orderRequestId: 18, dealId: 90 }],
+        crmDealIds: [90],
+      }),
+      effects: fx.api,
+      run: async () => { throw new Error("provider down"); },
+    })).rejects.toThrow("provider down");
+    expect(fx.ledger).toEqual([expect.objectContaining({
+      status: "failed",
+      customerId: 4,
+      orderId: 18,
+      imageUrl: null,
+    })]);
+    expect(fx.orders).toEqual([]);
+    expect(fx.notes).toEqual([]);
+  });
+
+  it("stamps the order and writes the CRM note after a successful generation", async () => {
+    const fx = effects();
+    await runPaidImageGeneration({
+      request: request({ orderId: 18, customerId: 4, customerKind: "user", imageType: "cabinet_render" }),
+      facts: facts({
+        userIds: [4],
+        orderRequests: [{ id: 18, userId: 4, kitchenDesignId: 40 }],
+        orderDeals: [{ orderRequestId: 18, dealId: 90 }],
+        crmDealIds: [90],
+      }),
+      effects: fx.api,
+      run: async () => ({ imageUrl: "https://cdn.example/cab.png", value: { url: "https://cdn.example/cab.png" } }),
+    });
+    expect(fx.orders).toEqual([18]);
+    expect(fx.notes).toEqual([{ dealId: 90, authorUserId: 9 }]);
+    expect(fx.ledger[0]).toMatchObject({
+      status: "succeeded",
+      orderId: 18,
+      customerId: 4,
+      purpose: "customer",
+      imageUrl: "https://cdn.example/cab.png",
+    });
+    expect(IMAGE_GENERATED_NOTE).toBe("Image generated");
+  });
+
+  it("still returns the image when the order columns from SQL 0227 are missing", async () => {
+    const fx = effects();
