+/**
+ * One guard in front of every paid image call (Gemini Nano Banana via
+ * `generateImage`, `generateGeminiExactPlanTest`, and `startGeminiExactPlanTest`).
+ *
+ * Paid call sites that must enter through `runPaidImageGeneration`:
+ * - server/routers/design.ts — design.photorealPreview (room scene)
+ * - server/routers/surfaces.ts — surfaces.previewKitchen (room scene)
+ * - server/routers/cabinet3dPreview.ts — cabinet3dPreview.generate (cabinet render)
+ * - server/routers/catalog.ts — cabinets.adminGenerateCatalogImage (admin catalog)
+ * - server/routers/distributorPortal.ts — distributorPortal.updateImage (catalog rerender)
+ * - server/routers/designPhotoRenders.ts — Gemini exact-plan room scene
+ * - server/doorStyleRoomSceneGeneration.ts — featured-style door room scenes
+ *
+ * Door Rendering Audit and the monthly audit do not call a paid model today.
+ * `internalWork: "door_rendering_audit" | "monthly_audit"` is accepted so those
+ * jobs stay labeled internal if they start calling one.
+ *
+ * Customer identity matches the directory already in the product:
+ * a users.id (design owner, order owner, signed-in account) or a crm_deals.id
+ * (CRM contact). A design or order_requests row that already belongs to one of
+ * those resolves the customer. orderId on the ledger is order_requests.id.
+ */
+import { AsyncLocalStorage } from "node:async_hooks";
+import { eq, inArray, or, sql } from "drizzle-orm";
+import { TRPCError } from "@trpc/server";
+import { crmActivities, crmDealDesigns, crmDeals, kitchenDesigns, orderRequests, users } from "../../drizzle/schema";
+import { isMissingSchemaError } from "./orderCostSnapshot";
+
+export const ATTACH_CUSTOMER_MESSAGE = "Attach a customer before generating images";
+export const IMAGE_GENERATED_NOTE = "Image generated";
+
+export const CUSTOMER_IMAGE_WORK = ["door_rendering_audit", "featured_styles", "monthly_audit"] as const;
+
+export type InternalImageWork =
+  | (typeof CUSTOMER_IMAGE_WORK)[number]
+  | "admin_catalog";
+
+export type ImageCustomerKind = "user" | "crm";
+
+export type PaidImageType =
+  | "door_style"
+  | "cabinet_render"
+  | "room_scene"
+  | "design_render"
+  | "photoreal"
+  | "catalog"
+  | "other";
+
+export type ImageLedgerStatus = "succeeded" | "failed" | "blocked";
+
+export type ImageLinkRequest = {
+  imageType: PaidImageType | string;
+  model: string;
+  requestedByUserId?: number | null;
+  actorRole?: string | null;
+  /** Server-only. Client input must never set this. */
+  internalWork?: InternalImageWork | null;
+  customerId?: number | null;
+  customerKind?: ImageCustomerKind | null;
+  designId?: number | null;
+  /** order_requests.id */
+  orderId?: number | null;
+};
+
+export type ImageLinkFacts = {
+  /** users.id values confirmed to exist. Design and order owners are also customers. */
+  userIds: number[];
+  crmDealIds: number[];
+  design: { id: number; userId: number | null } | null;
+  /** crm_deals.id linked by crm_deal_designs for the requested design. */
+  designDealIds: number[];
+  /** orderRequestId stored on those deals (crm_deals.orderRequestId). */
+  dealOrders: Array<{ dealId: number; orderRequestId: number | null }>;
+  orderRequests: Array<{ id: number; userId: number | null; kitchenDesignId: number | null }>;
+  /** Deals whose orderRequestId points at a candidate order. */
+  orderDeals: Array<{ orderRequestId: number; dealId: number }>;
+};
+
+export type ResolvedImageLink = {
+  purpose: "customer" | "internal";
+  customerId: number | null;
+  customerKind: ImageCustomerKind | null;
+  crmDealId: number | null;
+  crmDealIds: number[];
+  designId: number | null;
+  orderId: number | null;
+  requestedByUserId: number | null;
+  imageType: string;
+  model: string;
+};
+
+export type ImageLedgerDraft = {
+  customerId: number | null;
+  customerKind: ImageCustomerKind | null;
+  crmDealId: number | null;
+  designId: number | null;
+  orderId: number | null;
+  imageType: string;
+  model: string;
+  purpose: "customer" | "internal";
+  requestedByUserId: number | null;
+  status: ImageLedgerStatus;
+  imageUrl: string | null;
+  estimatedCost: number | null;
+};
+
+export type PaidImageEffects = {
+  writeLedger(row: ImageLedgerDraft): Promise<void>;
+  markOrderImageGenerated(orderId: number): Promise<"updated" | "schema_missing">;
+  noteImageGenerated(dealId: number, authorUserId: number | null): Promise<void>;
+};
+
+export class ImageCustomerRequiredError extends TRPCError {
+  constructor() {
+    super({ code: "PRECONDITION_FAILED", message: ATTACH_CUSTOMER_MESSAGE });
+  }
+}
+
+const permitStore = new AsyncLocalStorage<ResolvedImageLink>();
+
+export function assertPaidImagePermit(): ResolvedImageLink {
+  const permit = permitStore.getStore();
+  if (!permit) throw new ImageCustomerRequiredError();
+  return permit;
+}
+
+/** Lets provider unit tests reach the network client without a customer ledger. */
+export function withPaidImagePermit<T>(permit: ResolvedImageLink, run: () => Promise<T>): Promise<T> {
+  return permitStore.run(permit, run);
+}
+
+export function testInternalPermit(): ResolvedImageLink {
+  return {
+    purpose: "internal",
+    customerId: null,
+    customerKind: null,
+    crmDealId: null,
+    crmDealIds: [],
+    designId: null,
+    orderId: null,
+    requestedByUserId: 1,
+    imageType: "room_scene",
+    model: "gemini-3.1-flash-image",
+  };
+}
+
+function positive(value: number | null | undefined): number | null {
+  return typeof value === "number" && Number.isInteger(value) && value > 0 ? value : null;
+}
+
+function unique(values: number[]): number[] {
+  return Array.from(new Set(values));
+}
+
+export function emptyImageLinkFacts(): ImageLinkFacts {
+  return {
+    userIds: [],
+    crmDealIds: [],
+    design: null,
+    designDealIds: [],
+    dealOrders: [],
+    orderRequests: [],
+    orderDeals: [],
+  };
+}
+
+/**
+ * Pick the order_requests row this image belongs to.
+ * Direct order id wins. Otherwise the design's order_requests.kitchenDesignId
+ * link, otherwise crm_deal_designs -> crm_deals.orderRequestId.
+ * When several orders match the same way, the newest id is used.
+ */
+export function resolveLinkedOrderId(input: ImageLinkRequest, facts: ImageLinkFacts): number | null {
+  const direct = positive(input.orderId);
+  if (direct && facts.orderRequests.some((order) => order.id === direct)) return direct;
+
+  const designId = positive(input.designId) ?? facts.design?.id ?? null;
+  const byDesign = facts.orderRequests
+    .filter((order) => designId != null && order.kitchenDesignId === designId)
+    .map((order) => order.id);
+  if (byDesign.length > 0) return Math.max(...byDesign);
+
+  const dealIds = new Set(facts.designDealIds);
+  const byDeal = facts.dealOrders
+    .filter((row) => dealIds.has(row.dealId) && positive(row.orderRequestId))
+    .map((row) => row.orderRequestId as number);
+  if (byDeal.length > 0) return Math.max(...byDeal);
+  return null;
+}
+
+function dealsForOrder(orderId: number | null, facts: ImageLinkFacts): number[] {
+  if (!orderId) return [];
+  return facts.orderDeals.filter((row) => row.orderRequestId === orderId).map((row) => row.dealId);
+}
+
+export function resolveImageCustomerLink(input: ImageLinkRequest, facts: ImageLinkFacts): ResolvedImageLink {
+  const designId = positive(input.designId) ?? (facts.design ? facts.design.id : null);
+  const orderId = resolveLinkedOrderId(input, facts);
+  const requestedByUserId = positive(input.requestedByUserId);
+  const knownUsers = new Set(facts.userIds);
+  const knownDeals = new Set(facts.crmDealIds);
+  const order = facts.orderRequests.find((row) => row.id === orderId) ?? null;
+  if (order?.userId) knownUsers.add(order.userId);
+  if (facts.design?.userId) knownUsers.add(facts.design.userId);
+  for (const id of facts.designDealIds) knownDeals.add(id);
+  for (const row of facts.orderDeals) knownDeals.add(row.dealId);
+  for (const row of facts.dealOrders) knownDeals.add(row.dealId);
+
+  const explicitUser = input.customerKind === "user" ? positive(input.customerId) : null;
+  const explicitDeal = input.customerKind === "crm" ? positive(input.customerId) : null;
+  const userId =
+    (explicitUser && knownUsers.has(explicitUser) ? explicitUser : null)
+    ?? (facts.design?.userId && knownUsers.has(facts.design.userId) ? facts.design.userId : null)
+    ?? (order?.userId && knownUsers.has(order.userId) ? order.userId : null);
+  const dealId =
+    (explicitDeal && knownDeals.has(explicitDeal) ? explicitDeal : null)
+    ?? facts.designDealIds.find((id) => knownDeals.has(id))
+    ?? dealsForOrder(orderId, facts)[0]
+    ?? null;
+
+  const customerId = userId ?? dealId;
+  const customerKind: ImageCustomerKind | null = userId ? "user" : dealId ? "crm" : null;
+  const crmDealIds = unique([
+    ...(explicitDeal && knownDeals.has(explicitDeal) ? [explicitDeal] : []),
+    ...facts.designDealIds.filter((id) => knownDeals.has(id)),
+    ...dealsForOrder(orderId, facts),
+    ...(dealId ? [dealId] : []),
+  ]);
+
+  const catalogQa = input.internalWork != null && (CUSTOMER_IMAGE_WORK as readonly string[]).includes(input.internalWork);
+  const adminCatalog = input.internalWork === "admin_catalog" && input.actorRole === "admin";
+  const internal = (catalogQa || adminCatalog) && requestedByUserId != null;
+
+  return {
+    purpose: internal ? "internal" : "customer",
+    customerId: internal && customerId == null ? null : customerId,
+    customerKind: customerId == null ? null : customerKind,
+    crmDealId: crmDealIds[0] ?? null,
+    crmDealIds,
+    designId,
+    orderId,
+    requestedByUserId,
+    imageType: input.imageType,
+    model: input.model,
+  };
+}
+
+export function imageLinkAllowsGeneration(link: ResolvedImageLink): boolean {
+  if (link.purpose === "internal") return link.requestedByUserId != null;
+  return link.customerId != null && link.customerKind != null;
+}
+
+function ledgerFrom(link: ResolvedImageLink, status: ImageLedgerStatus, imageUrl: string | null): ImageLedgerDraft {
+  return {
+    customerId: link.customerId,
+    customerKind: link.customerKind,
+    crmDealId: link.crmDealId,
+    designId: link.designId,
+    orderId: link.orderId,
+    imageType: link.imageType,
+    model: link.model,
+    purpose: link.purpose,
+    requestedByUserId: link.requestedByUserId,
+    status,
+    imageUrl,
+    estimatedCost: null,
+  };
+}
+
+async function safeEffect(label: string, run: () => Promise<void>): Promise<void> {
+  try {
+    await run();
+  } catch (error) {
+    if (isMissingSchemaError(error)) return;
+    console.error(`[image-customer] ${label} failed`, error instanceof Error ? error.message : "unknown error");
+  }
+}
+
+export async function runPaidImageGeneration<T>(args: {
+  request: ImageLinkRequest;
+  facts: ImageLinkFacts;
+  effects: PaidImageEffects;
+  run: () => Promise<{ imageUrl?: string | null; value: T }>;
+}): Promise<{ value: T; link: ResolvedImageLink }> {
+  const link = resolveImageCustomerLink(args.request, args.facts);
+  if (!imageLinkAllowsGeneration(link)) {
+    await safeEffect("ledger", () => args.effects.writeLedger(ledgerFrom(link, "blocked", null)));
+    throw new ImageCustomerRequiredError();
+  }
+  try {
+    const outcome = await permitStore.run(link, args.run);
+    await safeEffect("ledger", () => args.effects.writeLedger(ledgerFrom(link, "succeeded", outcome.imageUrl ?? null)));
+    if (link.orderId) {
+      await safeEffect("order image stamp", () => args.effects.markOrderImageGenerated(link.orderId!).then(() => undefined));
+    }
+    for (const dealId of link.crmDealIds) {
+      await safeEffect("crm note", () => args.effects.noteImageGenerated(dealId, link.requestedByUserId));
+    }
+    return { value: outcome.value, link };
+  } catch (error) {
+    if (!(error instanceof ImageCustomerRequiredError)) {
+      await safeEffect("ledger", () => args.effects.writeLedger(ledgerFrom(link, "failed", null)));
+    }
+    throw error;
+  }
+}
+
+type LinkDb = NonNullable<Awaited<ReturnType<typeof import("../db").getDb>>>;
+
+export async function loadImageLinkFacts(db: LinkDb, input: ImageLinkRequest): Promise<ImageLinkFacts> {
+  const facts = emptyImageLinkFacts();
+  const customerId = positive(input.customerId);
+  const designId = positive(input.designId);
+  const orderId = positive(input.orderId);
+
+  const read = async (label: string, run: () => Promise<void>) => {
+    try {
+      await run();
+    } catch (error) {
+      if (isMissingSchemaError(error)) return;
+      throw new TRPCError({
+        code: "INTERNAL_SERVER_ERROR",
+        message: `Could not resolve the image customer (${label}).`,
+      });
+    }
+  };
+
+  if (customerId && input.customerKind === "user") {
+    await read("user", async () => {
+      const [row] = await db.select({ id: users.id }).from(users).where(eq(users.id, customerId)).limit(1);
+      if (row) facts.userIds.push(row.id);
+    });
+  }
+  if (customerId && input.customerKind === "crm") {
+    await read("crm", async () => {
+      const [row] = await db.select({ id: crmDeals.id }).from(crmDeals).where(eq(crmDeals.id, customerId)).limit(1);
+      if (row) facts.crmDealIds.push(row.id);
+    });
+  }
+  if (designId) {
+    await read("design", async () => {
+      const [design] = await db.select({ id: kitchenDesigns.id, userId: kitchenDesigns.userId })
+        .from(kitchenDesigns).where(eq(kitchenDesigns.id, designId)).limit(1);
+      facts.design = design ? { id: design.id, userId: design.userId } : null;
+      if (design?.userId) facts.userIds.push(design.userId);
+      const links = await db.select({ dealId: crmDealDesigns.dealId })
+        .from(crmDealDesigns).where(eq(crmDealDesigns.designId, designId));
+      facts.designDealIds = links.map((row) => row.dealId);
+      if (facts.designDealIds.length > 0) {
+        const deals = await db.select({ id: crmDeals.id, orderRequestId: crmDeals.orderRequestId })
+          .from(crmDeals).where(inArray(crmDeals.id, facts.designDealIds));
+        facts.dealOrders = deals.map((row) => ({ dealId: row.id, orderRequestId: row.orderRequestId }));
+        facts.crmDealIds.push(...deals.map((row) => row.id));
+      }
+    });
+  }
+
+  const orderIds = unique([
+    ...(orderId ? [orderId] : []),
+    ...facts.dealOrders.map((row) => row.orderRequestId).filter((id): id is number => positive(id) != null),
+  ]);
+  await read("order", async () => {
+    const designFilter = designId ? eq(orderRequests.kitchenDesignId, designId) : undefined;
+    const idFilter = orderIds.length > 0 ? inArray(orderRequests.id, orderIds) : undefined;
+    const where = designFilter && idFilter ? or(designFilter, idFilter) : designFilter ?? idFilter;
+    if (!where) return;
+    const rows = await db.select({
+      id: orderRequests.id,
+      userId: orderRequests.userId,
+      kitchenDesignId: orderRequests.kitchenDesignId,
+    }).from(orderRequests).where(where);
+    facts.orderRequests = rows.map((row) => ({
+      id: row.id,
+      userId: row.userId,
+      kitchenDesignId: row.kitchenDesignId,
+    }));
+    for (const row of rows) if (row.userId) facts.userIds.push(row.userId);
+    const ids = rows.map((row) => row.id);
+    if (ids.length === 0) return;
+    const deals = await db.select({ id: crmDeals.id, orderRequestId: crmDeals.orderRequestId })
+      .from(crmDeals).where(inArray(crmDeals.orderRequestId, ids));
+    facts.orderDeals = deals
+      .filter((row): row is { id: number; orderRequestId: number } => row.orderRequestId != null)
+      .map((row) => ({ dealId: row.id, orderRequestId: row.orderRequestId }));
+    facts.crmDealIds.push(...deals.map((row) => row.id));
+  });
+
+  facts.userIds = unique(facts.userIds);
+  facts.crmDealIds = unique(facts.crmDealIds);
+  return facts;
+}
+
+export const STAMP_TABLES = [
+  "design_photo_renders",
+  "design_gemini_image_test_jobs",
+  "affiliate_generated_images",
+  "surface_previews",
+  "cabinet_3d_previews",
+  "door_style_room_scenes",
+  "door_style_room_scene_generations",
+] as const;
+
+export type StampTable = (typeof STAMP_TABLES)[number];
+
+type SqlDb = { execute(query: unknown): Promise<unknown> };
+
+/**
+ * Increments order_requests.imageGeneratedCount and sets lastImageGeneratedAt.
+ * Those columns are added by SQL 0227. This UPDATE is the fallback when that
+ * helper is not in the tree yet. A missing column is reported and does not throw.
+ */
+export async function markOrderImageGenerated(db: SqlDb, orderId: number): Promise<"updated" | "schema_missing"> {
+  try {
+    await db.execute(sql`
+      UPDATE order_requests
+      SET imageGeneratedCount = imageGeneratedCount + 1,
+          lastImageGeneratedAt = CURRENT_TIMESTAMP
+      WHERE id = ${orderId}
+    `);
+    return "updated";
+  } catch (error) {
+    if (isMissingSchemaError(error)) return "schema_missing";
+    throw error;
+  }
+}
+
+export async function stampImageCustomerId(db: SqlDb, table: StampTable, id: number, customerId: number): Promise<void> {
+  if (!STAMP_TABLES.includes(table) || !Number.isInteger(id) || id <= 0) return;
+  try {
+    if (table === "design_photo_renders") {
+      await db.execute(sql`UPDATE design_photo_renders SET customerId = ${customerId} WHERE id = ${id}`);
+    } else if (table === "design_gemini_image_test_jobs") {
+      await db.execute(sql`UPDATE design_gemini_image_test_jobs SET customerId = ${customerId} WHERE id = ${id}`);
+    } else if (table === "affiliate_generated_images") {
+      await db.execute(sql`UPDATE affiliate_generated_images SET customerId = ${customerId} WHERE id = ${id}`);
+    } else if (table === "surface_previews") {
+      await db.execute(sql`UPDATE surface_previews SET customerId = ${customerId} WHERE id = ${id}`);
+    } else if (table === "cabinet_3d_previews") {
+      await db.execute(sql`UPDATE cabinet_3d_previews SET customerId = ${customerId} WHERE id = ${id}`);
+    } else if (table === "door_style_room_scenes") {
+      await db.execute(sql`UPDATE door_style_room_scenes SET customerId = ${customerId} WHERE id = ${id}`);
+    } else if (table === "door_style_room_scene_generations") {
+      await db.execute(sql`UPDATE door_style_room_scene_generations SET customerId = ${customerId} WHERE id = ${id}`);
+    }
+  } catch (error) {
+    if (isMissingSchemaError(error)) return;
+    console.error("[image-customer] stamp failed", error instanceof Error ? error.message : "unknown error");
+  }
+}
+
+export async function stampImageCustomerFromPermit(db: SqlDb, table: StampTable, id: number): Promise<void> {
+  const permit = permitStore.getStore();
+  if (!permit?.customerId) return;
+  await stampImageCustomerId(db, table, id, permit.customerId);
+}
+
+function rowsFromExecute(result: unknown): Array<Record<string, unknown>> {
+  if (Array.isArray(result)) {
+    const first = result[0];
+    if (Array.isArray(first)) return first as Array<Record<string, unknown>>;
+    if (first && typeof first === "object") return result as Array<Record<string, unknown>>;
+  }
+  if (result && typeof result === "object" && Array.isArray((result as { rows?: unknown }).rows)) {
+    return (result as { rows: Array<Record<string, unknown>> }).rows;
+  }
+  return [];
+}
+
+function dbEffects(db: LinkDb): PaidImageEffects {
+  return {
+    async writeLedger(row) {
+      try {
+        await db.execute(sql`
+          INSERT INTO image_generation_ledger
+            (customerId, customerKind, crmDealId, designId, orderId, imageType, model, purpose, requestedByUserId, status, imageUrl, estimatedCost)
+          VALUES
+            (${row.customerId}, ${row.customerKind}, ${row.crmDealId}, ${row.designId}, ${row.orderId},
+             ${row.imageType}, ${row.model}, ${row.purpose}, ${row.requestedByUserId}, ${row.status},
+             ${row.imageUrl}, ${row.estimatedCost})
+        `);
+      } catch (error) {
+        if (isMissingSchemaError(error)) return;
+        throw error;
+      }
+    },
+    markOrderImageGenerated(orderId) {
+      return markOrderImageGenerated(db, orderId);
+    },
+    async noteImageGenerated(dealId, authorUserId) {
+      try {
+        await db.insert(crmActivities).values({
+          dealId,
+          authorUserId,
+          kind: "note",
+          body: IMAGE_GENERATED_NOTE,
+        });
+      } catch (error) {
+        if (isMissingSchemaError(error)) return;
+        throw error;
+      }
+    },
+  };
+}
+
+export async function withPaidImageCustomer<T>(
+  db: LinkDb | null,
+  request: ImageLinkRequest,
+  run: () => Promise<{ imageUrl?: string | null; value: T }>,
+): Promise<{ value: T; link: ResolvedImageLink }> {
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database unavailable" });
+  const facts = await loadImageLinkFacts(db, request);
+  return runPaidImageGeneration({ request, facts, effects: dbEffects(db), run });
+}
+
+/** Resolve and refuse before a job is queued. Does not record a success. */
+export async function assertPaidImageCustomer(db: LinkDb | null, request: ImageLinkRequest): Promise<ResolvedImageLink> {
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database unavailable" });
+  const facts = await loadImageLinkFacts(db, request);
+  const link = resolveImageCustomerLink(request, facts);
+  if (!imageLinkAllowsGeneration(link)) {
+    await safeEffect("ledger", () => dbEffects(db).writeLedger(ledgerFrom(link, "blocked", null)));
+    throw new ImageCustomerRequiredError();
+  }
+  return link;
+}
+
+const jobCustomerLinks = new Map<number, ImageLinkRequest>();
+
+export function rememberJobImageCustomer(jobId: number, request: ImageLinkRequest): void {
+  jobCustomerLinks.set(jobId, request);
+}
+
+export function rememberedJobImageCustomer(jobId: number): ImageLinkRequest | null {
+  return jobCustomerLinks.get(jobId) ?? null;
+}
+
+export async function writeJobImageCustomer(db: SqlDb, jobId: number, link: ResolvedImageLink): Promise<void> {
+  try {
+    await db.execute(sql`
+      UPDATE design_gemini_image_test_jobs
+      SET customerId = ${link.customerId},
+          customerKind = ${link.customerKind},
+          orderId = ${link.orderId}
+      WHERE id = ${jobId}
+    `);
+  } catch (error) {
+    if (isMissingSchemaError(error)) return;
+    console.error("[image-customer] could not store the Gemini job customer", error instanceof Error ? error.message : "unknown error");
+  }
+}
+
+export async function readJobImageCustomer(db: SqlDb, jobId: number): Promise<{
+  customerId: number | null;
+  customerKind: ImageCustomerKind | null;
+  orderId: number | null;
+} | null> {
+  try {
+    const result = await db.execute(sql`
+      SELECT customerId, customerKind, orderId
+      FROM design_gemini_image_test_jobs
+      WHERE id = ${jobId}
+      LIMIT 1
+    `);
+    const row = rowsFromExecute(result)[0];
+    if (!row) return null;
+    const kind = row.customerKind === "user" || row.customerKind === "crm" ? row.customerKind : null;
+    const customerId = typeof row.customerId === "number" ? row.customerId : Number(row.customerId);
+    const orderId = typeof row.orderId === "number" ? row.orderId : Number(row.orderId);
+    return {
+      customerId: Number.isInteger(customerId) && customerId > 0 ? customerId : null,
+      customerKind: kind,
+      orderId: Number.isInteger(orderId) && orderId > 0 ? orderId : null,
+    };
+  } catch (error) {
+    if (isMissingSchemaError(error)) return null;
+    throw error;
+  }
+}
