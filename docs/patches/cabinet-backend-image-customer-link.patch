diff --git a/server/routers/imageGenerations.ts b/server/routers/imageGenerations.ts
new file mode 100644
index 0000000..690a58b
--- /dev/null
+++ b/server/routers/imageGenerations.ts
@@ -0,0 +1,289 @@
+import { z } from "zod";
+import { sql } from "drizzle-orm";
+import { TRPCError } from "@trpc/server";
+import { adminProcedure, protectedProcedure, publicProcedure, router } from "../_core/trpc";
+import { getDb } from "../db";
+import { crmDeals } from "../../drizzle/schema";
+import { decideDirectoryAccess } from "@shared/customerDirectory";
+import { resolveAffiliateAccess } from "../lib/affiliateAccess";
+import { isMissingSchemaError } from "../lib/orderCostSnapshot";
+
+const kindSchema = z.enum(["user", "crm"]);
+
+function rowsOf(result: unknown): Array<Record<string, unknown>> {
+  if (Array.isArray(result)) {
+    const first = result[0];
+    if (Array.isArray(first)) return first as Array<Record<string, unknown>>;
+    if (first && typeof first === "object") return result as Array<Record<string, unknown>>;
+  }
+  if (result && typeof result === "object" && Array.isArray((result as { rows?: unknown }).rows)) {
+    return (result as { rows: Array<Record<string, unknown>> }).rows;
+  }
+  return [];
+}
+
+function num(value: unknown): number {
+  const parsed = typeof value === "number" ? value : Number(value);
+  return Number.isFinite(parsed) ? parsed : 0;
+}
+
+function dayStart(value: string): Date {
+  const [year, month, day] = value.split("-").map(Number);
+  return new Date(Date.UTC(year, (month ?? 1) - 1, day ?? 1));
+}
+
+function defaultRange() {
+  const to = new Date();
+  to.setUTCHours(0, 0, 0, 0);
+  to.setUTCDate(to.getUTCDate() + 1);
+  const from = new Date(to);
+  from.setUTCDate(from.getUTCDate() - 30);
+  return { from, to };
+}
+
+export const imageGenerationsRouter = router({
+  summary: adminProcedure
+    .input(z.object({
+      from: z.string().regex(/^\d{4}-\d{2}-\d{2}$/).optional(),
+      to: z.string().regex(/^\d{4}-\d{2}-\d{2}$/).optional(),
+    }).optional())
+    .query(async ({ input }) => {
+      const range = input?.from && input?.to
+        ? { from: dayStart(input.from), to: new Date(dayStart(input.to).getTime() + 86_400_000) }
+        : defaultRange();
+      const empty = {
+        schemaReady: false,
+        from: range.from.toISOString(),
+        to: range.to.toISOString(),
+        internalCount: 0,
+        unlinkedCount: 0,
+        customers: [] as Array<{
+          customerId: number;
+          customerKind: "user" | "crm";
+          name: string | null;
+          email: string | null;
+          succeeded: number;
+          failed: number;
+        }>,
+        unlinked: [] as Array<{
+          id: number;
+          imageType: string;
+          model: string;
+          status: string;
+          createdAt: string | null;
+          requestedByUserId: number | null;
+        }>,
+      };
+      const db = await getDb();
+      if (!db) return empty;
+      try {
+        const grouped = rowsOf(await db.execute(sql`
+          SELECT customerKind, customerId, purpose, status, COUNT(*) AS image_count
+          FROM image_generation_ledger
+          WHERE createdAt >= ${range.from} AND createdAt < ${range.to}
+          GROUP BY customerKind, customerId, purpose, status
+        `));
+        const unlinkedRows = rowsOf(await db.execute(sql`
+          SELECT id, imageType, model, status, createdAt, requestedByUserId
+          FROM image_generation_ledger
+          WHERE createdAt >= ${range.from} AND createdAt < ${range.to}
+            AND purpose = 'customer'
+            AND customerId IS NULL
+          ORDER BY id DESC
+          LIMIT 50
+        `));
+        const customers = new Map<string, (typeof empty.customers)[number]>();
+        let internalCount = 0;
+        for (const row of grouped) {
+          const count = num(row.image_count);
+          if (row.purpose === "internal") {
+            internalCount += count;
+            continue;
+          }
+          const customerId = num(row.customerId);
+          if (!customerId) continue;
+          const customerKind = row.customerKind === "crm" ? "crm" : "user";
+          const key = `${customerKind}:${customerId}`;
+          const current = customers.get(key) ?? {
+            customerId,
+            customerKind,
+            name: null,
+            email: null,
+            succeeded: 0,
+            failed: 0,
+          };
+          if (row.status === "succeeded") current.succeeded += count;
+          else current.failed += count;
+          customers.set(key, current);
+        }
+        const userIds = Array.from(customers.values()).filter((row) => row.customerKind === "user").map((row) => row.customerId);
+        const dealIds = Array.from(customers.values()).filter((row) => row.customerKind === "crm").map((row) => row.customerId);
+        if (userIds.length > 0) {
+          const people = rowsOf(await db.execute(sql`
+            SELECT id, name, email FROM users WHERE id IN (${sql.join(userIds.map((id) => sql`${id}`), sql`, `)})
+          `));
+          for (const person of people) {
+            const current = customers.get(`user:${num(person.id)}`);
+            if (!current) continue;
+            current.name = typeof person.name === "string" ? person.name : null;
+            current.email = typeof person.email === "string" ? person.email : null;
+          }
+        }
+        if (dealIds.length > 0) {
+          const deals = rowsOf(await db.execute(sql`
+            SELECT id, contactName, contactEmail FROM crm_deals WHERE id IN (${sql.join(dealIds.map((id) => sql`${id}`), sql`, `)})
+          `));
+          for (const deal of deals) {
+            const current = customers.get(`crm:${num(deal.id)}`);
+            if (!current) continue;
+            current.name = typeof deal.contactName === "string" ? deal.contactName : null;
+            current.email = typeof deal.contactEmail === "string" ? deal.contactEmail : null;
+          }
+        }
+        return {
+          schemaReady: true,
+          from: range.from.toISOString(),
+          to: range.to.toISOString(),
+          internalCount,
+          unlinkedCount: unlinkedRows.length,
+          customers: Array.from(customers.values()).sort((a, b) => (b.succeeded + b.failed) - (a.succeeded + a.failed)),
+          unlinked: unlinkedRows.map((row) => ({
+            id: num(row.id),
+            imageType: String(row.imageType ?? ""),
+            model: String(row.model ?? ""),
+            status: String(row.status ?? ""),
+            createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : (row.createdAt == null ? null : String(row.createdAt)),
+            requestedByUserId: row.requestedByUserId == null ? null : num(row.requestedByUserId),
+          })),
+        };
+      } catch (error) {
+        if (isMissingSchemaError(error)) return empty;
+        throw error;
+      }
+    }),
+
+  forCustomer: protectedProcedure
+    .input(z.object({
+      customerId: z.number().int().positive(),
+      customerKind: kindSchema,
+      limit: z.number().int().min(1).max(100).default(40),
+    }))
+    .query(async ({ ctx, input }) => {
+      const db = await getDb();
+      if (!db) return { schemaReady: false, images: [] };
+      const self = input.customerKind === "user" && input.customerId === ctx.user.id;
+      if (ctx.user.role !== "admin" && !self) {
+        const access = await resolveAffiliateAccess(db, ctx.user);
+        const decision = decideDirectoryAccess({ role: ctx.user.role, access }, null);
+        if (!decision.ok) throw new TRPCError({ code: "FORBIDDEN", message: decision.message });
+      }
+      try {
+        const rows = input.customerKind === "crm"
+          ? rowsOf(await db.execute(sql`
+              SELECT id, imageType, model, purpose, status, imageUrl, orderId, designId, createdAt, estimatedCost
+              FROM image_generation_ledger
+              WHERE (customerKind = 'crm' AND customerId = ${input.customerId})
+                 OR crmDealId = ${input.customerId}
+              ORDER BY id DESC
+              LIMIT ${input.limit}
+            `))
+          : rowsOf(await db.execute(sql`
+              SELECT id, imageType, model, purpose, status, imageUrl, orderId, designId, createdAt, estimatedCost
+              FROM image_generation_ledger
+              WHERE customerKind = 'user' AND customerId = ${input.customerId}
+              ORDER BY id DESC
+              LIMIT ${input.limit}
+            `));
+        return {
+          schemaReady: true,
+          images: rows.map((row) => ({
+            id: num(row.id),
+            imageType: String(row.imageType ?? ""),
+            model: String(row.model ?? ""),
+            purpose: row.purpose === "internal" ? "internal" as const : "customer" as const,
+            status: String(row.status ?? ""),
+            imageUrl: typeof row.imageUrl === "string" ? row.imageUrl : null,
+            orderId: row.orderId == null ? null : num(row.orderId),
+            designId: row.designId == null ? null : num(row.designId),
+            createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : (row.createdAt == null ? null : String(row.createdAt)),
+            estimatedCost: row.estimatedCost == null ? null : String(row.estimatedCost),
+          })),
+        };
+      } catch (error) {
+        if (isMissingSchemaError(error)) return { schemaReady: false, images: [] };
+        throw error;
+      }
+    }),
+
+  search: publicProcedure
+    .input(z.object({ query: z.string().trim().max(120).optional() }).optional())
+    .query(async ({ ctx, input }) => {
+      const db = await getDb();
+      const self = ctx.user ? {
+        customerId: ctx.user.id,
+        customerKind: "user" as const,
+        name: ctx.user.name ?? null,
+        email: ctx.user.email ?? null,
+      } : null;
+      if (!db || ctx.user?.role !== "admin") return { customers: self ? [self] : [] };
+      const term = `%${(input?.query ?? "").trim()}%`;
+      if (!input?.query?.trim()) return { customers: self ? [self] : [] };
+      try {
+        const people = rowsOf(await db.execute(sql`
+          SELECT id, name, email FROM users
+          WHERE name LIKE ${term} OR email LIKE ${term}
+          ORDER BY id DESC
+          LIMIT 20
+        `));
+        const deals = rowsOf(await db.execute(sql`
+          SELECT id, contactName, contactEmail FROM crm_deals
+          WHERE contactName LIKE ${term} OR contactEmail LIKE ${term} OR contactPhone LIKE ${term}
+          ORDER BY id DESC
+          LIMIT 20
+        `));
+        return {
+          customers: [
+            ...people.map((row) => ({
+              customerId: num(row.id),
+              customerKind: "user" as const,
+              name: typeof row.name === "string" ? row.name : null,
+              email: typeof row.email === "string" ? row.email : null,
+            })),
+            ...deals.map((row) => ({
+              customerId: num(row.id),
+              customerKind: "crm" as const,
+              name: typeof row.contactName === "string" ? row.contactName : null,
+              email: typeof row.contactEmail === "string" ? row.contactEmail : null,
+            })),
+          ],
+        };
+      } catch (error) {
+        if (isMissingSchemaError(error)) return { customers: self ? [self] : [] };
+        throw error;
+      }
+    }),
+
+  quickAdd: publicProcedure
+    .input(z.object({
+      name: z.string().trim().min(2).max(256),
+      email: z.string().trim().email().max(320).optional(),
+      phone: z.string().trim().min(7).max(32).optional(),
+    }).refine((value) => Boolean(value.email || value.phone), { message: "Enter an email or a phone number." }))
+    .mutation(async ({ ctx, input }) => {
+      const db = await getDb();
+      if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database unavailable" });
+      const inserted = await db.insert(crmDeals).values({
+        title: input.name,
+        contactName: input.name,
+        contactEmail: input.email ?? null,
+        contactPhone: input.phone ?? null,
+        source: "manual",
+        stage: "new",
+        ownerUserId: ctx.user?.id ?? null,
+      });
+      const header = Array.isArray(inserted) ? inserted[0] as { insertId?: number } : inserted as { insertId?: number };
+      const customerId = Number(header?.insertId ?? 0);
+      if (!customerId) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "The customer could not be saved." });
+      return { customerId, customerKind: "crm" as const, name: input.name };
+    }),
+});
