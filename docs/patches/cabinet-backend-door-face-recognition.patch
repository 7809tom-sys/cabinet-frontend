diff --git a/docs/sql/0226_door_face_recognition.tidb.sql b/docs/sql/0226_door_face_recognition.tidb.sql
new file mode 100644
index 0000000..bac8939
--- /dev/null
+++ b/docs/sql/0226_door_face_recognition.tidb.sql
@@ -0,0 +1,44 @@
+-- TiDB SQL editor version. Paste each numbered block on its own.
+-- One statement per block. No statement-breakpoint markers.
+-- Safe to re-run: IF NOT EXISTS, tables qualified as cabinet_dealz.<table>.
+-- Existing door styles stay verified because the column defaults to 1.
+-- The application sets styleVerified = 0 when it creates a new style.
+-- No other data is updated.
+
+-- 1
+ALTER TABLE cabinet_dealz.door_styles ADD COLUMN IF NOT EXISTS styleVerified TINYINT(1) NOT NULL DEFAULT 1;
+
+-- 2
+ALTER TABLE cabinet_dealz.door_styles ADD COLUMN IF NOT EXISTS styleVerifiedBy VARCHAR(255) NULL;
+
+-- 3
+ALTER TABLE cabinet_dealz.door_styles ADD COLUMN IF NOT EXISTS styleVerifiedAt TIMESTAMP NULL DEFAULT NULL;
+
+-- 4
+ALTER TABLE cabinet_dealz.door_styles ADD COLUMN IF NOT EXISTS styleSourceNote VARCHAR(512) NULL;
+
+-- 5
+ALTER TABLE cabinet_dealz.door_styles ADD COLUMN IF NOT EXISTS combinedSourceImageUrl VARCHAR(512) NULL;
+
+-- 6 read-only check. Expect each column count to be 1.
+SELECT
+  (SELECT COUNT(*) FROM information_schema.COLUMNS
+    WHERE TABLE_SCHEMA = 'cabinet_dealz'
+      AND TABLE_NAME = 'door_styles'
+      AND COLUMN_NAME = 'styleVerified') AS style_verified_column,
+  (SELECT COUNT(*) FROM information_schema.COLUMNS
+    WHERE TABLE_SCHEMA = 'cabinet_dealz'
+      AND TABLE_NAME = 'door_styles'
+      AND COLUMN_NAME = 'styleVerifiedBy') AS style_verified_by_column,
+  (SELECT COUNT(*) FROM information_schema.COLUMNS
+    WHERE TABLE_SCHEMA = 'cabinet_dealz'
+      AND TABLE_NAME = 'door_styles'
+      AND COLUMN_NAME = 'styleVerifiedAt') AS style_verified_at_column,
+  (SELECT COUNT(*) FROM information_schema.COLUMNS
+    WHERE TABLE_SCHEMA = 'cabinet_dealz'
+      AND TABLE_NAME = 'door_styles'
+      AND COLUMN_NAME = 'styleSourceNote') AS style_source_note_column,
+  (SELECT COUNT(*) FROM information_schema.COLUMNS
+    WHERE TABLE_SCHEMA = 'cabinet_dealz'
+      AND TABLE_NAME = 'door_styles'
+      AND COLUMN_NAME = 'combinedSourceImageUrl') AS combined_source_image_column;
diff --git a/server/doorFaceColumns.ts b/server/doorFaceColumns.ts
new file mode 100644
index 0000000..b0a6b49
--- /dev/null
+++ b/server/doorFaceColumns.ts
@@ -0,0 +1,112 @@
+import { sql } from "drizzle-orm";
+
+type Database = {
+  execute: (query: ReturnType<typeof sql>) => Promise<unknown>;
+};
+
+export type DoorFaceColumnRow = {
+  styleVerified: boolean;
+  styleVerifiedBy: string | null;
+  styleVerifiedAt: string | null;
+  styleSourceNote: string | null;
+  combinedSourceImageUrl: string | null;
+};
+
+const MISSING_COLUMN = /unknown column|ER_BAD_FIELD_ERROR|no such column|does not exist/i;
+
+function rowsFromExecute(result: unknown): Array<Record<string, unknown>> {
+  if (Array.isArray(result)) {
+    const first = result[0];
+    if (Array.isArray(first)) return first as Array<Record<string, unknown>>;
+    if (first && typeof first === "object") return result as Array<Record<string, unknown>>;
+  }
+  if (result && typeof result === "object" && Array.isArray((result as { rows?: unknown }).rows)) {
+    return (result as { rows: Array<Record<string, unknown>> }).rows;
+  }
+  return [];
+}
+
+function isMissingColumn(error: unknown): boolean {
+  const message = error instanceof Error ? error.message : String(error);
+  return MISSING_COLUMN.test(message);
+}
+
+function asBoolean(value: unknown): boolean {
+  return value === true || value === 1 || value === "1";
+}
+
+function asText(value: unknown): string | null {
+  if (value == null) return null;
+  const text = String(value).trim();
+  return text.length > 0 ? text : null;
+}
+
+/**
+ * Reads the face columns added by docs/sql/0225. A missing column returns null
+ * so callers keep treating every existing style as verified.
+ */
+export async function readDoorFaceColumns(db: Database, ids: number[]): Promise<Map<number, DoorFaceColumnRow> | null> {
+  const unique = Array.from(new Set(ids.filter((id) => Number.isInteger(id) && id > 0)));
+  if (unique.length === 0) return new Map();
+  try {
+    const result = await db.execute(sql`
+      SELECT id, styleVerified, styleVerifiedBy, styleVerifiedAt, styleSourceNote, combinedSourceImageUrl
+      FROM door_styles
+      WHERE id IN (${sql.join(unique.map((id) => sql`${id}`), sql`, `)})
+    `);
+    const map = new Map<number, DoorFaceColumnRow>();
+    for (const row of rowsFromExecute(result)) {
+      const id = Number(row.id);
+      if (!Number.isInteger(id)) continue;
+      map.set(id, {
+        styleVerified: asBoolean(row.styleVerified),
+        styleVerifiedBy: asText(row.styleVerifiedBy),
+        styleVerifiedAt: row.styleVerifiedAt == null ? null : String(row.styleVerifiedAt),
+        styleSourceNote: asText(row.styleSourceNote),
+        combinedSourceImageUrl: asText(row.combinedSourceImageUrl),
+      });
+    }
+    return map;
+  } catch (error) {
+    if (isMissingColumn(error)) return null;
+    throw error;
+  }
+}
+
+export async function writeDoorFaceColumns(
+  db: Database,
+  id: number,
+  patch: {
+    styleVerified?: boolean;
+    styleVerifiedBy?: string | null;
+    styleSourceNote?: string | null;
+    combinedSourceImageUrl?: string | null;
+  },
+): Promise<"written" | "missing"> {
+  const assignments: ReturnType<typeof sql>[] = [];
+  if (patch.styleVerified !== undefined) {
+    assignments.push(sql`styleVerified = ${patch.styleVerified ? 1 : 0}`);
+    if (patch.styleVerified) {
+      assignments.push(sql`styleVerifiedAt = CURRENT_TIMESTAMP`);
+      assignments.push(sql`styleVerifiedBy = ${patch.styleVerifiedBy ?? null}`);
+    } else {
+      assignments.push(sql`styleVerifiedAt = NULL`);
+      assignments.push(sql`styleVerifiedBy = NULL`);
+    }
+  }
+  if (patch.styleSourceNote !== undefined) assignments.push(sql`styleSourceNote = ${patch.styleSourceNote}`);
+  if (patch.combinedSourceImageUrl !== undefined) assignments.push(sql`combinedSourceImageUrl = ${patch.combinedSourceImageUrl}`);
+  if (assignments.length === 0) return "written";
+  try {
+    await db.execute(sql`UPDATE door_styles SET ${sql.join(assignments, sql`, `)} WHERE id = ${id}`);
+    return "written";
+  } catch (error) {
+    if (isMissingColumn(error)) return "missing";
+    throw error;
+  }
+}
+
+/** New styles stay unverified once the column exists. A missing column is ignored. */
+export async function markNewDoorStyleUnverified(db: Database, id: number): Promise<void> {
+  await writeDoorFaceColumns(db, id, { styleVerified: false });
+}
