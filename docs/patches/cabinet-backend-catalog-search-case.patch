+/**
+ * Shopper-facing catalog search used by `cabinets.list`.
+ *
+ * Description text is compared in lowercase. The description column is
+ * case-sensitive, so a typed phrase such as "wine rack" must still match
+ * "Wall Wine Rack Cabinet" and "Lattice Wine Rack".
+ *
+ * A code fragment matches the separator-stripped master code, so "3015"
+ * matches WRC3015, LWR3015, PR3015, W3015, and a line-prefixed DN-WRC3015.
+ */
+export function publicCabinetSearchSql(rawSearch: string): SQL {
+  const raw = rawSearch.trim();
+  const canon = normalizeCode(raw);
+  const canonCol = sql`UPPER(REPLACE(REPLACE(REPLACE(${cabinets.masterCode}, '-', ''), ' ', ''), '_', ''))`;
+  const parts: SQL[] = [
+    sql`${cabinets.masterCode} LIKE ${`%${raw}%`}`,
+    sql`LOWER(${cabinets.description}) LIKE ${`%${raw.toLowerCase()}%`}`,
+  ];
+  if (canon) parts.push(sql`${canonCol} LIKE ${`%${canon}%`}`);
+  return orCabinetAliasMatch(sql`(${sql.join(parts, sql` OR `)})`, raw);
+}
