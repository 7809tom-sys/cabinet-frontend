diff --git a/server/email.resend.test.ts b/server/email.resend.test.ts
new file mode 100644
index 0000000..305d134
--- /dev/null
+++ b/server/email.resend.test.ts
@@ -0,0 +1,51 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { sendViaResend } from "./email";
+
+const env = { RESEND_API_KEY: "re_test_key", ORDER_EMAIL_FROM: "Cabinet Dealz <orders@cabinetdealz.com>" };
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+describe("Resend email transport", () => {
+  it("does nothing when the API key is unset so SMTP can run", async () => {
+    const fetchImpl = vi.fn();
+    await expect(sendViaResend({ to: "a@b.com", subject: "Hi" }, {}, fetchImpl as unknown as typeof fetch)).resolves.toBeNull();
+    expect(fetchImpl).not.toHaveBeenCalled();
+  });
+
+  it("falls back when the from address is missing", async () => {
+    const fetchImpl = vi.fn();
+    await expect(sendViaResend(
+      { to: "a@b.com", subject: "Hi" },
+      { RESEND_API_KEY: "re_test_key" },
+      fetchImpl as unknown as typeof fetch,
+    )).resolves.toBeNull();
+    expect(fetchImpl).not.toHaveBeenCalled();
+  });
+
+  it("posts to the Resend HTTPS API and records the id", async () => {
+    const fetchImpl = vi.fn(async () => new Response(JSON.stringify({ id: "email_123" }), { status: 200 }));
+    const result = await sendViaResend({
+      to: "orders@mill.com",
+      cc: ["sales@mill.com"],
+      subject: "Purchase Order CD-1",
+      text: "Order number: CD-1",
+      attachments: [{ filename: "PO-CD-1.csv", content: "a,b" }],
+    }, env, fetchImpl as unknown as typeof fetch);
+    expect(result).toEqual({ success: true, messageId: "email_123" });
+    const [url, init] = fetchImpl.mock.calls[0] as [string, RequestInit];
+    expect(url).toBe("https://api.resend.com/emails");
+    expect(init.headers).toMatchObject({ Authorization: "Bearer re_test_key" });
+    const body = JSON.parse(String(init.body));
+    expect(body.from).toBe(env.ORDER_EMAIL_FROM);
+    expect(body.to).toEqual(["orders@mill.com"]);
+    expect(body.attachments[0].content).toBe(Buffer.from("a,b").toString("base64"));
+  });
+
+  it("returns the API error instead of throwing", async () => {
+    const fetchImpl = vi.fn(async () => new Response(JSON.stringify({ message: "blocked" }), { status: 422 }));
+    await expect(sendViaResend({ to: "orders@mill.com", subject: "PO" }, env, fetchImpl as unknown as typeof fetch))
+      .resolves.toEqual({ success: false, error: "blocked" });
+  });
+});
diff --git a/server/email.ts b/server/email.ts
index 4fd20d5..607fedf 100644
--- a/server/email.ts
+++ b/server/email.ts
@@ -53,7 +53,75 @@ export interface SendEmailResult {
   notConfigured?: boolean;
 }
 
+const ORDER_EMAIL_LOG = "[OrderEmail]";
+
+export function resendConfigured(env: NodeJS.ProcessEnv = process.env): boolean {
+  return Boolean(env.RESEND_API_KEY?.trim());
+}
+
+function addressList(value: string | string[] | undefined): string[] | undefined {
+  if (!value) return undefined;
+  const list = (Array.isArray(value) ? value : value.split(/[,;]+/)).map((item) => item.trim()).filter(Boolean);
+  return list.length ? list : undefined;
+}
+
+/**
+ * HTTPS mail through Resend when RESEND_API_KEY is set. Returns null when the
+ * key is absent, or when ORDER_EMAIL_FROM is missing, so the caller can use SMTP.
+ */
+export async function sendViaResend(
+  opts: SendEmailOptions,
+  env: NodeJS.ProcessEnv = process.env,
+  fetchImpl: typeof fetch = fetch,
+): Promise<SendEmailResult | null> {
+  const key = env.RESEND_API_KEY?.trim() ?? "";
+  if (!key) return null;
+  const from = env.ORDER_EMAIL_FROM?.trim() ?? "";
+  if (!from) {
+    console.warn(`${ORDER_EMAIL_LOG} RESEND_API_KEY is set but ORDER_EMAIL_FROM is empty. Falling back to SMTP.`);
+    return null;
+  }
+  const attachments = opts.attachments?.map((attachment) => ({
+    filename: attachment.filename,
+    content: Buffer.isBuffer(attachment.content) ? attachment.content.toString("base64") : Buffer.from(attachment.content).toString("base64"),
+  }));
+  try {
+    const response = await fetchImpl("https://api.resend.com/emails", {
+      method: "POST",
+      headers: {
+        Authorization: `Bearer ${key}`,
+        "Content-Type": "application/json",
+      },
+      body: JSON.stringify({
+        from,
+        to: addressList(opts.to),
+        cc: addressList(opts.cc),
+        bcc: addressList(opts.bcc),
+        subject: opts.subject,
+        text: opts.text,
+        html: opts.html,
+        reply_to: opts.replyTo,
+        attachments,
+      }),
+    });
+    const body = await response.json().catch(() => ({})) as { id?: string; message?: string };
+    if (!response.ok) {
+      const message = body.message || `Resend returned ${response.status}`;
+      console.error(`${ORDER_EMAIL_LOG} Resend failed for ${opts.to}: ${message}`);
+      return { success: false, error: message };
+    }
+    console.log(`${ORDER_EMAIL_LOG} Resend sent to ${opts.to} — id: ${body.id ?? "unknown"}`);
+    return { success: true, messageId: body.id };
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    console.error(`${ORDER_EMAIL_LOG} Resend failed for ${opts.to}: ${message}`);
+    return { success: false, error: message };
+  }
+}
+
 export async function sendEmail(opts: SendEmailOptions): Promise<SendEmailResult> {
+  const resend = await sendViaResend(opts);
+  if (resend) return resend;
   if (!isEmailConfigured()) {
     console.warn("[Email] SMTP not configured — set SMTP_HOST, SMTP_USER, SMTP_PASS in Secrets.");
     return { success: false, notConfigured: true, error: "SMTP not configured" };
@@ -125,6 +193,8 @@ export async function sendEmailViaSettings(
   s: EmailSettingsRow,
   opts: SendEmailOptions
 ): Promise<SendEmailResult> {
+  const resend = await sendViaResend(opts);
+  if (resend) return resend;
   if (!emailSettingsReady(s)) {
     return { success: false, notConfigured: true, error: "Email is not configured or is disabled" };
   }
