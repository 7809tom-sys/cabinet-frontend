+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+
+/**
+ * The receipt bug this change fixes was partly structural: the paid-order email
+ * step lived inline inside the Stripe webhook's try block, so any email problem
+ * turned a successful payment into a 500 that Stripe retried. These tests pin the
+ * structure, not just the presence of a call: the email work must live in its own
+ * helper whose failures are logged and swallowed.
+ */
+const source = (relative: string) => readFileSync(resolve(process.cwd(), relative), "utf8");
+
+const webhook = source("server/stripeWebhook.ts");
+
+function helperBody(): string {
+  const start = webhook.indexOf("async function deliverPaymentEmails");
+  const end = webhook.indexOf("export function registerStripeWebhook");
+  return webhook.slice(start, end);
+}
+
+describe("stripe webhook payment emails", () => {
+  it("keeps the email work out of the webhook's failure path", () => {
+    const body = helperBody();
+    expect(body.length).toBeGreaterThan(200);
+    // Both sends are individually guarded.
+    expect(body).toContain("await sendPaidOrderReceipt(orderId)");
+    expect(body).toContain("await sendOwnerPaymentNotice(orderId");
+    expect(body.match(/catch \(error\)/g)?.length).toBe(2);
+    // Nothing in the helper may propagate to the handler.
+    expect(body).not.toMatch(/\bthrow\b/);
+  });
+
+  it("runs the emails through the helper rather than inline", () => {
+    const handler = webhook.slice(webhook.indexOf("export function registerStripeWebhook"));
+    expect(handler).toContain("await deliverPaymentEmails(orderId");
+    // The old inline call is what made an email failure fail the webhook.
+    expect(handler).not.toContain("await sendPaidOrderReceipt(orderId)");
+  });
+
+  it("confirms and notifies on every paid Stripe event shape", () => {
+    const handler = webhook.slice(webhook.indexOf("export function registerStripeWebhook"));
+    for (const eventType of [
+      "checkout.session.completed",
+      "checkout.session.async_payment_succeeded",
+      "payment_intent.succeeded",
+      "invoice.paid",
+      "invoice.payment_succeeded",
+    ]) {
+      expect(handler).toContain(`case "${eventType}"`);
+    }
+    // Every paid branch must reach the email helper.
+    const paidBranches = handler.match(/await deliverPaymentEmails\(orderId/g)?.length ?? 0;
+    expect(paidBranches).toBeGreaterThanOrEqual(3);
+  });
+
+  it("still returns a non-2xx only for real handler failures", () => {
+    const handler = webhook.slice(webhook.indexOf("export function registerStripeWebhook"));
+    // One 500 remains, for the persistence/handler try block.
+    expect(handler.match(/res\.status\(500\)/g)?.length).toBe(1);
+    expect(handler).toContain('res.json({ received: true })');
+  });
+});
+
+describe("receipt delivery resilience", () => {
+  it("does not gate the customer receipt on the marker column or an internal copy address", () => {
+    const receipt = source("server/lib/orderReceiptEmail.ts");
+    // The claim can no longer produce a "schema_missing" stop.
+    expect(receipt).not.toContain('claim === "schema_missing"');
+    expect(receipt).toContain('claim === "unclaimable"');
+    // An unset internal address no longer aborts the whole receipt.
+    expect(receipt).not.toContain("ORDER_NOTIFY_EMAIL is not a usable address, so the paid-order receipt was not sent.");
+  });
+
+  it("ships a one-statement SQL file for the new dedupe column", () => {
+    const sql = source("docs/sql/0250_payment_notice_email.tidb.sql");
+    const statements = sql.split("\n").filter((line) => line.trim() && !line.trim().startsWith("--"));
+    expect(statements).toHaveLength(1);
+    expect(statements[0]!.trim()).toMatch(/^ALTER TABLE cabinet_dealz\.order_requests /);
+    expect(statements[0]).toContain("IF NOT EXISTS");
+  });
+});
