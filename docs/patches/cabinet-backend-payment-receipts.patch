+++ b/server/lib/paymentNoticeEmail.ts
@@ -0,0 +1,290 @@
+/**
+ * Owner payment-received notice.
+ *
+ * The customer receipt (orderReceiptEmail.ts) is deliberately addressed to the
+ * customer and only BCCs the sales inbox. When the owner's own address is the
+ * customer address — an owner-placed order — that BCC is suppressed as a
+ * duplicate and the owner sees nothing that says "money arrived". This module
+ * is the second, independent message: an internal payment notice addressed to
+ * the owner.
+ *
+ * It is separate from the customer receipt on purpose:
+ *  - it has its own claim marker, so a receipt-provider failure or a
+ *    receiptSentAt schema gap cannot silence the owner notice;
+ *  - it never throws into the webhook handler, because a notification failure
+ *    must not roll back a payment the customer already made;
+ *  - it reports exactly which address it used and why, so "the owner is not
+ *    getting notices" is diagnosable from the log line alone.
+ */
+import { sql } from "drizzle-orm";
+import { orderRequests } from "../../drizzle/schema";
+import { getDb } from "../db";
+import { ENV } from "../_core/env";
+import { sendEmail, type SendEmailOptions, type SendEmailResult } from "../email";
+import { isUsableEmail } from "./orderReceiptEmail";
+import { formatUsdFromCents, summarizeAdminOrder, type OrderMoneyInput } from "./orderMoney";
+const LOG = "[Payment Notice]";
+
+/** The configured owner inbox, trimmed. Empty when ORDER_NOTIFY_EMAIL is blank. */
+export function paymentNoticeRecipient(env: NodeJS.ProcessEnv = process.env): string {
+  return (env.ORDER_NOTIFY_EMAIL ?? "").trim();
+}
+
+/**
+ * Where the payment-received notice goes.
+ *
+ * ORDER_NOTIFY_EMAIL is the operational inbox that already receives order mail,
+ * so it is used when it holds a usable address. OWNER_EMAIL is the fallback so a
+ * deployment that only sets the owner address still gets notices. Returns null
+ * (never a fabricated address) when neither is usable — the caller logs that
+ * instead of pretending a notice was sent.
+ */
+export function resolvePaymentNoticeRecipient(env: NodeJS.ProcessEnv = process.env): {
+  to: string | null;
+  source: "ORDER_NOTIFY_EMAIL" | "OWNER_EMAIL" | null;
+} {
+  const notify = paymentNoticeRecipient(env);
+  if (isUsableEmail(notify)) return { to: notify.trim(), source: "ORDER_NOTIFY_EMAIL" };
+  const owner = (env.OWNER_EMAIL ?? ENV.ownerEmail ?? "").trim();
+  if (isUsableEmail(owner)) return { to: owner, source: "OWNER_EMAIL" };
+  return { to: null, source: null };
+}
+
+export type PaymentNoticeOrder = OrderMoneyInput & {
+  originatorEmail?: string | null;
+  paidAt?: Date | string | null;
+};
+
+export type PaymentNoticeMessage = {
+  to: string;
+  subject: string;
+  text: string;
+  html: string;
+};
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+function paidStamp(value: Date | string | null | undefined): string {
+  if (!value) return "time not stored";
+  const date = value instanceof Date ? value : new Date(value);
+  return Number.isNaN(date.getTime()) ? "time not stored" : date.toISOString();
+}
+
+/**
+ * Compose the internal payment notice. Amounts come from the same summarizer the
+ * receipt uses, so the owner's copy and the customer's copy can never disagree.
+ * A total the order cannot prove says so instead of printing a wrong number.
+ */
+export function composePaymentNotice(
+  order: PaymentNoticeOrder,
+  recipient: string,
+  context: { paymentIntentId?: string | null; sessionId?: string | null; source?: string | null } = {},
+): PaymentNoticeMessage {
+  const summary = summarizeAdminOrder(order);
+  const requestNumber = order.requestNumber?.trim() || `Order ${order.id}`;
+  const totalCents = summary.totalCents ?? summary.subtotalCents;
+  const total = totalCents == null ? "not confirmed (shipping not stored)" : formatUsdFromCents(totalCents);
+  const customer = [order.originatorName?.trim(), order.originatorEmail?.trim()]
+    .filter((part): part is string => Boolean(part))
+    .join(" · ") || "not stored on the order";
+
+  const reference = [
+    context.paymentIntentId ?? order.stripePaymentIntentId,
+    context.sessionId ?? order.stripeSessionId,
+  ].filter((value): value is string => Boolean(value?.trim()));
+
+  const lines = [
+    `A payment was received for ${requestNumber}.`,
+    "",
+    `Amount: ${total}`,
+    `Customer: ${customer}`,
+    `Paid at: ${paidStamp(order.paidAt)}`,
+    `Order total on file: ${summary.totalCents == null ? "not confirmed (shipping not stored)" : formatUsdFromCents(summary.totalCents)}`,
+    `Subtotal: ${formatUsdFromCents(summary.subtotalCents)}`,
+    `Shipping: ${summary.shippingAmountCents == null ? "not stored on this order" : formatUsdFromCents(summary.shippingAmountCents)}`,
+    `Sales tax: ${formatUsdFromCents(summary.taxAmountCents)}`,
+    context.source ? `Trigger: ${context.source}` : null,
+    reference.length > 0 ? `Stripe reference: ${reference.join(" / ")}` : "Stripe reference: not stored on the order",
+    "",
+    "The customer receipt is sent separately to the customer's own address.",
+    "Cabinet Dealz",
+  ].filter((line): line is string => line != null);
+
+  const text = lines.join("\n");
+  const html = `<!doctype html><html><body style="font-family:Arial,sans-serif;color:#1a2b4a">
+    <p><strong>Payment received</strong> for ${escapeHtml(requestNumber)}.</p>
+    <p><strong>Amount:</strong> ${escapeHtml(total)}<br>
+    <strong>Customer:</strong> ${escapeHtml(customer)}<br>
+    <strong>Paid at:</strong> ${escapeHtml(paidStamp(order.paidAt))}<br>
+    <strong>Stripe reference:</strong> ${escapeHtml(reference.join(" / ") || "not stored on the order")}</p>
+    <p>The customer receipt is sent separately to the customer's own address.</p>
+    </body></html>`;
+
+  return {
+    to: recipient,
+    subject: `Payment received — ${requestNumber} — ${total}`,
+    text,
+    html,
+  };
+}
+
+type Database = NonNullable<Awaited<ReturnType<typeof getDb>>>;
+
+function affectedRows(result: unknown): number {
+  const candidates = Array.isArray(result) ? [result, result[0]] : [result];
+  for (const candidate of candidates) {
+    if (candidate && typeof candidate === "object" && "affectedRows" in candidate) {
+      const count = Number((candidate as { affectedRows: number }).affectedRows);
+      if (Number.isFinite(count)) return count;
+    }
+  }
+  return 0;
+}
+
+/**
+ * Claim the one payment notice for this order.
+ *
+ * Returns "claimed" when this call owns the send, "already_sent" when a previous
+ * payment already notified, and "schema_missing" when the marker column is not
+ * on the table yet. Unlike the customer receipt, a missing column does NOT stop
+ * the notice: an unclaimed duplicate is far less harmful than the owner never
+ * hearing about a payment, so the caller sends anyway and logs the gap.
+ */
+export async function claimPaymentNotice(
+  db: Pick<Database, "execute">,
+  orderId: number,
+): Promise<"claimed" | "already_sent" | "schema_missing"> {
+  try {
+    const result = await db.execute(sql`
+      UPDATE order_requests SET paymentNoticeSentAt = CURRENT_TIMESTAMP
+      WHERE id = ${orderId} AND paymentNoticeSentAt IS NULL
+    `);
+    return affectedRows(result) > 0 ? "claimed" : "already_sent";
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    if (/unknown column|ER_BAD_FIELD_ERROR|doesn't exist|does not exist/i.test(message)) return "schema_missing";
+    throw error;
+  }
+}
+
+/** Release the claim so a provider failure can be retried by the next event. */
+export async function releasePaymentNotice(db: Pick<Database, "execute">, orderId: number): Promise<void> {
+  try {
+    await db.execute(sql`UPDATE order_requests SET paymentNoticeSentAt = NULL WHERE id = ${orderId}`);
+  } catch {
+    // The release is only a retry aid; a missing column leaves nothing to clear.
+  }
+}
+
+export type PaymentNoticeResult = {
+  sent: boolean;
+  skipped: boolean;
+  to: string | null;
+  error?: string;
+};
+
+export async function deliverPaymentNotice(input: {
+  order: PaymentNoticeOrder;
+  recipient: string | null;
+  recipientSource?: string | null;
+  claim: () => Promise<"claimed" | "already_sent" | "schema_missing">;
+  release: () => Promise<void>;
+  send: (message: SendEmailOptions) => Promise<SendEmailResult>;
+  paymentIntentId?: string | null;
+  sessionId?: string | null;
+  source?: string | null;
+}): Promise<PaymentNoticeResult> {
+  const requestNumber = input.order.requestNumber?.trim() || `Order ${input.order.id}`;
+  if (!input.recipient) {
+    const error = "No usable ORDER_NOTIFY_EMAIL or OWNER_EMAIL is configured, so the owner payment notice was not sent.";
+    console.error(`${LOG} ${error} ${requestNumber}.`);
+    return { sent: false, skipped: false, to: null, error };
+  }
+  const claim = await input.claim();
+  if (claim === "already_sent") {
+    console.log(`${LOG} ${requestNumber} already notified; not sending a second payment notice.`);
+    return { sent: false, skipped: true, to: input.recipient };
+  }
+  if (claim === "schema_missing") {
+    // Send anyway: a duplicate notice is better than none for a real payment.
+    console.warn(
+      `${LOG} order_requests.paymentNoticeSentAt is missing, so this notice is not deduplicated. Run the payment-notice SQL. ${requestNumber}.`,
+    );
+  }
+
+  const message = composePaymentNotice(input.order, input.recipient, {
+    paymentIntentId: input.paymentIntentId,
+    sessionId: input.sessionId,
+    source: input.source,
+  });
+  const result = await input.send({ to: message.to, subject: message.subject, text: message.text, html: message.html });
+  if (!result.success) {
+    if (claim === "claimed") await input.release();
+    const reason = result.notConfigured
+      ? "Email is not configured. Set RESEND_API_KEY and ORDER_EMAIL_FROM."
+      : (result.error ?? "Email provider rejected the payment notice.");
+    console.error(`${LOG} Failed for ${requestNumber} to ${message.to}: ${reason}`);
+    return { sent: false, skipped: false, to: message.to, error: reason };
+  }
+  console.log(
+    `${LOG} Sent ${requestNumber} to ${message.to} (${input.recipientSource ?? "configured inbox"}) via ${result.transport ?? "email"}.`,
+  );
+  return { sent: true, skipped: false, to: message.to };
+}
+
+/**
+ * Send the owner a payment-received notice for one paid order.
+ *
+ * Never throws: the caller is a payment webhook, and a notification problem must
+ * not turn a successful payment into a failed webhook delivery (which Stripe
+ * would retry and which would make the order look unpaid).
+ */
+export async function sendOwnerPaymentNotice(
+  orderId: number,
+  opts: {
+    paymentIntentId?: string | null;
+    sessionId?: string | null;
+    source?: string | null;
+    env?: NodeJS.ProcessEnv;
+    send?: (message: SendEmailOptions) => Promise<SendEmailResult>;
+  } = {},
+): Promise<PaymentNoticeResult> {
+  const env = opts.env ?? process.env;
+  try {
+    const db = await getDb();
+    if (!db) return { sent: false, skipped: false, to: null, error: "Database not available" };
+    const [order] = await db.select().from(orderRequests).where(sql`${orderRequests.id} = ${orderId}`).limit(1);
+    if (!order) {
+      console.error(`${LOG} Paid order ${orderId} was not found, so no payment notice was sent.`);
+      return { sent: false, skipped: false, to: null, error: "Order not found" };
+    }
+    const { to, source } = resolvePaymentNoticeRecipient(env);
+    if (!to) console.error(`${LOG} ${buildMissingRecipientHelp()}`);
+    return await deliverPaymentNotice({
+      order: { ...order, lineItems: order.lineItems ?? [] },
+      recipient: to,
+      recipientSource: source,
+      claim: () => claimPaymentNotice(db, orderId),
+      release: () => releasePaymentNotice(db, orderId),
+      send: opts.send ?? ((message) => sendEmail(message)),
+      paymentIntentId: opts.paymentIntentId,
+      sessionId: opts.sessionId,
+      source: opts.source,
+    });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    console.error(`${LOG} Order ${orderId} payment notice failed without blocking the payment: ${message}`);
+    return { sent: false, skipped: false, to: null, error: message };
+  }
+}
+
+/** Actionable text for the "nothing is configured" case. */
+export function buildMissingRecipientHelp(): string {
+  return "Set ORDER_NOTIFY_EMAIL (or OWNER_EMAIL) to a monitored address so payment-received notices have somewhere to go.";
+}
