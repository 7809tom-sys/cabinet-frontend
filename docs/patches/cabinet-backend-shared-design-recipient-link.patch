+
+describe("a share link opened by its recipient", () => {
+  const originalEnv = process.env.NODE_ENV;
+  const setProduction = (production: boolean) => {
+    process.env.NODE_ENV = production ? "production" : "test";
+  };
+  afterEach(() => {
+    process.env.NODE_ENV = originalEnv;
+  });
+
+  it("resolves on the public site when Vercel proxies the request to Railway", () => {
+    setProduction(true);
+    // What the backend actually sees: the proxy left the deployment host here.
+    expect(sharedViewOrigin(request({ host: "cabinet-backend-production-2670.up.railway.app" })))
+      .toBe("https://www.cabinetdealz.com");
+    expect(sharedViewOrigin(request({
+      host: "www.cabinetdealz.com",
+      "x-forwarded-host": "www.cabinetdealz.com",
+    }))).toBe("https://www.cabinetdealz.com");
+  });
+
+  it("resolves an affiliate-branded share on the main site, where the viewer exists", () => {
+    setProduction(true);
+    // An affiliate subdomain rewrites every non-store path into /store/:slug,
+    // and that route tree has no /3d share page.
+    expect(sharedViewOrigin(request({ host: "reaves-way-cabinet-shop.cabinetdealz.com" })))
+      .toBe("https://www.cabinetdealz.com");
+  });
+
+  it("never turns a production deployment host into a customer-facing link", () => {
+    setProduction(true);
+    expect(sharedViewOrigin(request({ host: "cabinet-backend-production-2670.up.railway.app" })))
+      .not.toContain("railway.app");
+  });
+
+  it("keeps a local or preview origin outside production so the link is testable", () => {
+    setProduction(false);
+    expect(sharedViewOrigin(request({ host: "localhost:3000" }))).toBe("https://localhost:3000");
+  });
+});
