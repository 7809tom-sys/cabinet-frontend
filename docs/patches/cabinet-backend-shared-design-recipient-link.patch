+// A share link is opened by someone other than the person who made it, so it
+// must resolve on the public CabinetDealz site. Two things made the old code
+// miss that:
+//   * Vercel proxies /api/shared-3d-view/:token to Railway, so Host here is the
+//     deployment host (cabinet-backend-…railway.app); the redirect sent the
+//     recipient to a 404 — the reported "the link does not work".
+//   * An affiliate subdomain rewrites every non-store path to /store/:slug/…,
+//     and that tree has no 3D share route, so a branded link landed on a 404 too.
+// The read-only viewer only exists on the main site, so production always
+// resolves there. Local and preview hosts keep their own origin for testing.
+const MAIN_SITE_ORIGIN = "https://www.cabinetdealz.com";
+
+function isCabinetDealzPublicHost(hostname: string): boolean {
+  const host = hostname.trim().toLowerCase();
+  return host === "cabinetdealz.com"
+    || host === "www.cabinetdealz.com"
+    || /^[a-z0-9-]+\.cabinetdealz\.com$/.test(host);
+}
+
+export function sharedViewOrigin(req: Request): string {
+  const protocol = (req.headers["x-forwarded-proto"] as string | undefined)?.split(",")[0]?.trim() || req.protocol || "https";
+  const hostCandidates = [
+    req.headers["x-original-host"],
+    req.headers["x-forwarded-host"],
+    req.headers["x-host"],
+    req.hostname,
+    req.headers.host,
+  ];
+  const firstHost = hostCandidates
+    .map((value) => (Array.isArray(value) ? value[0] : value))
+    .map((value) => value?.split(",")[0]?.trim().toLowerCase() ?? "")
+    .find(Boolean) ?? "";
+
+  if (firstHost && isCabinetDealzPublicHost(hostOf(firstHost))) return MAIN_SITE_ORIGIN;
+  // Preview, local, and platform hosts: keep the origin the request arrived on
+  // (including its port), but never let a production deployment host become a
+  // customer link.
+  if (process.env.NODE_ENV === "production") return MAIN_SITE_ORIGIN;
+  if (firstHost) return `${protocol}://${firstHost}`;
+  return canonicalPublicOrigin({ protocol, hostCandidates, production: false });
+}
+
+function hostOf(value: string): string {
+  return value.replace(/^https?:\/\//, "").replace(/:\d+$/, "").replace(/\/$/, "");
 }
 
