# Frontend environment (Vite). Set these in Vercel -> Project Settings -> Environment Variables
# (Production and Preview); they are read at BUILD time. Copy to .env for local development.
# Only publishable values belong here: anything with a VITE_ prefix ends up in the browser bundle.

VITE_SUPABASE_URL=                              # https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=                  # Supabase publishable (anon) key — never the service-role key
VITE_STRIPE_PUBLISHABLE_KEY=                    # pk_live_... / pk_test_...
VITE_API_BASE_URL=https://api.cabinetdealz.com  # backend host for tRPC; empty = same origin (local dev with the backend)
VITE_AFFILIATE_DNS_TARGET=cname.vercel-dns.com  # shown in the admin DNS instructions
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=
